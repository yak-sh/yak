{
  "name": "sessions",
  "enums": {
    "httpMethods": {
      "rank": 40,
      "values": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "messageRoles": {
      "rank": 30,
      "values": [
        "user",
        "agent"
      ]
    },
    "turnStates": {
      "rank": 20,
      "values": [
        "idle",
        "busy"
      ]
    }
  },
  "comps": {
    "apply": {
      "log": true,
      "cols": {
        "changes": "body"
      }
    },
    "attention": {
      "log": true
    },
    "bash": {
      "log": true,
      "cols": {
        "command": "body",
        "cwd": "text"
      }
    },
    "brief": {
      "cols": {
        "text": "body"
      }
    },
    "call": {
      "log": true,
      "cols": {
        "key": "text"
      }
    },
    "cancel": {
      "log": true,
      "cols": {
        "target": {
          "eid": "entity",
          "death": "keep"
        }
      }
    },
    "chat": {
      "cols": {
        "actor": {
          "eid": "entity",
          "death": "detach"
        },
        "target": {
          "eid": "entity",
          "death": "detach"
        }
      },
      "indexes": [
        {
          "cols": [
            "actor",
            "target"
          ],
          "unique": true
        }
      ]
    },
    "checkpoint": {
      "log": true,
      "cols": {
        "through": {
          "eid": "entry",
          "death": "keep"
        }
      }
    },
    "claim": {
      "kind": true,
      "cols": {
        "session": {
          "eid": "session",
          "death": "release"
        }
      },
      "stamped": {
        "claimed_at": "time"
      }
    },
    "content": {
      "log": true,
      "cols": {
        "body": "body"
      }
    },
    "entry": {
      "kind": true,
      "lazy": true,
      "log": true,
