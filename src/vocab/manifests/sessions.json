          "eid": "session",
          "death": "cascade"
        }
      },
      "stamped": {
        "seq": "number"
      },
      "indexes": [
        {
          "cols": [
            "session",
            "seq"
          ],
          "unique": true
        }
      ]
    },
    "exit": {
      "log": true,
      "cols": {
        "code": "number"
      }
    },
    "fetch": {
      "log": true,
      "cols": {
        "url": "url",
        "method": {
          "enum": "httpMethods"
        }
      }
    },
    "fork": {
      "cols": {
        "from": {
          "eid": "entry",
          "death": "detach"
        }
      }
    },
    "generation": {
      "log": true,
      "cols": {
        "through": {
          "eid": "entry",
          "death": "keep"
