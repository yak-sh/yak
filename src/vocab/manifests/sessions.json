        "key": "text",
        "phase": "text"
      },
      "indexes": [
        {
          "cols": [
            "source",
            "key"
          ],
          "unique": true,
          "where": "key is not null"
        }
      ]
    },
    "patch": {
      "log": true,
      "cols": {
        "path": "text",
        "diff": "body"
      }
    },
    "prompt": {
      "log": true
    },
    "reasoning": {
      "log": true
    },
    "recalled": {
      "log": true,
      "cols": {
        "source": {
          "eid": "entry",
          "death": "keep"
        },
        "at": "time"
      }
    },
    "response": {
      "log": true,
      "cols": {
        "status": "number"
      }
    },
    "result": {
      "log": true,
      "cols": {
        "call": {
          "eid": "call",
          "death": "keep"
        }
      },
      "indexes": [
        {
          "cols": [
            "call"
          ],
          "unique": true
        }
      ]
    },
    "resume": {
      "stamped": {
        "actor": {
          "eid": "entity",
          "death": "keep"
        },
        "at": "time",
        "rank": "number"
      }
    },
    "run": {
      "stamped": {
        "status": {
          "enum": [
            "starting",
