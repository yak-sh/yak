          "enum": [
            "completed",
            "failed",
            "interrupted",
            "lost"
          ]
        },
        "exit_code": "number",
        "stop_reason": "text"
      }
    },
    "spawn": {
      "cols": {
        "provider": "text",
        "model": "text",
        "effort": "text",
        "persona": {
          "eid": "entity",
          "death": "detach"
        }
      }
    },
    "stderr": {
      "log": true,
      "cols": {
        "text": "body"
      }
    },
    "stop_request": {
      "kind": true,
      "before": [
        "doc"
