        "transcript": "text",
        "agent_type": "text",
        "source": "text",
        "operator": "bool",
        "provider": "text",
        "model": "text",
        "effort": "text",
        "requested_task": {
          "eid": "entity",
          "death": "detach"
        },
        "role": {
          "eid": "role",
          "death": "keep"
        },
        "persona": {
          "eid": "entity",
          "death": "detach"
        },
        "actor": {
          "eid": "entity",
          "death": "detach"
        },
        "parent": {
          "eid": "session",
          "death": "detach"
        }
