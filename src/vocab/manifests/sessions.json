        "branch": "text",
        "base_revision": "text",
        "status": "text",
        "provider_session_id": "text",
        "serving_model": "text",
        "latest_seq": "number",
        "standing": "text",
        "started_at": "time",
        "stop_requested_at": "time",
        "input_at": "time",
        "finished_at": "time",
        "exit_code": "number",
        "stop_reason": "text",
        "final_text": "body",
        "usage_json": "text",
        "stderr": "body"
      }
    },
    "settled": {
      "stamped": {
        "at": "time",
