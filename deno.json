{
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check src/",
    "dev": "deno run -A --unstable-net --unstable-worker-options --watch src/server.ts",
    "tui": "sh -c 'while :; do deno run -A src/tui/main.tsx && break; [ $? -eq 42 ] || break; done'",
    "install": "deno install -g -f --name task -A --config deno.json src/cli.ts",
    "mcp": "deno run -A --unstable-worker-options src/mcp.ts",
    "seed": "deno run -A src/db.ts"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "exclude": ["src/vendor"]
  },
  "lint": {
    "rules": { "tags": ["recommended"], "exclude": ["prefer-const"] },
    "exclude": ["src/vendor"]
  },
  "imports": {
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@preact/signals-core": "npm:@preact/signals-core@^1.14.0",
    "snarkdown": "npm:snarkdown@^2.0.0",
    "linkedom": "npm:linkedom@^0.18.12",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.12.0",
    "zod": "npm:zod@^3.24.0",
    "sucrase": "npm:sucrase@^3.35.0"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
