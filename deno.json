{
  "tasks": {
    "check": "deno run -A bin/check.ts",
    "check:fmt": "deno fmt --check",
    "check:lint": "deno lint",
    "check:bytes": "deno run --allow-read --allow-run=git bin/check-bytes.ts",
    "check:types": "deno run -A bin/check-types.ts",
    "check:types:all": "deno run -A bin/check-types.ts --all",
    "check:raycast": {
      "command": "npm --prefix raycast ci --ignore-scripts --no-audit --no-fund && npm --prefix raycast run typecheck && npm --prefix raycast test",
      "files": [
        "raycast/**/*",
        "deno.json"
      ]
    },
    "check:publish": {
      "command": "deno publish --dry-run --allow-dirty --no-check",
      "files": [
        "deno.json",
        "deno.lock",
        ".gitignore",
        "packages/**/*",
        "workers/**/*",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!workers/yak/.content.gen.ts",
        "!**/.dev.vars*",
        "!**/.env*"
      ]
    },
    "check:browser": {
      "command": "deno run --allow-read --allow-write --allow-run=deno bin/check-platform.ts browser",
      "files": [
        "deno.json",
        "deno.lock",
        "bin/check-platform.ts",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "packages/**/*.js",
        "packages/**/*.mjs",
        "packages/**/*.json",
        "packages/**/*.jsonc",
        "workers/**/*.ts",
        "workers/**/*.tsx",
        "workers/**/*.js",
        "workers/**/*.mjs",
        "workers/**/*.json",
        "workers/**/*.jsonc",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!workers/yak/.content.gen.ts"
      ]
    },
    "check:content": "deno task content --check",
    "content": "deno run --allow-read --allow-write --allow-env --allow-run=deno workers/yak/gen.ts",
    "dev": "deno run -A --unstable-no-legacy-abort --unstable-net --unstable-worker-options packages/cli/yak.ts serve --config $HOME/.yak/yak.json",
    "dev:yak": "deno run --allow-read --allow-write --allow-run=deno,npm,npx,pgrep,kill,env workers/yak/wrangler.ts dev --var LOCAL_DEV:1",
    "dev:yak-staging": "deno run --allow-read --allow-write --allow-run=deno,npm,npx,pgrep,kill,env workers/yak/wrangler.ts dev --env staging --var LOCAL_DEV:1",
    "deploy:yak": "deno run --allow-read --allow-write --allow-net=registry.cloudflare.com --allow-env --allow-run=deno,npm,npx,git,pgrep,kill,docker,env workers/yak/wrangler.ts deploy",
    "deploy:yak-staging": "deno run --allow-read --allow-write --allow-net=registry.cloudflare.com --allow-env --allow-run=deno,npm,npx,git,pgrep,kill,docker,env workers/yak/wrangler.ts deploy --env staging",
    "verify:yak": "deno run -A bin/verify-deploy.ts",
    "app-deploy:time": "deno run -A bench/run.ts app-deploy time",
    "tui:demo": "deno run -A packages/tui/demo.ts",
    "install": "bin/install",
    "app-grep": "deno run --allow-net=api.cloudflare.com --allow-read --allow-write --allow-env=HOME,XDG_CACHE_HOME --allow-run=op,rg bin/app-grep.ts",
    "jsr": "deno run --allow-read --allow-net=api.jsr.io --allow-env=JSR_TOKEN bin/jsr.ts",
    "test": "DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno run -A bin/scratch.ts deno run -A --node-modules-dir=manual bin/test.ts",
    "bench": "deno run -A bench/run.ts run",
    "bench:check": "deno run -A bench/run.ts check",
    "bench:ratchet": "deno run -A bench/run.ts accept",
    "check:run": {
      "dependencies": [
        "check:fmt",
        "check:lint",
        "check:bytes",
        "check:types:all",
        "check:raycast",
        "check:browser",
        "check:content"
      ]
    }
  },
