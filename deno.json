{
  "tasks": {
    "check": "deno run -A bin/check.ts",
    "check:fmt": "deno fmt --check",
    "check:lint": "deno lint",
    "check:bytes": "deno run --allow-read --allow-run=git bin/check-bytes.ts",
    "check:types": "deno run -A bin/workspace-dependencies.ts && deno run -A bin/check-types.ts",
    "check:types:all": "deno run -A bin/workspace-dependencies.ts && deno run -A bin/check-types.ts --all",
    "check:raycast": {
      "command": "npm --prefix raycast ci --ignore-scripts --no-audit --no-fund && npm --prefix raycast run typecheck && npm --prefix raycast test",
      "files": [
        "raycast/**/*",
        "deno.json"
      ]
    },
    "check:publish": {
      "command": "deno task publish --dry-run --allow-dirty --no-check",
      "files": [
        "deno.json",
        "deno.lock",
        ".gitignore",
        "packages/**/*",
        "workers/**/*",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!**/.dev.vars*",
        "!**/.env*"
      ]
    },
    "check:content": "deno task content --check",
    "content": "deno run --allow-read --allow-write --allow-env --allow-run=deno workers/yak/gen.ts",
    "dev": "deno run -A --unstable-no-legacy-abort --unstable-net --unstable-worker-options packages/cli/yak.ts serve --config $HOME/.yak/yak.json",
    "dev:yak": "deno run --allow-read --allow-write --allow-sys=uid --allow-run=deno,node,pnpm,pgrep,kill,env workers/yak/wrangler.ts dev --var LOCAL_DEV:1",
    "dev:yak-staging": "deno run --allow-read --allow-write --allow-sys=uid --allow-run=deno,node,pnpm,pgrep,kill,env workers/yak/wrangler.ts dev --env staging --var LOCAL_DEV:1",
    "deploy:yak": "deno run --allow-read --allow-write --allow-net=registry.cloudflare.com,api.cloudflare.com --allow-env --allow-sys=uid --allow-run=deno,node,pnpm,git,pgrep,kill,docker,env workers/yak/wrangler.ts deploy",
    "deploy:yak-staging": "deno run --allow-read --allow-write --allow-net=registry.cloudflare.com,api.cloudflare.com --allow-env --allow-sys=uid --allow-run=deno,node,pnpm,git,pgrep,kill,docker,env workers/yak/wrangler.ts deploy --env staging",
    "verify:yak": "deno run -A bin/verify-deploy.ts",
    "app-deploy:time": "deno run -A bench/run.ts app-deploy time",
    "tui:demo": "deno run -A packages/tui/demo.ts",
    "install": "bin/install",
    "app-grep": "deno run --allow-net=api.cloudflare.com --allow-read --allow-write --allow-env=HOME,XDG_CACHE_HOME --allow-run=op,rg bin/app-grep.ts",
    "jsr": "deno run --allow-read --allow-net=api.jsr.io --allow-env=JSR_TOKEN bin/jsr.ts",
    "test": "deno run -A bin/workspace-dependencies.ts && DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno run -A bin/scratch.ts deno run -A --node-modules-dir=manual bin/test.ts",
    "bench": "deno run -A bench/run.ts run",
    "bench:check": "deno run -A bench/run.ts check",
    "bench:ratchet": "deno run -A bench/run.ts accept",
    "check:run": {
      "dependencies": [
        "check:fmt",
        "check:lint",
        "check:bytes",
        "check:types",
        "check:raycast",
        "check:content",
        "check:publish"
      ]
    },
    "publish": "deno run -A bin/publish.ts"
  },
  "exclude": [
    "packages/workerd/conform.ts",
    "packages/durable-object/conform.ts",
    "packages/blob/conform.ts",
    "packages/d1/conform.ts",
    "packages/mail/conform.ts",
    "packages/cloudflare-mail/conform.ts",
    "workers/yak/conform.ts",
    "workers/model/conform.ts",
    "workers/model/index.ts",
    "workers/yak/raster/index.ts",
    "workers/yak/fixtures",
    "workers/yak/public/when.js",
    "workers/yak/public/chart.js",
    "workers/yak/public/data.js",
    "**/.wrangler",
    ".tasks",
    ".claude",
    ".worktrees",
    "AGENTS.md",
    "CLAUDE.md",
    "plugins/.gen",
    "**/.*.example.ts",
    "**/.*.example.tsx",
    "**/.*.example.js",
    "**/.*.example.jsx"
  ],
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "bench/flake-ci-*.json",
      "pnpm-lock.yaml"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "prefer-const"
      ]
    }
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "unstable": [
    "net",
    "lazy-dynamic-imports",
    "raw-imports",
    "no-legacy-abort"
  ]
}
