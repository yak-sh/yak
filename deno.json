  "exclude": [
    "packages/workerd/conform.ts",
    "packages/durable-object/conform.ts",
    "packages/blob/conform.ts",
    "packages/d1/conform.ts",
    "packages/mail/conform.ts",
    "workers/yak/conform.ts",
    "workers/model/conform.ts",
    "workers/model/index.ts",
    "workers/yak/raster/index.ts",
    "workers/yak/fixtures",
    "**/.wrangler",
    ".tasks",
    ".claude",
    ".worktrees",
    "AGENTS.md",
    "CLAUDE.md",
    "workers/yak/.content.gen.ts",
    "plugins/.gen",
    "**/.*.example.ts",
    "**/.*.example.tsx",
    "**/.*.example.js",
    "**/.*.example.jsx"
  ],
  "fmt": {
    "semiColons": false,
    "singleQuote": true,
    "exclude": [
      "bench/flake-ci-*.json"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "prefer-const"
      ]
    }
  },
  "imports": {
    "./apps/handouts/api/": "./workers/yak/public/",
    "./apps/housebook/api/": "./workers/yak/public/",
    "./apps/hypermerge/api/": "./workers/yak/public/",
    "./apps/messages/api/": "./workers/yak/public/",
    "./apps/practice/api/": "./workers/yak/public/",
    "./apps/village-tasks/api/": "./workers/yak/public/",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "@cloudflare/workers-oauth-provider": "./workers/yak/oauth-provider.ts",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0"
  },
  "scopes": {
    "https://jsr.io/@db/sqlite/0.13.0/": {
      "https://jsr.io/@db/sqlite/0.13.0/deps.ts": "./packages/sqlite/deps.ts"
    },
    "./workers/yak/defects-runtime.ts": {
      "cloudflare:workers": "./workers/yak/runtime.ts"
    },
    "./node_modules/@cloudflare/workers-oauth-provider/": {
      "cloudflare:workers": "./workers/yak/runtime.ts"
    }
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "unstable": [
    "net",
    "lazy-dynamic-imports",
    "no-legacy-abort"
  ]
}
