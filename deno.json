{
  "tasks": {
    "check": "deno run -A bin/suite-time.ts check deno task check:run",
    "check:fmt": "deno fmt --check",
    "check:lint": "deno lint",
    "check:bytes": "deno run --allow-read --allow-run=git bin/check-bytes.ts",
    "check:types": "deno check",
    "check:publish": {
      "command": "deno publish --dry-run --allow-dirty",
      "files": [
        "deno.json",
        "deno.lock",
        ".gitignore",
        "packages/**/*",
        "workers/**/*",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.json",
        "src/**/*.jsonc",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!src/vocab/.gen.tmp.ts",
        "!src/vocab/.schema.tmp.json",
        "!workers/yak/.content.gen.ts",
        "!**/.dev.vars*",
        "!**/.env*"
      ]
    },
    "check:browser": {
      "command": "deno run --allow-read --allow-write --allow-run=deno bin/check-platform.ts browser",
      "files": [
        "deno.json",
        "deno.lock",
        "bin/check-platform.ts",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "packages/**/*.js",
        "packages/**/*.mjs",
        "packages/**/*.json",
        "packages/**/*.jsonc",
        "workers/**/*.ts",
        "workers/**/*.tsx",
        "workers/**/*.js",
        "workers/**/*.mjs",
        "workers/**/*.json",
        "workers/**/*.jsonc",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.json",
        "src/**/*.jsonc",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!src/vocab/.gen.tmp.ts",
        "!src/vocab/.schema.tmp.json",
        "!workers/yak/.content.gen.ts"
      ]
    },
    "check:workers": {
      "command": "deno run --allow-read --allow-write --allow-run=deno bin/check-platform.ts workers",
      "files": [
        "deno.json",
        "deno.lock",
        "bin/check-platform.ts",
        "packages/**/*.ts",
        "packages/**/*.tsx",
        "packages/**/*.js",
        "packages/**/*.mjs",
        "packages/**/*.json",
        "packages/**/*.jsonc",
        "workers/**/*.ts",
        "workers/**/*.tsx",
        "workers/**/*.js",
        "workers/**/*.mjs",
        "workers/**/*.json",
        "workers/**/*.jsonc",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.js",
        "src/**/*.mjs",
        "src/**/*.json",
        "src/**/*.jsonc",
        "!**/node_modules/**",
        "!**/.wrangler/**",
        "!src/vocab/.gen.tmp.ts",
        "!src/vocab/.schema.tmp.json",
        "!workers/yak/.content.gen.ts"
      ]
    },
    "check:codegen": "deno task codegen --check",
    "check:content": "deno task content --check",
    "check:packages": {
      "command": "DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 deno test --parallel --no-check -A packages/",
      "dependencies": [
        "check:types"
      ]
    },
    "codegen": "deno run --allow-read --allow-write --allow-run=deno src/vocab/gen.ts",
    "content": "deno run --allow-read --allow-write --allow-run=deno workers/yak/gen.ts",
    "test:packages": "DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 deno test --parallel -A packages/",
    "test:workerd": "deno run -A bin/suite-time.ts test:workerd deno task test:workerd:run",
    "test:workers": "deno test -A workers/yak/ workers/yak-tail/",
    "gate": "deno task check && deno task test && deno task bench:gate && deno task bench:gate:web && deno run -A src/cli.ts sync --check",
    "dev": "sh -c 'while :; do deno run -A --unstable-net --unstable-worker-options src/dev.ts && break; [ $? -eq 42 ] || break; done'",
    "dev:yak": "deno run --allow-read --allow-write --allow-run=npm,npx,pgrep,kill workers/yak/wrangler.ts dev",
    "dev:yak-staging": "deno run --allow-read --allow-write --allow-run=npm,npx,pgrep,kill workers/yak/wrangler.ts dev --env staging",
    "deploy:yak": "deno run --allow-read --allow-write --allow-run=npm,npx,git,pgrep,kill workers/yak/wrangler.ts deploy",
    "deploy:yak-staging": "deno run --allow-read --allow-write --allow-run=npm,npx,git,pgrep,kill workers/yak/wrangler.ts deploy --env staging",
    "deploy:yak-tail": "deno run --allow-read --allow-run=npx workers/yak-tail/wrangler.ts deploy",
    "verify:yak": "deno run -A bin/verify-deploy.ts",
    "deploy:time": "deno run -A bin/deploy-time.ts",
    "deploy:gate": "deno run --allow-read --allow-env bin/deploy-gate.ts",
    "app-deploy:time": "deno run --allow-read --allow-write --allow-env --allow-net bin/app-deploy-time.ts",
    "app-deploy:gate": "deno run --allow-read --allow-env bin/app-deploy-gate.ts",
    "session:spike": "deno run -A packages/session/cli.ts",
    "harness": "deno run -A packages/harness/bin.ts",
    "tui:demo": "deno run -A packages/tui/demo.ts",
    "tui": "sh -c 'while :; do deno run -A src/tui/main.tsx && break; [ $? -eq 42 ] || break; done'",
    "install": "sh -c 'cd \"$(git worktree list --porcelain | head -1 | cut -c 10-)\" && git config core.hooksPath .githooks && deno install -g -f --name task -A --config deno.json src/cli.ts && deno install -g -f --name task-turn --allow-env=HOME --allow-write --config deno.json src/turn.ts && deno install -g -f --name yak -A --config deno.json src/yak.ts'",
    "mcp": "deno run -A --unstable-worker-options src/mcp.ts",
    "seed": "deno run -A src/store/sqlite.ts",
    "icons": "deno run -A bin/gen-icons.ts",
    "test": "deno run -A bin/suite-time.ts test deno task test:run",
    "test:all": "TASKS_SLOW=1 DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno run -A bin/test.ts",
    "test:budget": "deno run -A bin/test-budget.ts",
    "bench": "bash bin/bench.sh",
    "bench:gate": "deno run -A bin/bench-gate.ts",
    "bench:accept": "BENCH_ACCEPT=1 deno run -A bin/bench-gate.ts",
    "bench:gate:web": "deno run -A --unstable-net --unstable-worker-options bin/webperf-gate.ts",
    "bench:accept:web": "BENCH_ACCEPT=1 deno run -A --unstable-net --unstable-worker-options bin/webperf-gate.ts",
    "bench:check": "bash bin/bench.sh check",
    "bench:ratchet": "bash bin/bench.sh ratchet",
    "bench:hotpaths": "deno bench -A src",
    "check:run": {
      "dependencies": [
        "check:fmt",
        "check:lint",
        "check:bytes",
        "check:types",
        "check:publish",
        "check:browser",
        "check:workers",
        "check:codegen",
        "check:content",
        "check:packages"
      ]
    },
    "test:run": "DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno run -A bin/test.ts",
    "test:workerd:run": "deno run -A bin/test-workerd.ts"
  },
  "workspace": [
    "./workers/yak",
    "./packages/query",
    "./packages/vocab",
    "./packages/id",
    "./packages/names",
    "./packages/sql",
    "./packages/sqlite",
    "./packages/match",
    "./packages/render",
    "./packages/preact",
    "./packages/markdown",
    "./packages/html",
    "./packages/text",
    "./packages/graph",
    "./packages/archetype",
    "./packages/ram",
    "./packages/sync",
    "./packages/client",
    "./packages/durable-object",
    "./packages/d1",
    "./packages/journal",
    "./packages/effects",
    "./packages/edge",
    "./packages/blob",
    "./packages/fts",
    "./packages/embedding",
    "./packages/api",
    "./packages/mcp",
    "./packages/cli",
    "./packages/workerd",
    "./packages/task",
    "./packages/session",
    "./packages/process",
    "./packages/model",
    "./packages/openai",
    "./packages/wake",
    "./packages/canvas",
    "./packages/mail",
    "./packages/member",
    "./packages/doc",
    "./packages/key",
    "./packages/git",
    "./packages/alias",
    "./packages/memory",
    "./packages/yaml",
    "./packages/harness",
    "./packages/tui",
    "./packages/context"
  ],
  "exclude": [
    "src/vendor",
    "packages/workerd/conform.ts",
    "packages/durable-object/conform.ts",
    "packages/blob/conform.ts",
    "packages/d1/conform.ts",
    "packages/mail/conform.ts",
    "workers/yak/conform.ts",
    "workers/yak-tail/conform.ts",
    "workers/yak/fixtures",
    "**/.wrangler",
    ".tasks",
    ".claude",
    "AGENTS.md",
    "CLAUDE.md",
    "src/vocab/.gen.tmp.ts",
    "src/vocab/.schema.tmp.json",
    "workers/yak/.content.gen.ts",
    "plugins/.gen"
  ],
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "prefer-const"
      ]
    }
  },
  "imports": {
    "@huggingface/transformers": "npm:@huggingface/transformers@^3",
    "es-module-lexer": "npm:es-module-lexer@1.7.0",
    "lucide-preact": "npm:lucide-preact@^1.31.0",
    "lucide": "npm:lucide@1.31.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@preact/signals-core": "npm:@preact/signals-core@^1.14.0",
    "marked": "./src/vendor/marked.esm.js",
    "highlight.js": "./src/vendor/highlight.bundle.mjs",
    "linkedom": "npm:linkedom@^0.18.12",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.12.0",
    "zod": "npm:zod@^3.24.0",
    "postal-mime": "npm:postal-mime@3.0.0",
    "sucrase": "npm:sucrase@^3.35.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/yaml": "jsr:@std/yaml@^1.2.0",
    "ajv": "npm:ajv@^8.17.1",
    "@cloudflare/sandbox": "npm:@cloudflare/sandbox@0.12.9",
    "@cloudflare/workers-oauth-provider": "npm:@cloudflare/workers-oauth-provider@0.10.3",
    "@std/toml": "jsr:@std/toml@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "@sqlite-vector-linux-x86_64": "npm:@sqliteai/sqlite-vector-linux-x86_64@1.0.0",
    "@sqlite-vector-linux-aarch64": "npm:@sqliteai/sqlite-vector-linux-arm64@1.0.0",
    "@sqlite-vector-darwin-x86_64": "npm:@sqliteai/sqlite-vector-darwin-x86_64@1.0.0",
    "@sqlite-vector-darwin-aarch64": "npm:@sqliteai/sqlite-vector-darwin-arm64@1.0.0",
    "@sqlite-vector-windows-x86_64": "npm:@sqliteai/sqlite-vector-win32-x86_64@1.0.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
