{
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check",
    "gate": "deno task check && deno task test && deno task bench:gate && deno task bench:gate:web && deno run -A src/cli.ts sync --check",
    "dev": "sh -c 'while :; do deno run -A --unstable-net --unstable-worker-options src/dev.ts && break; [ $? -eq 42 ] || break; done'",
    "tui": "sh -c 'while :; do deno run -A src/tui/main.tsx && break; [ $? -eq 42 ] || break; done'",
    "install": "sh -c 'cd \"$(git worktree list --porcelain | head -1 | cut -c 10-)\" && git config core.hooksPath .githooks && deno install -g -f --name task -A --config deno.json src/cli.ts'",
    "mcp": "deno run -A --unstable-worker-options src/mcp.ts",
    "seed": "deno run -A src/db.ts",
    "icons": "deno run -A bin/gen-icons.ts",
    "test": "DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno test --frozen -A --unstable-net --unstable-worker-options --fail-fast",
    "test:all": "TASKS_SLOW=1 DB_PATH=:memory: TASKS_SYNC=off TASKS_EMBED=0 TASKS_BACKOFF= deno test --frozen -A --unstable-net --unstable-worker-options --fail-fast",
    "test:budget": "deno run -A bin/test-budget.ts",
    "bench": "deno bench -A src",
    "bench:gate": "deno run -A bin/bench-gate.ts",
    "bench:accept": "BENCH_ACCEPT=1 deno run -A bin/bench-gate.ts",
    "bench:gate:web": "deno run -A --unstable-net --unstable-worker-options bin/webperf-gate.ts",
    "bench:accept:web": "BENCH_ACCEPT=1 deno run -A --unstable-net --unstable-worker-options bin/webperf-gate.ts"
  },
  "exclude": [
    "src/vendor",
    ".tasks",
    ".claude",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "prefer-const"
      ]
    }
  },
  "imports": {
    "@huggingface/transformers": "npm:@huggingface/transformers@^3",
    "lucide-preact": "npm:lucide-preact@^1.31.0",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@preact/signals-core": "npm:@preact/signals-core@^1.14.0",
    "marked": "./src/vendor/marked.esm.js",
    "highlight.js": "./src/vendor/highlight.bundle.mjs",
    "linkedom": "npm:linkedom@^0.18.12",
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@^1.12.0",
    "zod": "npm:zod@^3.24.0",
    "sucrase": "npm:sucrase@^3.35.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0",
    "@sqlite-vector-linux-x86_64": "npm:@sqliteai/sqlite-vector-linux-x86_64@1.0.0",
    "@sqlite-vector-linux-aarch64": "npm:@sqliteai/sqlite-vector-linux-arm64@1.0.0",
    "@sqlite-vector-darwin-x86_64": "npm:@sqliteai/sqlite-vector-darwin-x86_64@1.0.0",
    "@sqlite-vector-darwin-aarch64": "npm:@sqliteai/sqlite-vector-darwin-arm64@1.0.0",
    "@sqlite-vector-windows-x86_64": "npm:@sqliteai/sqlite-vector-win32-x86_64@1.0.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
