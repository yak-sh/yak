[
  {
    "entity": {
      "eid": "41600a71-fc26-4dfd-b74c-36d4b3e837f4"
    },
    "workflow": {},
    "doc": {
      "title": "Voiced Video",
      "body": "From an idea to a finished video: script, storyboard, casting, voice lines, recording, assembly and the finished file."
    }
  },
  {
    "entity": {
      "eid": "e66186e7-261e-4655-8303-f8645ad73b2b"
    },
    "doc": {
      "title": "Script",
      "body": "A model writes the voices and their lines from the idea."
    },
    "step": {
      "match": "$v .video, doc.title=$title, doc.body=$brief",
      "write": [
        {
          "entity": {
            "eid": "$c"
          },
          "call": {
            "to": "28abbf47-0b44-8cb9-a63c-7be44ff9c78b",
            "args": {
              "video": "$v"
            }
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "8c1cba95-5318-496e-9eb6-105ec6a3f03d"
    },
    "doc": {
      "title": "Storyboard",
      "body": "A model plans the shots, browser recordings of the pages the idea names, and places each line in one."
    },
    "step": {
      "match": "$v .video, doc.body=$brief, lines_video>=1; [$l .line.video=$v]",
      "write": [
        {
          "entity": {
            "eid": "$c"
          },
          "call": {
            "to": "160c1507-e524-8c4c-95da-6575fc958e10",
            "args": {
              "video": "$v"
            }
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "4f66129a-8c70-43e3-a97d-cc271ef48fb3"
    },
    "doc": {
      "title": "Casting",
      "body": "Three voices say each role's first line, and the person who asked for the video chooses one."
    },
    "step": {
      "match": "$v .video, created.by=$asker; $r .role.video=$v, role.about=$about",
      "write": [
        {
          "entity": {
            "eid": "$c"
          },
          "call": {
            "to": "d9293ae8-c59b-8ec4-87ef-470c95e2eb3a",
            "args": {
              "role": "$r",
              "asker": "$asker"
            }
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "7c56ab52-c01f-465b-9308-2ca766250091"
    },
    "doc": {
      "title": "Voice lines",
      "body": "Each line is said in its role's chosen voice; changing a line or a voice says it again."
    },
    "step": {
      "match": "$v .video; $l .line.video=$v, line.role=$r, doc.body=$text; $d .decision, cast.role=$r, decided.choice=$name; $a .audition.role=$r, audition.name=$name, audition.voice=$voice, audition.provider=$provider",
      "write": [
        {
          "entity": {
            "eid": "$c"
          },
          "call": {
            "to": "4c028988-1e22-8904-adb4-3a9c7877b70e",
            "args": {
              "line": "$l",
              "provider": "$provider",
              "voice": "$voice"
            }
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "ce2df58b-24ca-402c-8e32-d482da9de854"
    },
    "doc": {
      "title": "Recording",
      "body": "The studio films each shot in Cloudflare's browser; changing a shot films it again."
    },
    "step": {
      "match": "$v .video; $s .shot.video=$v, shot.n=$n, shot.page=$page, shot.as=$as, shot.steps=$steps, doc.title=$title",
      "write": [
        {
          "entity": {
            "eid": "$t"
          },
          "task": {},
          "doc": {
            "title": "$title"
          },
          "take": {
            "video": "$v",
            "shot": "$s",
            "n": "$n"
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "c325d617-f708-465f-b54f-ae95a7575f8c"
    },
    "doc": {
      "title": "Assembly",
      "body": "Once every line is voiced and every shot filmed, the shots and lines are put in order and timed."
    },
    "step": {
      "match": "$v .video, lines_video>=1, shots>=1; [$x .voicing.video=$v, voicing.audio=$audio, voicing.ms=$ms]; [$k .take.video=$v, take.film=$film]; ![$l .line.video=$v; ![$y .voicing.line=$l]]; ![$s .shot.video=$v; ![$f .take.shot=$s, .take.film]]",
      "write": [
        {
          "entity": {
            "eid": "$c"
          },
          "call": {
            "to": "842b3768-998b-8265-83bf-6cf771624c20",
            "args": {
              "video": "$v"
            }
          }
        }
      ]
    }
  },
  {
    "entity": {
      "eid": "ba125854-a77a-4e2e-ab47-85e4bc15e031"
    },
    "doc": {
      "title": "Finished file",
      "body": "The studio renders the cut as an MP4, with its voices and captions."
    },
    "step": {
      "match": "$v .video, doc.title=$title; $c .cut.video=$v",
      "write": [
        {
          "entity": {
            "eid": "$t"
          },
          "task": {},
          "doc": {
            "title": "$title"
          },
          "film": {
            "video": "$v",
            "cut": "$c"
          }
        }
      ]
    }
  },
