# An app's pictures, fonts and sounds are released by `yak admin push`
# (packages/admin/push.ts) but not kept in git: a push from a checkout without
# one keeps the copy the app holds. The app's own icon.png is kept; keep it small.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.ttf
*.otf
*.woff
*.woff2
*.mp3
*.wav
*.ogg
*.m4a
*.mp4
*.webm
!/*/icon.png
