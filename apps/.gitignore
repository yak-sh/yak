# An app's pictures, fonts and sounds are published to yaks.app by
# `yak admin push` (packages/admin/push.ts), not kept in git. The app's own
# icon.png is released with its code, so a copy carries it; keep it small.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.avif
*.ico
*.ttf
*.otf
*.woff
*.woff2
*.mp3
*.wav
*.ogg
*.m4a
*.mp4
*.webm
!/*/icon.png
