{
  "db": "tracker.db",
  "tracker": {
    "spool": "tracker-spool"
  },
  "plugins": [
    "@yaks/kernel",
    "@yaks/id",
    "@yaks/archetype",
    "@yaks/doc",
    "@yaks/tools",
    "@yaks/api",
    "@yaks/process",
    "@yaks/effects",
    "@yaks/mail",
    "@yaks/wake",
    {
      "use": "@yaks/tracker",
      "with": {
        "code": {
          "cwd": "/home/yaks/code/tasks",
          "url": "http://127.0.0.1:5173",
          "origins": [
            "https://tasks.yak.sh",
            "http://127.0.0.1:5173"
          ]
        }
      }
    },
    "@yaks/fts",
    "@yaks/ui",
    {
      "use": "@yaks/web",
      "with": {
        "home": {
          "title": "Open bugs \u00b7 worst first",
          "query": ".bug.status=open * .order=-bug.hits"
        }
      }
    },
    "@yaks/inspect"
  ],
  "numbers": {
    "except": [
      "archetype"
    ]
  },
  "port": 5175,
  "name": "tracker",
  "hostname": "0.0.0.0"
}
