{
  "db": "tracker.db",
  "tracker": {
    "spool": "tracker-spool"
  },
  "plugins": [
    "@yaks/kernel",
    "@yaks/doc",
    "@yaks/tools",
    "@yaks/api",
    "@yaks/process",
    "@yaks/effects",
    "@yaks/mail",
    "@yaks/wake",
    {
      "use": "@yaks/tracker",
      "with": {
        "code": {
          "cwd": "/home/yaks/code/tasks",
          "url": "http://127.0.0.1:5173",
          "origins": [
            "https://tasks.yak.sh",
            "http://127.0.0.1:5173"
          ]
        }
      }
    }
  ]
}
