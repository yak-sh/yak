{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/blob": true
  },
  "title": "doc",
  "$defs": {
    "doc": {
      "component": true,
      "type": "object",
      "description": "the text a person reads: a title and a body",
      "properties": {
        "title": {
          "type": "string",
          "search": true,
          "description": "the one line an entity is known by"
        },
        "body": {
          "type": "string",
          "store": "blob",
          "search": true,
          "contains": true,
          "prose": true,
          "description": "the prose, as markdown — content-addressed when @yaks/blob is composed in, plain text otherwise"
        }
      }
    }
  },
  "kinds": {
    "doc": {
      "description": "the text a person reads: a title and a body",
      "examples": [
        {
          "doc": {
            "title": "Reading list",
            "body": "Books to start this winter"
          }
        }
      ]
    }
  }
}
