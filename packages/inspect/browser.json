{
  "_": "The browser gate: @yaks/inspect's front door, the views a page and a terminal draw, and the page's own components must type-check with only the web platform in scope. The page itself (main.ts) is checked by the root program.",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true
  },
  "entries": [
    ".",
    "./front"
  ],
  "imports": {
    "@yaks/archetype": "../archetype/mod.ts",
    "@yaks/fp": "../fp/mod.ts",
    "@yaks/graph": "../graph/mod.ts",
    "@yaks/match": "../match/mod.ts",
    "@yaks/preact": "../preact/mod.ts",
    "@yaks/query": "../query/mod.ts",
    "@yaks/render": "../render/mod.ts",
    "@yaks/sql": "../sql/mod.ts",
    "@yaks/tui/theme": "../tui/theme.ts",
    "@yaks/ui": "../ui/mod.ts",
    "@yaks/vocab": "../vocab/mod.ts",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "preact": "npm:preact@^10.29.1",
    "preact/hooks": "npm:preact@^10.29.1/hooks"
  }
}
