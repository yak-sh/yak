{
  "name": "@yaks/tui",
  "version": "0.0.0",
  "exports": "./mod.ts",
  "license": "Apache-2.0",
  "description": "A Preact terminal host: a fake DOM, a swappable backend, a diffing ANSI painter, and the scroll, input and frame widgets over them.",
  "imports": {
    "preact": "npm:preact@^10.29.1",
    "preact/hooks": "npm:preact@^10.29.1/hooks",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "demo": "deno run -A demo.ts"
  },
  "publish": {
    "exclude": ["**/*_test.ts", "demo.ts"]
  }
}
