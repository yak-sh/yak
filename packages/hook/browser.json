{
  "_": "The browser gate: @yaks/hook's browser-facing exports must type-check with only the web platform in scope \u2014 no Deno namespace, no Node types. `deno task check:browser` is the check.",
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "@yaks/vocab": "../vocab/mod.ts",
    "@yaks/graph": "../graph/mod.ts",
    "@yaks/doc": "../doc/mod.ts",
    "@yaks/edge": "../edge/mod.ts",
    "@yaks/query": "../query/mod.ts",
    "@yaks/render": "../render/mod.ts",
    "@yaks/markdown": "../markdown/mod.ts",
    "@yaks/match": "../match/mod.ts",
    "@yaks/archetype": "../archetype/mod.ts",
    "@yaks/sql": "../sql/mod.ts",
    "marked": "npm:marked@18.0.6",
    "preact": "npm:preact@^10.29.1"
  }
}
