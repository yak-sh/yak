{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/id": true,
    "https://yak.sh/vocab/blob": true
  },
  "title": "hook",
  "$defs": {
    "hook": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "doc"
      ],
      "prefix": "H",
      "properties": {
        "source": {
          "type": "string",
          "stamped": true,
          "description": "who sent it"
        },
        "event": {
          "type": "string",
          "stamped": true,
          "description": "the event name the sender gave it"
        },
        "payload": {
          "type": "string",
          "store": "blob",
          "stamped": true,
          "description": "the body exactly as delivered"
        },
        "method": {
          "type": "string",
          "stamped": true,
          "description": "the HTTP method it arrived by"
        },
        "path": {
          "type": "string",
          "stamped": true,
          "description": "the path it arrived on"
        },
        "headers": {
          "type": "string",
          "store": "blob",
          "stamped": true,
          "description": "the headers, as sent"
        },
        "verified": {
          "type": "boolean",
          "stamped": true,
          "description": "whether the sender's signature verified — the same column name @yaks/mail uses in `mail.verified`"
        }
      },
      "description": "an event another system delivered, kept as it arrived — the payload is the body that was sent, not a parsed version of it"
    }
  }
}
