{
  "_": "The browser gate: @yaks/heal's browser-facing exports must type-check with only the web platform in scope \u2014 no Deno namespace, no Node types. `deno task check:browser` is the check.",
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "@yaks/vocab": "../vocab/mod.ts",
