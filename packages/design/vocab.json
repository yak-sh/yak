{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/kernel": true
  },
  "title": "design",
  "$defs": {
    "architecture": {
      "component": true,
      "type": "object",
      "governed": true,
      "properties": {},
      "description": "what stands: the structure a system has, rather than one being proposed"
    },
    "design": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "alias"
      ],
      "properties": {},
      "description": "a change being proposed; what it is, is written in the doc beside it. `proposed` and `decided` carry its lifecycle"
    },
    "design_new": {
      "tool": true,
      "noun": "design",
      "verb": "new",
      "title": "Propose a design",
      "description": "File a proposal, stamped as caller. Returns applied bundles.",
      "input": {
        "title": {
          "type": "string",
          "description": "One-line proposal title."
        },
        "body": {
          "type": "string",
          "description": "Proposal as Markdown.",
          "short": "b"
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "Project id or name.",
          "short": "p"
        }
      },
      "required": [
        "title"
      ],
      "positional": [
        "title",
        "body"
      ]
    },
    "design_decide": {
      "tool": true,
      "noun": "design",
      "verb": "decide",
      "title": "Decide a design",
      "description": "Record approval or decline. by records a person's explicit decision; otherwise the caller decides. Returns applied bundles.",
      "input": {
        "design": {
          "type": "string",
          "ref": "design",
          "description": "Design id or name."
        },
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "declined"
          ],
          "default": "approved",
          "description": "Decision (default approved)."
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "description": "Person whose explicit decision is recorded."
        }
      },
      "required": [
        "design"
      ],
      "idempotent": true,
      "positional": [
        "design",
        "verdict"
      ]
    },
    "review": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "comment",
        "doc"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "approved",
            "rejected",
            "changes_requested"
          ],
          "aliases": {
            "approve": "approved",
            "reject": "rejected",
            "changes": "changes_requested"
          },
          "description": "approved, rejected, or approved once these changes are made"
        }
      },
      "description": "one person's assessment of a design: the verdict, and the comment beside it"
    }
  }
}
