{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "platform",
  "$defs": {
    "app": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "space",
          "slug"
        ]
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "version": {
          "type": "number"
        },
        "declaration": {
          "type": "string",
          "stamped": true
        },
        "source": {
          "type": "string",
          "stamped": true
        },
        "script": {
          "type": "string",
          "stamped": true
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "open",
            "private"
          ],
          "description": "public: anyone reads. open: anyone writes. private: only members"
        }
      },
      "description": "one app in a space: its slug, the version currently served, and who may open it"
    },
    "deploy": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "app",
          "version"
        ]
      ],
      "properties": {
        "app": {
          "type": "string",
          "ref": "entity",
          "death": "cascade"
        },
        "version": {
          "type": "number"
        },
        "files": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "script": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "the source release this installed copy came from"
        },
        "reload": {
          "type": "string",
          "enum": [
            "required"
          ],
          "description": "a contract change: pages crossing this release must reload; absent derives the level from files"
        }
      },
      "description": "one release of an app: the files it shipped, and the worker built from them",
      "before": [
        "doc"
      ]
    },
    "hostname": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "doc"
      ],
      "properties": {
        "name": {
          "type": "string",
          "unique": true,
          "description": "the domain, as a person typed it; one hostname points at one place"
        },
        "serves": {
          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "what the name opens: a space, whose front page it opens at `/` with every app at `/<app>/`, or a single app, which it opens at `/`"
        },
        "stage": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "error"
          ],
          "description": "pending while it is being set up, active once it serves, error if it cannot"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "when the stage was last written"
        }
      },
      "description": "a domain somebody owns, and the one place it serves"
    },
    "installed": {
      "component": true,
      "type": "object",
      "properties": {
        "of": {
          "type": "string",
          "ref": "app",
          "death": "detach"
        },
        "version": {
          "type": "number"
        },
        "sandboxed": {
          "type": "string",
          "format": "date-time",
          "description": "when the space's owner put the copy in a sandbox, a browser origin of its own; empty while it runs like the space's own apps"
        }
      },
      "description": "a copy of somebody else\u2019s app, at the version it was copied from"
    },
    "meter": {
      "component": true,
      "type": "object",
      "properties": {
        "month": {
          "type": "string",
          "description": "the month it counts, as YYYY-MM"
        },
        "requests": {
          "type": "number"
        },
        "rows_read": {
          "type": "number"
        },
        "rows_written": {
          "type": "number"
        },
        "bytes": {
          "type": "number"
        },
        "emails": {
          "type": "number"
        },
        "builds": {
          "type": "number"
        },
        "models": {
          "type": "number",
          "description": "dollars spent on models this month, each call weighed by its model's price"
        },
        "seconds": {
          "type": "number"
        },
        "built": {
          "type": "number"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "what a space used in one month"
    },
    "plan": {
      "component": true,
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "free",
            "plus"
          ],
          "stamped": true,
          "description": "free or plus: the tier every ceiling the space meets is read from"
        },
        "customer": {
          "type": "string",
          "stamped": true,
          "description": "the Stripe customer the space pays as"
        },
        "subscription": {
          "type": "string",
          "stamped": true,
          "description": "the Stripe subscription behind the tier"
        },
        "status": {
          "type": "string",
          "stamped": true,
          "description": "that subscription's status as Stripe last said it (`active`, `past_due`, `canceled`, \u2026), mirrored by the webhook and never moved by anything here: Stripe's state machine, not ours"
        },
        "until": {
          "type": "string",
          "format": "date-time",
          "stamped": true,
          "description": "when the paid-for period runs out"
        },
        "ending": {
          "type": "string",
          "format": "date-time",
          "stamped": true,
          "description": "when a subscription that will not renew stops paying"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "stamped": true,
          "description": "when the Stripe event the row was derived from was created"
        }
      },
      "description": "what a space pays for: a function of one Stripe subscription, derived whole from it on every webhook. The platform writes it and no client can."
    },
    "published": {
      "component": true,
      "type": "object",
      "unique": [
        [
          "name"
        ]
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "number"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "about": {
          "type": "string"
        }
      },
      "description": "the name and version this app appears under in the gallery"
    },
    "report": {
      "component": true,
      "type": "object",
      "kind": true,
      "properties": {
        "app": {
          "type": "string",
          "ref": "app",
          "death": "keep"
        },
        "space": {
          "type": "string",
          "ref": "space",
          "death": "keep"
        },
        "version": {
          "type": "number"
        },
        "release": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "an error a deployed app reported about itself"
    },
    "signin": {
      "component": true,
      "type": "object",
      "kind": true,
      "properties": {
        "email": {
          "type": "string",
          "stamped": true
        },
        "code": {
          "type": "string",
          "stamped": true
        },
        "expires": {
          "type": "string",
          "format": "date-time",
          "stamped": true
        },
        "tries": {
          "type": "number",
          "stamped": true
        }
      },
      "description": "a sign-in in progress: the code mailed out, when it expires, and how many tries are left"
    },
    "space": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "slug"
        ]
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "home": {
          "type": "string",
          "ref": "app",
          "death": "detach"
        }
      },
      "description": "one customer\u2019s area of the platform, at its own slug"
    },
    "switched": {
      "component": true,
      "type": "object",
      "wire": false,
      "description": "One move of an app's live pointer between kept deploys; source keeps the immutable serving bytes selected at that moment.",
      "properties": {
        "app": {
          "type": "string",
          "ref": "app",
          "death": "cascade"
        },
        "from": {
          "type": "string",
          "ref": "deploy",
          "death": "keep"
        },
        "to": {
          "type": "string",
          "ref": "deploy",
          "death": "keep"
        },
        "source": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "stamped": true
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true
        },
        "via": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true
        }
      }
    }
  }
}
