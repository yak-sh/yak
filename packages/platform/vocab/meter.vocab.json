{
  "$defs": {
    "model_reservation": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "month": {
          "type": "string"
        },
        "dollars": {
          "type": "number"
        },
        "what": {
          "type": "string",
          "enum": [
            "models",
            "realtime",
            "texts"
          ]
        },
        "source": {
          "type": "string",
          "$comment": "What the dollars buy, for the admin's spend by source (meter.ts `SOURCES`): a model provider, voice, texts or the browser."
        },
        "visitor": {
          "type": "boolean"
        },
        "likely": {
          "type": "number",
          "$comment": "What the call most likely cost should it end with nothing measured (@yaks/model `likely`), and the moment past which it can no longer be running: a hold still open then is settled at `likely` (workers/yak model-spend.ts `expired`). A hold with no `until` is its owner's to settle, however long it waits."
        },
        "until": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "model_estimate": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "month": {
          "type": "string"
        },
        "what": {
          "type": "string",
          "enum": [
            "models",
            "realtime",
            "texts"
          ]
        },
        "source": {
          "type": "string"
        },
        "visitor": {
          "type": "boolean"
        }
      },
      "$comment": "A call's hold settled at an estimate, nothing having measured it, and whom it was held for: a measured cost arriving later replaces the estimate on the same space's month (workers/yak model-spend.ts `settled`)."
    },
    "visitor_calls": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "day": {
          "type": "string"
        },
        "calls": {
          "type": "number"
        }
      },
      "$comment": "The model calls one visitor has asked a space's apps for on `day` (model-spend.ts `reserved`), against meter.ts `visitorCalls`."
    },
    "newcomer_builds": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "day": {
          "type": "string"
        },
        "builds": {
          "type": "number"
        }
      },
      "$comment": "The newcomers' spaces opened on `day` (newcomer.ts `counted`): one row for everybody and one per address they came from, against newcomer.ts `DAILY` and `PER_SOURCE`."
    },
    "account_usage": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "month": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "requests": {
          "type": "number"
        },
        "rows_read": {
          "type": "number"
        },
        "rows_written": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "workers": {
          "type": "number"
        },
        "cpu": {
          "type": "number"
        }
      }
    },
    "account_alert": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "month": {
          "type": "string"
        },
        "requests": {
          "type": "string"
        },
        "rows_read": {
          "type": "string"
        },
        "rows_written": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "workers": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "rate": {
          "type": "string"
        }
      }
    }
  }
}
