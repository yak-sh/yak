{
  "$defs": {
    "model_reservation": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "month": {
          "type": "string"
        },
        "dollars": {
          "type": "number"
        },
        "what": {
          "type": "string",
          "enum": [
            "models",
            "realtime",
            "texts"
          ]
        },
        "source": {
          "type": "string",
          "description": "What the dollars buy: a model provider, voice, texts or the browser.",
          "$comment": "Read for the admin's spend by source (meter.ts `SOURCES`)."
        },
        "visitor": {
          "type": "boolean"
        },
        "likely": {
          "type": "number",
          "description": "What the call most likely cost, should it end with nothing measured: a hold still open at `until` is settled at this. A hold with no `until` is its owner's to settle, however long it waits.",
          "$comment": "@yaks/model `likely`; workers/yak model-spend.ts `expired`."
        },
        "until": {
          "type": "string",
          "format": "date-time",
          "description": "The moment past which the call can no longer be running."
        }
      }
    },
    "model_estimate": {
      "component": true,
      "wire": false,
      "type": "object",
      "description": "A call's hold settled at an estimate, nothing having measured it, and whom it was held for. A measured cost arriving later replaces the estimate on the same space's month.",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "month": {
          "type": "string"
        },
        "what": {
          "type": "string",
          "enum": [
            "models",
            "realtime",
            "texts"
          ]
        },
        "source": {
          "type": "string"
        },
        "visitor": {
          "type": "boolean"
        }
      },
      "$comment": "workers/yak model-spend.ts `settled`."
    },
    "visitor_calls": {
      "component": true,
      "wire": false,
      "type": "object",
      "description": "The model calls one visitor has asked a space's apps for on `day`, counted against the calls a visitor may ask for in a day.",
      "properties": {
        "space": {
          "type": "string",
          "ref": "space",
          "death": "cascade"
        },
        "day": {
          "type": "string"
        },
        "calls": {
          "type": "number"
        }
      },
      "$comment": "model-spend.ts `reserved`, against meter.ts `visitorCalls`."
    },
    "newcomer_builds": {
      "component": true,
      "wire": false,
      "type": "object",
      "description": "The newcomers' spaces opened on `day`: one row for everybody and one per address they came from, each counted against a daily limit.",
      "properties": {
        "day": {
          "type": "string"
        },
        "builds": {
          "type": "number"
        }
      },
      "$comment": "newcomer.ts `counted`, against newcomer.ts `DAILY` and `PER_SOURCE`."
    },
    "account_usage": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "month": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "requests": {
          "type": "number"
        },
        "rows_read": {
          "type": "number"
        },
        "rows_written": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "workers": {
          "type": "number"
        },
        "cpu": {
          "type": "number"
        }
      }
    },
    "account_alert": {
      "component": true,
      "wire": false,
      "type": "object",
      "properties": {
        "month": {
          "type": "string"
        },
        "requests": {
          "type": "string"
        },
        "rows_read": {
          "type": "string"
        },
        "rows_written": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        },
        "workers": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "rate": {
          "type": "string"
        }
      }
    }
  }
}
