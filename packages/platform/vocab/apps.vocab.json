    "order": {
      "$id": "urn:uuid:4f8879e8-1652-477b-a669-c33d11b36aed",
      "component": true,
      "type": "object",
      "description": "Something sold: one row per completed checkout at the payment provider, written into the app's own store by the provider's webhook. The provider is authoritative about the payment; this row tells the seller what to send and to whom. Every property is written by the platform, so no page, member or visitor can say an order was paid.",
      "kind": true,
      "readers": "editor",
      "before": [
        "doc"
      ],
      "properties": {
        "session": {
          "$id": "urn:uuid:00034fd6-fc1e-4925-bf46-f274907e9832",
          "type": "string",
          "description": "With `intent`, how a seller finds the payment at the provider.",
          "stamped": true
        },
        "intent": {
          "$id": "urn:uuid:bb3e0877-3570-4d0e-8d69-5646080c0327",
          "type": "string",
          "description": "With `session`, how a seller finds the payment at the provider.",
          "stamped": true
        },
        "account": {
          "$id": "urn:uuid:708c3a45-3583-4071-89e9-f839cad61959",
          "type": "string",
          "description": "Whose books at the provider the payment landed on.",
          "stamped": true
        },
        "items": {
          "$id": "urn:uuid:c967ed38-6797-4279-9bb2-a26f164d11fc",
          "type": "string",
          "description": "The cart, as JSON text.",
          "stamped": true
