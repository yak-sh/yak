  "title": "apps",
  "$defs": {
    "product": {
      "$id": "urn:uuid:a94731e2-d3e4-47d9-88c2-f87f92a8743d",
      "component": true,
      "type": "object",
      "description": "Something for sale. The checkout reads its price from `price_cents` on this row, never from the buyer.",
      "kind": true,
      "before": [
        "doc"
      ],
      "properties": {
        "price_cents": {
          "$id": "urn:uuid:fb670fcb-00d3-4e7e-b710-e1eaac87764e",
          "type": "number"
        },
        "sizes": {
          "$id": "urn:uuid:34836b98-13b9-4b9c-ae20-e49153c7f8ea",
          "type": "string",
          "description": "The variants the seller offers, comma-separated; a page turns the one chosen into the `options` on a cart line."
        },
        "stock": {
          "$id": "urn:uuid:c6c141f7-39df-4782-a3e8-075527477d3d",
          "type": "number",
          "description": "The seller's own count; nothing here decrements it."
        },
        "image": {
          "$id": "urn:uuid:1c893b28-46d3-4797-a88f-fbbe1ec997df",
          "type": "string",
          "format": "uri"
        }
      },
      "$comment": "sell.ts, T-34525. Platform's rather than each app's for the reason every other word here is platform's — a `product` in one shop is the same word as a `product` in the next, so one filter reads both — and for one more: a door that took the price off the wire would take a price a buyer can edit. A word the platform charges money against is a word the platform declares.\n\nNothing decrements `stock`, because a shop that oversells by one is a conversation and a shop that loses an order to a race is a bug."
    },
    "fund": {
      "$id": "urn:uuid:eff3c483-6510-4824-937d-7088483124dc",
      "component": true,
      "type": "object",
      "description": "What a space takes gifts for; its `doc.title` is the fund's name the donor reads first.",
      "kind": true,
      "before": [
        "doc"
