          "description": "The legal name a receipt says received the gift."
        },
        "amounts_cents": {
          "$id": "urn:uuid:e5801eb1-7c7a-45b3-a1c1-f929cb62cf62",
          "type": "string",
          "description": "The suggested amounts, comma-separated."
        },
        "statement": {
          "$id": "urn:uuid:339c3c7b-91dd-401b-abc0-71551025edeb",
          "type": "string",
          "description": "What a receipt says was given in return, where the default (\"no goods or services\") is not the case."
        },
        "test": {
          "$id": "urn:uuid:6edb14d4-9c6a-4788-aac0-f02344c10722",
          "type": "boolean"
        }
      },
      "$comment": "sell.ts `giving`, T-3630. Platform's for the reason `product` is: the giving door reads it."
    },
