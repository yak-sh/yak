{
  "_": "Pure rules stay worker-safe; controls and HUD are browser-only entries.",
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "@yaks/game": "./mod.ts",
    "@yaks/game/rules": "./mod.ts",
    "@yaks/game/controls": "./controls.ts",
    "@yaks/game/hud": "./hud.ts",
    "@yaks/game/vocab": "./vocab.ts",
    "@yaks/game/ui": "./ui.ts"
  },
  "entries": [
    ".",
    "./rules",
    "./controls",
    "./hud"
  ],
  "resources": [
    "hud/*.css"
  ]
}
