{
  "name": "@yaks/preact",
  "version": "0.2.24",
  "type": "module",
  "exports": {
    ".": "./mod.ts",
    "./host": "./host.ts",
    "./draw": "./draw.ts",
    "./renderer": "./renderer.ts"
  },
  "license": "Apache-2.0",
  "description": "Renders registry-selected views with Preact and binds them to an entity store with subscriptions scoped to mounted components.",
  "dependencies": {
    "@yaks/file": "0.2.28",
    "@yaks/process": "0.2.28",
    "@yaks/query": "0.2.32",
    "@yaks/render": "0.2.24",
    "@yaks/vocab": "0.2.32",
    "preact": "10.29.7",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@preact/signals": "2.9.4",
    "@std/assert": "npm:@jsr/std__assert@^1.0.0",
    "@yaks/client": "0.2.24",
    "@yaks/testing": "0.2.30",
    "linkedom": "^0.18.12"
  },
  "yaksRenderer": {
    "dependency": "preact",
    "unless": "react",
    "aliases": {
      "react": "preact/compat",
      "react-dom": "preact/compat",
      "react-dom/client": "preact/compat/client",
      "react/jsx-runtime": "preact/jsx-runtime",
      "react/jsx-dev-runtime": "preact/jsx-dev-runtime"
    }
  }
}
