{
  "name": "@yaks/preact",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "license": "Apache-2.0",
  "description": "The Preact host for portable renderers, with a subscribed Entity component over an injected bundle store.",
  "imports": {
    "preact": "npm:preact@^10.29.1",
    "preact/hooks": "npm:preact@^10.29.1/hooks",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "linkedom": "npm:linkedom@^0.18.12",
    "sucrase": "npm:sucrase@^3.35.0"
  },
  "tasks": {
    "example": "deno run --allow-read --allow-net=127.0.0.1 example/serve.ts"
  },
  "publish": {
    "exclude": ["**/*_test.ts", "harness.ts", "example/"]
  }
}
