{
  "_": "The browser gate: @yaks/persona's browser-facing exports must type-check with only the web platform in scope \u2014 no Deno namespace, no Node types. `deno task check:browser` is the check.",
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ],
    "strict": true
  },
  "imports": {
    "@yaks/archetype": "../archetype/mod.ts",
    "@yaks/doc": "../doc/mod.ts",
    "@yaks/edge": "../edge/mod.ts",
    "@yaks/graph": "../graph/mod.ts",
    "@yaks/id": "../id/mod.ts",
    "@yaks/query": "../query/mod.ts",
    "@yaks/render": "../render/mod.ts",
    "@yaks/sql": "../sql/mod.ts",
    "@yaks/text": "../text/mod.ts",
    "@yaks/vocab": "../vocab/mod.ts"
  }
}
