{
  "$vocabulary": {
    "https://yaks.sh/vocab/core": true,
    "https://yaks.sh/vocab/id": true,
    "https://yaks.sh/vocab/names": true,
    "https://yaks.sh/vocab/kernel": true
  },
  "title": "persona",
  "$defs": {
    "person": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "alias",
        "doc",
        "email"
      ],
      "prefix": "U",
      "by_name": true,
      "properties": {},
      "description": "a human being, as this graph knows them"
    },
    "persona": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "alias",
        "doc"
      ],
      "prefix": "N",
      "by_name": true,
      "governed": true,
      "properties": {
        "home": {
          "type": "string",
          "ref": "project",
          "death": "detach",
          "description": "the project it speaks for"
        }
      },
      "description": "a voice an agent wears: the doc beside it IS the voice"
    },
    "role": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "alias",
        "claim",
        "doc",
        "persona"
      ],
      "prefix": "R",
      "by_name": true,
      "properties": {
        "state": {
          "enum": [
            "running",
            "stopped",
            "paused",
            "disabled",
            "retired",
            "held"
          ],
          "description": "running, stopped, paused, disabled, retired, or held"
        },
        "surface": {
          "enum": [
            "native",
            "managed"
          ],
          "description": "native: it runs here. managed: something else runs it"
        },
        "scope": {
          "type": "string",
          "ref": "entity",
          "death": "detach",
          "description": "what it is responsible for"
        },
        "stopped_at": {
          "type": "string",
          "format": "date-time",
          "stamped": true
        }
      },
      "description": "a persona hired into standing work: what it is responsible for, and whether it is running. When it wakes is a @yaks/wake `wake` pointed at it, where it works is a @yaks/git `worktree`, and what it last decided is kernel `decided`"
    }
  }
}
