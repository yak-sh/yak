{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/id": true,
    "https://yak.sh/vocab/edge": true
  },
  "title": "dreaming",
  "$defs": {
    "dream": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": ["builder", "doc"],
      "prefix": "Z",
      "properties": {
        "scope": {
          "type": "string",
          "ref": "project",
          "death": "cascade",
          "description": "the project it is filed under"
        }
      },
      "description": "a standing intention filed under a project; it wears @yaks/builders' `builder`, which says when it runs"
    },
    "meta": {
      "component": true,
      "type": "object",
      "properties": {},
      "description": "a note written in a transcript: never delivered to anyone live, read later by a dream"
    },
    "recall": {
      "component": true,
      "type": "object",
      "properties": {
        "count": {
          "type": "number",
          "stamped": true,
          "description": "how many times it has been recalled"
        },
        "first_at": {
          "type": "string",
          "format": "date-time",
          "stamped": true,
          "description": "when it was first recalled"
        },
        "last_at": {
          "type": "string",
          "format": "date-time",
          "stamped": true,
          "description": "when it was last recalled"
        }
      },
      "description": "how many times an entity has been recalled, and when it last was"
    },
    "recalled": {
      "component": true,
      "type": "object",
      "relation": "recalled",
      "bare": false,
      "properties": {
        "source": {
          "type": "string",
          "ref": "entry",
          "death": "keep"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "description": "an edge relation: this entry recalled that entity, at this time"
    }
  }
}
