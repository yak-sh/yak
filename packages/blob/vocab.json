{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "artifact",
  "$defs": {
    "artifact": {
      "component": true,
      "type": "object",
      "description": "Bytes stored in the configured blob store: their SHA-256 address, media type and size.",
      "properties": {
        "size": {
          "type": "number"
        },
        "address": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        }
      }
    },
    "representation": {
      "component": true,
      "wire": false,
      "type": "object",
      "description": "Immutable HTTP headers for one use of content-addressed bytes.",
      "required": ["scope", "address", "media_type"],
      "properties": {
        "scope": {
          "type": "string",
          "stamped": true
        },
        "address": {
          "type": "string",
          "stamped": true
        },
        "media_type": {
          "type": "string",
          "stamped": true
        },
        "name": {
          "type": "string",
          "stamped": true
        }
      }
    },
    "attachment": {
      "component": true,
      "type": "object",
      "kind": true,
      "description": "A file attached to a session entry: the artifact entity holding its bytes, and the model call that produced it.",
      "properties": {
        "artifact": {
          "type": "string",
          "ref": "artifact",
          "death": "keep"
        },
        "media_type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "audience": {
          "type": "string",
          "enum": [
            "user",
            "model"
          ]
        },
        "revision": {
          "type": "string"
        },
        "call": {
          "type": "string"
        },
        "revised_prompt": {
          "type": "string"
        }
      }
    }
  }
}
