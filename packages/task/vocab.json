  },
  "title": "task",
  "$defs": {
    "accept": {
      "$id": "urn:uuid:27039c57-9725-424a-a94b-a79becdbd84c",
      "component": true,
      "type": "object",
      "properties": {
        "body": {
          "$id": "urn:uuid:1eb66fd6-7efc-4a41-baee-d6bf4ed4bd5b",
          "type": "string",
          "store": "blob",
          "description": "the conditions, in prose"
        }
      },
      "description": "what finishing this means — written when the work is asked for, not after"
    },
    "blocked": {
      "$id": "urn:uuid:5db71c1a-e774-405d-9724-08e22455308c",
      "component": true,
      "type": "object",
      "description": "something outside the graph is in the way. Not a status: a blocked task is still open work.",
      "properties": {
        "on": {
          "$id": "urn:uuid:a8ec2593-cf9b-4af4-88b7-806fce191eeb",
          "type": "string",
          "description": "what it is waiting on, in words"
        },
        "since": {
          "$id": "urn:uuid:30b0890c-09bf-48e8-bf9e-64b3b9ed99af",
          "type": "string",
          "format": "date-time",
          "stamped": true
        }
      }
    },
    "started": {
      "$id": "urn:uuid:88f4a8e8-a09c-45e7-bc6a-5292bc87c8f0",
      "component": true,
      "type": "object",
      "description": "the mark on a task somebody said they are working on: a person's wip, where a session's is its claim",
      "properties": {
        "at": {
          "$id": "urn:uuid:74dec5c7-6d72-457a-b15d-3f2f85c113d2",
          "type": "string",
          "format": "date-time",
          "description": "when it was started",
          "stamped": true
        },
        "by": {
          "$id": "urn:uuid:33ba2622-55d3-4e4e-90f6-fc79e56bfa84",
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "who started it — kept as history when that entity is deleted",
          "stamped": true
        },
        "via": {
          "$id": "urn:uuid:b9083ee2-9469-449e-8994-376560ffc9e9",
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true,
          "description": "what the write came in through — the session or client that made it"
        }
      }
    },
    "contains": {
      "$id": "urn:uuid:60bb43e3-fd78-4fa5-a4cd-81609da61bc2",
      "component": true,
      "type": "object",
      "edge": "contains",
      "reversed": "contained by",
      "description": "that task is part of this one",
      "properties": {}
    },
    "requires": {
      "$id": "urn:uuid:3290cf06-32d5-4037-996f-3b6972ec1fd4",
      "component": true,
      "type": "object",
      "edge": "requires",
      "reversed": "required by",
      "description": "this task waits for that one",
      "properties": {}
    },
    "task": {
      "$id": "urn:uuid:c1a80ff2-0ba3-450f-8931-993669a0a1f3",
      "component": true,
      "type": "object",
      "governed": true,
      "description": "a thing to do",
      "status": {
        "cancelled": "cancelled",
        "completed": "done",
        "started": "wip",
        "default": "open"
      },
      "properties": {}
    },
    "task_new": {
      "tool": true,
      "destructive": false,
      "noun": "task",
      "verb": "new",
      "title": "Create a task",
      "step": {
        "doing": "Adding to its to-do list…",
        "done": "Added to its to-do list"
      },
      "description": "Create one task or atomic batch. Rows inherit filing; id ($name), parent and requires connect trees/dependencies. check previews without saving. Returns applied bundles.",
      "input": {
        "title": {
          "type": "string",
          "description": "One-line task title."
        },
        "body": {
          "type": "string",
          "description": "Request and detail links, as Markdown: steps a numbered list, several items a bulleted list.",
          "short": "b"
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "Project id or name.",
          "short": "p"
        },
        "priority": {
          "type": "number",
          "description": "Queue order; lower is more urgent."
        },
        "assignee": {
          "type": "string",
          "ref": "entity",
          "description": "Assignee id or name."
        },
        "domain": {
          "type": "string",
          "description": "Area of work."
        },
        "check": {
          "type": "boolean",
          "description": "Preview without saving."
        },
        "accept": {
          "type": [
            "string",
            "null"
          ],
          "description": "Completion conditions; null clears."
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ],
          "description": "External obstacle; null clears."
        },
        "parent": {
          "type": "string",
          "description": "Containing entity id, or $id in tasks."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite ids, including $ids in tasks."
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\$",
                "description": "Local $name for sibling links; optional."
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "project": {
                "type": "string",
                "ref": "project"
              },
              "priority": {
                "type": "number"
              },
              "assignee": {
                "type": "string",
                "ref": "entity"
              },
              "domain": {
                "type": "string"
              },
              "accept": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocked": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "description": "Tasks to create together; shared top-level fields are defaults."
        }
      },
      "positional": [
        "title",
        "body"
      ]
    },
    "task_list": {
      "tool": true,
      "noun": "task",
      "verb": "list",
      "title": "List tasks",
      "step": {
        "doing": "Checking its to-do list…",
        "done": "Checked its to-do list"
      },
      "description": "Return whole tasks matching query, always narrowed by .task. Without a query, selects .task.status=open. Filters use .component.property=value; bare words search text.",
      "input": {
        "query": {
          "type": "string",
          "description": "Query narrowed by .task."
        },
        "limit": {
          "type": "number",
          "description": "Maximum results.",
          "short": "n"
        }
      },
      "watch": [
        ".task",
        ["%{query}", ".task.status=open"],
        ".limit=%{limit}",
        "*"
      ],
      "readOnly": true,
      "positional": [
        "query"
      ]
    },
    "task_update": {
      "tool": true,
      "destructive": false,
      "noun": "task",
      "verb": "update",
      "title": "Update a task",
      "step": {
        "doing": "Updating this task…",
        "done": "Updated this task",
        "by": {
          "status": {
            "done": {
              "doing": "Marking this task done…",
              "done": "Marked this task done"
            }
          }
        }
      },
      "description": "Patch one task or atomic updates; rows inherit top-level fields. Omitted fields stay; null clears. status writes started/completion/cancellation marks. requires links the task to prerequisites it waits for. edit replaces, appends or prepends body text with a concurrency guard; body with was checks the supplied read token. Returns applied bundles.",
      "input": {
        "task": {
          "type": "string",
          "ref": "task",
          "description": "Task id or name."
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "wip",
            "done",
            "cancelled"
          ],
          "description": "Resulting status.",
          "short": "s"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Replacement title."
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "Replacement body, as Markdown: steps a numbered list, several items a bulleted list."
        },
        "was": {
          "type": [
            "string",
            "null"
          ],
          "description": "Read token from task_list or graph_show at $was.doc.body; body refuses if changed since that read."
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "ref": "project",
          "description": "Project id or name.",
          "short": "p"
        },
        "priority": {
          "type": [
            "number",
            "null"
          ],
          "description": "Queue order; lower is more urgent."
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "ref": "entity",
          "description": "Assignee id or name."
        },
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "description": "Area of work."
        },
        "accept": {
          "type": [
            "string",
            "null"
          ],
          "description": "Completion conditions; null clears."
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ],
          "description": "External obstacle; null clears."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite ids: each becomes a requires link from the task, which waits for them."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Why the task is cancelled; pass it with status cancelled."
        },
        "edit": {
          "type": "object",
          "properties": {
            "find": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            },
            "append": {
              "type": "string"
            },
            "prepend": {
              "type": "string"
            },
            "all": {
              "type": "boolean"
            },
            "was": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Edit doc.body; find must match once unless all. Append/prepend are literal."
        },
        "updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string",
                "ref": "task"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "wip",
                  "done",
                  "cancelled"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "was": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "project": {
                "type": [
                  "string",
                  "null"
                ],
                "ref": "project"
              },
              "priority": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "assignee": {
                "type": [
                  "string",
                  "null"
                ],
                "ref": "entity"
              },
              "domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "accept": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocked": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "edit": {
                "type": "object",
                "properties": {
                  "find": {
                    "type": "string"
                  },
                  "replace": {
                    "type": "string"
                  },
                  "append": {
                    "type": "string"
                  },
                  "prepend": {
                    "type": "string"
                  },
                  "all": {
                    "type": "boolean"
                  },
                  "was": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "task"
            ],
            "additionalProperties": false
          },
          "description": "Per-task patches; top-level fields supply defaults."
        }
      },
      "idempotent": true,
      "positional": [
        "task",
        "status"
      ]
    },
    "shows": {
      "$id": "urn:uuid:4f5dd093-a1a2-40e8-a4e7-b89a487c4705",
      "component": true,
      "type": "object",
      "edge": "shows",
      "reversed": "shown in",
      "description": "this decision presents that entity under one of its choices: an image, prose, or a page such as a draft of an app",
      "properties": {
        "choice": {
          "$id": "urn:uuid:6857bdf6-1e39-4fe5-8999-394d07fd8f09",
          "type": "string",
          "minLength": 1,
          "description": "The label of the choice that presents it."
        }
      },
      "required": [
        "choice"
      ]
    },
    "decision": {
      "$id": "urn:uuid:c9d19446-9a71-4d45-b316-fe3b83234617",
      "component": true,
      "type": "object",
      "description": "A task asking a question, with choices and the asker’s recommendation. Open work requiring it makes it blocking; no such edge makes it eventual.",
      "properties": {
        "question": {
          "$id": "urn:uuid:b3e277ec-f00e-43d1-9a69-8156d027929c",
          "type": "string",
          "minLength": 1,
          "search": true
        },
        "choices": {
          "$id": "urn:uuid:f565248e-ccda-470d-b97e-1ef4628aeb0a",
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Two to four choices, each a label and a line saying what it means."
        },
        "recommended": {
          "$id": "urn:uuid:bebf0d40-8279-4600-8672-5e56f0c64417",
          "type": "string",
          "description": "The label of the choice the asker recommends."
        }
      }
    },
    "decision_new": {
      "tool": true,
      "destructive": false,
      "noun": "decision",
      "verb": "new",
      "title": "Ask a decision",
      "step": {
        "doing": "Asking you to decide…",
        "done": "Asked you to decide"
      },
      "description": "Ask a task question with 2–4 choices and a recommended label; a choice may show an image, prose or a draft by its id. Assign the person being asked. Requiring work waits for its answer. Returns applied bundles.",
      "input": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "shows": {
                "type": "string",
                "minLength": 1,
                "description": "Id of an entity the choice presents, drawn beside it: an image (an artifact), prose (a doc), or a page (a draft of an app)."
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Each choice has a label and a description, and may show an entity."
        },
        "recommended": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "Project id or name."
        },
        "priority": {
          "type": "number",
          "description": "Queue order; lower is more urgent."
        },
        "assignee": {
          "type": "string",
          "ref": "entity",
          "description": "Assignee id or name."
        },
        "domain": {
          "type": "string",
          "description": "Area of work."
        }
      },
      "required": [
        "question",
        "choices",
        "recommended"
      ],
      "positional": [
        "question"
      ]
    },
    "decision_answer": {
      "tool": true,
      "destructive": false,
      "noun": "decision",
      "verb": "answer",
      "title": "Answer a decision",
      "step": {
        "doing": "Answering a question…",
        "done": "Answered a question"
      },
      "description": "Answer with a listed choice’s label or your own words. Records decided{choice} attributed to the caller, completes the task, and releases work requiring it. An answered or cancelled decision refuses another answer. Returns applied bundles.",
      "input": {
        "decision": {
          "type": "string",
          "ref": "decision",
          "description": "Decision task id or name."
        },
        "choice": {
          "type": "string",
          "minLength": 1,
          "description": "A listed label or a custom answer."
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "description": "Person whose explicit answer is recorded."
        }
      },
      "required": [
        "decision",
        "choice"
      ],
      "positional": [
        "decision",
        "choice"
      ]
    },
    "decision_record": {
      "tool": true,
      "destructive": false,
      "noun": "decision",
      "verb": "record",
      "title": "Record a decision you made",
      "step": {
        "doing": "Noting a choice…",
        "done": "Noted a choice"
      },
      "description": "Record a choice you made yourself between 2–4 options, the one you took and why, so it can be read later beside the work it shaped. It asks nobody, is answered as yours, and is done at once. Returns applied bundles.",
      "input": {
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "What was chosen, as a question: “How does the game look?”"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "shows": {
                "type": "string",
                "minLength": 1,
                "description": "Id of an entity the choice presents, drawn beside it: an image (an artifact), prose (a doc), or a page (a draft of an app)."
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "The options you weighed, each a label and a line saying what it means."
        },
        "chose": {
          "type": "string",
          "minLength": 1,
          "description": "The label of the option you took."
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "description": "Why you took it, in a line."
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "Project id or name."
        }
      },
      "required": [
        "question",
        "choices",
        "chose",
        "why"
      ],
      "positional": [
        "question"
      ]
    },
    "decision_answered": {
      "rule": true,
      "match": ".task .decision .decided !cancelled, +!completed",
      "description": "An answered decision finishes its task, so work requiring it can proceed."
    }
  },
  "kinds": {
    "task": {
      "$id": "urn:uuid:c1a80ff2-0ba3-450f-8931-993669a0a1f3",
      "description": "a thing to do",
      "with": {
        "doc": true
      },
      "before": [
        "claim"
      ],
      "prefix": "T",
      "examples": [
        {
          "task": {},
          "doc": {
            "title": "Name the decision kind",
            "body": "A task carrying a decision"
          }
        }
      ]
    },
    "decision": {
      "$id": "urn:uuid:0752fc4c-be85-4d55-8f02-8958ea829d09",
      "description": "a question somebody answers: a task carrying the choices and the asker’s recommendation",
      "is": [
        "task",
        "decision"
      ],
      "with": {
        "doc": true
      },
      "examples": [
        {
          "task": {},
          "decision": {
            "question": "Which name?",
            "choices": [
              {
                "label": "decision",
                "description": "the word the tools use"
              },
              {
                "label": "question",
                "description": "what it asks"
              }
            ],
            "recommended": "decision"
          },
          "doc": {
            "title": "Which name?"
          }
        }
      ]
    }
  }
}
