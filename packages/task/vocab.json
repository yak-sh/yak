{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/id": true,
    "https://yak.sh/vocab/edge": true,
    "https://yak.sh/vocab/blob": true,
    "https://yak.sh/vocab/kernel": true
  },
  "title": "task",
  "$defs": {
    "accept": {
      "component": true,
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "store": "blob",
          "description": "the conditions, in prose"
        }
      },
      "description": "what finishing this means — written when the work is asked for, not after"
    },
    "blocked": {
      "component": true,
      "type": "object",
      "description": "something outside the graph is in the way. Not a status: a blocked task is still open work.",
      "properties": {
        "on": {
          "type": "string",
          "description": "what it is waiting on, in words"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "stamped": true
        }
      }
    },
    "cancelled": {
      "component": true,
      "type": "object",
      "description": "the mark on a task that was called off",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "when it was called off",
          "stamped": true
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "who called it off — kept as history when that entity is deleted",
          "stamped": true
        },
        "reason": {
          "type": "string",
          "description": "why it was called off"
        },
        "via": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true,
          "description": "what the write came in through — the session or client that made it"
        }
      }
    },
    "contains": {
      "component": true,
      "type": "object",
      "edge": "contains",
      "reversed": "contained by",
      "description": "that task is part of this one",
      "properties": {}
    },
    "requires": {
      "component": true,
      "type": "object",
      "edge": "requires",
      "reversed": "required by",
      "description": "this task waits for that one",
      "properties": {}
    },
    "task": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "claim",
        "doc"
      ],
      "prefix": "T",
      "governed": true,
      "description": "a thing to do",
      "status": {
        "cancelled": "cancelled",
        "completed": "done",
        "default": "open"
      },
      "properties": {}
    },
    "task_new": {
      "tool": true,
      "noun": "task",
      "verb": "new",
      "title": "Create a task",
      "description": "Create one task or an atomic tasks batch. Batch rows inherit top-level filing; id ($name), parent and requires connect a tree or dependencies. check previews without saving. Returns applied bundles.",
      "input": {
        "title": {
          "type": "string",
          "description": "what to do, in one line"
        },
        "body": {
          "type": "string",
          "description": "what is being asked for, plus pointers to the details, as markdown",
          "short": "b"
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "the project to file it under; pass its id or registered name",
          "short": "p"
        },
        "priority": {
          "type": "number",
          "description": "queue order; lower is more urgent"
        },
        "assignee": {
          "type": "string",
          "ref": "entity",
          "description": "id or registered name of the person or agent whose queue it goes in"
        },
        "domain": {
          "type": "string",
          "description": "the area of work"
        },
        "check": {
          "type": "boolean",
          "description": "rehearse the write and roll it back, returning the resolved task without saving it"
        },
        "accept": {
          "type": [
            "string",
            "null"
          ],
          "description": "Completion conditions; null clears."
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ],
          "description": "External obstacle; null clears."
        },
        "parent": {
          "type": "string",
          "description": "Containing entity id, or $id in tasks."
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Prerequisite ids, including $ids in tasks."
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^\\$",
                "description": "Local $name for sibling links; optional."
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "project": {
                "type": "string",
                "ref": "project"
              },
              "priority": {
                "type": "number"
              },
              "assignee": {
                "type": "string",
                "ref": "entity"
              },
              "domain": {
                "type": "string"
              },
              "accept": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocked": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent": {
                "type": "string"
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "description": "Tasks to create together; shared top-level fields are defaults."
        }
      },
      "positional": [
        "title",
        "body"
      ]
    },
    "task_list": {
      "tool": true,
      "noun": "task",
      "verb": "list",
      "title": "List tasks",
      "description": "Return whole tasks matching query, always narrowed by .task. Without a query, selects .task.status=open. Filters use .component.property=value; bare words search text.",
      "input": {
        "query": {
          "type": "string",
          "description": "query parameters, joined onto `.task`"
        },
        "limit": {
          "type": "number",
          "description": "return at most this many",
          "short": "n"
        }
      },
      "readOnly": true,
      "positional": [
        "query"
      ]
    },
    "task_update": {
      "tool": true,
      "noun": "task",
      "verb": "update",
      "title": "Update a task",
      "description": "Patch one task or atomic updates; rows inherit top-level fields. Omitted fields stay; null clears. status writes completion/cancellation marks. edit replaces, appends or prepends body text with a concurrency guard; body with was checks the supplied read token. Returns applied bundles.",
      "input": {
        "task": {
          "type": "string",
          "ref": "task",
          "description": "the task to change; pass its id or registered name"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "cancelled"
          ],
          "description": "the new status: open, done or cancelled",
          "short": "s"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "a new title"
        },
        "body": {
          "type": [
            "string",
            "null"
          ],
          "description": "a new body"
        },
        "was": {
          "type": [
            "string",
            "null"
          ],
          "description": "the SHA-256 at $was.doc.body returned by task_list or graph_show (was: in yak graph show); when supplied with body, refuse if the body moved since that read"
        },
        "project": {
          "type": [
            "string",
            "null"
          ],
          "ref": "project",
          "description": "the project to file it under; pass its id or registered name",
          "short": "p"
        },
        "priority": {
          "type": [
            "number",
            "null"
          ],
          "description": "queue order; lower is more urgent"
        },
        "assignee": {
          "type": [
            "string",
            "null"
          ],
          "ref": "entity",
          "description": "id or registered name of the person or agent whose queue it goes in"
        },
        "domain": {
          "type": [
            "string",
            "null"
          ],
          "description": "the area of work"
        },
        "accept": {
          "type": [
            "string",
            "null"
          ],
          "description": "Completion conditions; null clears."
        },
        "blocked": {
          "type": [
            "string",
            "null"
          ],
          "description": "External obstacle; null clears."
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cancellation reason."
        },
        "edit": {
          "type": "object",
          "properties": {
            "find": {
              "type": "string"
            },
            "replace": {
              "type": "string"
            },
            "append": {
              "type": "string"
            },
            "prepend": {
              "type": "string"
            },
            "all": {
              "type": "boolean"
            },
            "was": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Edit doc.body; find must match once unless all. Append/prepend are literal."
        },
        "updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string",
                "ref": "task"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "done",
                  "cancelled"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "was": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "project": {
                "type": [
                  "string",
                  "null"
                ],
                "ref": "project"
              },
              "priority": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "assignee": {
                "type": [
                  "string",
                  "null"
                ],
                "ref": "entity"
              },
              "domain": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "accept": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocked": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "edit": {
                "type": "object",
                "properties": {
                  "find": {
                    "type": "string"
                  },
                  "replace": {
                    "type": "string"
                  },
                  "append": {
                    "type": "string"
                  },
                  "prepend": {
                    "type": "string"
                  },
                  "all": {
                    "type": "boolean"
                  },
                  "was": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "task"
            ],
            "additionalProperties": false
          },
          "description": "Per-task patches; top-level fields supply defaults."
        }
      },
      "idempotent": true,
      "positional": [
        "task",
        "status"
      ]
    },
    "decision": {
      "component": true,
      "type": "object",
      "description": "A task asking a question, with choices and the asker’s recommendation. Open work requiring it makes it blocking; no such edge makes it eventual.",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "search": true
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Two to four choices, each a label and a line saying what it means."
        },
        "recommended": {
          "type": "string",
          "description": "The label of the choice the asker recommends."
        }
      }
    },
    "decision_new": {
      "tool": true,
      "noun": "decision",
      "verb": "new",
      "title": "Ask a decision",
      "description": "Ask a task question with 2–4 choices and a recommended label. Assign the person being asked. Requiring work waits for its answer. Returns applied bundles.",
      "input": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "description"
            ],
            "additionalProperties": false
          },
          "description": "Two to four choices, each a label and a line saying what it means."
        },
        "recommended": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "ref": "project",
          "description": "the project to file it under; pass its id or registered name"
        },
        "priority": {
          "type": "number",
          "description": "queue order; lower is more urgent"
        },
        "assignee": {
          "type": "string",
          "ref": "entity",
          "description": "id or registered name of the person or agent whose queue it goes in"
        },
        "domain": {
          "type": "string",
          "description": "the area of work"
        }
      },
      "required": [
        "question",
        "choices",
        "recommended"
      ],
      "positional": [
        "question"
      ]
    },
    "decision_answer": {
      "tool": true,
      "noun": "decision",
      "verb": "answer",
      "title": "Answer a decision",
      "description": "Answer with a listed choice’s label or your own words. Records decided{choice} attributed to the caller, completes the task, and releases work requiring it. An answered or cancelled decision refuses another answer. Returns applied bundles.",
      "input": {
        "decision": {
          "type": "string",
          "ref": "decision",
          "description": "The decision task to answer; its id or registered name."
        },
        "choice": {
          "type": "string",
          "minLength": 1,
          "description": "A listed label or a custom answer."
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "description": "Person whose explicit answer is recorded."
        }
      },
      "required": [
        "decision",
        "choice"
      ],
      "positional": [
        "decision",
        "choice"
      ]
    },
    "decision_answered": {
      "rule": true,
      "match": ".task .decision .decided !cancelled, +!completed",
      "description": "An answered decision finishes its task, so work requiring it can proceed."
    }
  }
}
