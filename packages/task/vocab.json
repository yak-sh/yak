{
  "$vocabulary": {
    "https://yaks.sh/vocab/core": true,
    "https://yaks.sh/vocab/id": true,
    "https://yaks.sh/vocab/edge": true,
    "https://yaks.sh/vocab/blob": true,
    "https://yaks.sh/vocab/kernel": true
  },
  "title": "task",
  "$defs": {
    "accept": {
      "component": true,
      "type": "object",
      "properties": {
        "body": {
          "type": "string",
          "store": "blob",
          "bare": false,
          "description": "the conditions, in prose"
        }
      },
      "description": "what finishing this means — written when the work is asked for, not after"
    },
    "blocked": {
      "component": true,
      "type": "object",
      "description": "something outside the graph is in the way. A facet, never a status: a blocked task is still open work.",
      "properties": {
        "on": {
          "type": "string",
          "description": "what it is waiting on, said in words"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "stamped": true
        }
      }
    },
    "cancelled": {
      "component": true,
      "type": "object",
      "description": "the mark a called-off task wears",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "when it was called off",
          "stamped": true
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "who called it off — kept as history when that entity is deleted",
          "stamped": true
        },
        "reason": {
          "type": "string",
          "description": "why it was called off"
        },
        "via": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true,
          "description": "the instrument it was written through — the session or client the write came in on"
        }
      }
    },
    "completed": {
      "component": true,
      "type": "object",
      "index": [
        [
          "at"
        ]
      ],
      "description": "the mark a finished task wears",
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "when it was finished",
          "stamped": true
        },
        "by": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "who finished it — kept as history when that entity is deleted",
          "stamped": true
        },
        "via": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "stamped": true,
          "description": "the instrument it was written through — the session or client the write came in on"
        }
      }
    },
    "contains": {
      "component": true,
      "type": "object",
      "relation": "contains",
      "description": "that task is part of this one",
      "properties": {}
    },
    "requires": {
      "component": true,
      "type": "object",
      "relation": "requires",
      "description": "this task waits for that one",
      "properties": {}
    },
    "task": {
      "component": true,
      "type": "object",
      "kind": true,
      "prefix": "T",
      "governed": true,
      "description": "a thing to do",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "cancelled",
            "done",
            "open"
          ],
          "computed": true,
          "description": "where the task stands — read off the completed and cancelled marks, never written"
        }
      }
    },
    "statuses": {
      "description": "every word a task's derived status can be, the host's extra marks included: `wip` is what a task under a live claim reads as, contributed by whoever ships the claim (see MARKS).",
      "enum": [
        "open",
        "wip",
        "done",
        "cancelled"
      ]
    }
  }
}
