        "y": {
          "$id": "urn:uuid:d979b53f-3cab-485d-8265-a9a0d99aa357",
          "type": "number",
          "description": "top edge, in canvas units"
        },
        "w": {
          "$id": "urn:uuid:1d47e304-7ccd-41d1-9f04-5ad2d4c0dbba",
          "type": "number",
          "description": "width, or 0 for automatic"
        },
        "h": {
          "$id": "urn:uuid:0196d042-923e-4f2e-b306-a607aaecf728",
          "type": "number",
          "description": "height, or 0 for automatic"
        },
        "z": {
          "$id": "urn:uuid:48e031ab-2a80-47e8-9d26-c547f8dbe53d",
          "type": "number",
          "description": "stacking order — higher is front"
        }
      }
    },
    "shelf": {
      "$id": "urn:uuid:cdc13d11-af29-4193-89be-b5e25d2b8723",
      "component": true,
      "journal": false,
      "type": "object",
      "unique": [
        [
          "client"
        ]
      ],
      "sync": "server",
      "description": "what one window is holding aside, off the canvas",
      "properties": {
        "client": {
          "$id": "urn:uuid:e1f48694-ce5d-4a20-bed9-a86b2d03fadc",
