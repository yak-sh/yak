      "component": true,
      "type": "object",
      "by_name": true,
      "sync": "server",
      "description": "a plane things are arranged on",
      "properties": {}
    },
    "card": {
      "$id": "urn:uuid:96b001be-18d6-476b-8685-86e55cb58d5a",
      "component": true,
      "type": "object",
      "sync": "server",
