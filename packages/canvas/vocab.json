{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true,
    "https://yak.sh/vocab/id": true,
    "https://yak.sh/vocab/names": true
  },
  "title": "canvas",
  "$defs": {
    "camera": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "client",
          "canvas"
        ]
      ],
      "sync": "server",
      "description": "where one window is looking at one canvas — synced to the server so another tab, or a tool, can read it and move it",
      "properties": {
        "client": {
          "type": "string",
          "ref": "client",
          "death": "cascade",
          "description": "the window doing the looking"
        },
        "canvas": {
          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "the canvas it is looking at"
        },
        "x": {
          "type": "number",
          "description": "viewport centre, in canvas units"
        },
        "y": {
          "type": "number",
          "description": "viewport centre, in canvas units"
        },
        "zoom": {
          "type": "number",
          "description": "scale — 2 draws everything twice as large"
        },
        "w": {
          "type": "number",
          "description": "viewport width, in pixels"
        },
        "h": {
          "type": "number",
          "description": "viewport height, in pixels"
        }
      }
    },
    "canvas": {
      "component": true,
      "type": "object",
      "kind": true,
      "by_name": true,
      "sync": "server",
      "description": "a plane things are arranged on",
      "properties": {}
    },
    "card": {
      "component": true,
      "type": "object",
      "kind": true,
      "sync": "server",
      "description": "one entity shown on a canvas",
      "properties": {
        "target": {
          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "the entity shown — the card is deleted with it, because a card showing nothing is nothing"
        },
        "view": {
          "type": "string",
          "description": "the view it is rendered in"
        }
      }
    },
    "client": {
      "component": true,
      "type": "object",
      "kind": true,
      "sync": "server",
      "description": "one open window — what a camera, a cursor, a fold and a shelf each belong to",
      "properties": {
        "user_agent": {
          "type": "string",
          "description": "the user-agent string the window reported"
        },
        "actor": {
          "type": "string",
          "ref": "entity",
          "death": "detach",
          "description": "who is at the window — the column is cleared, not the row deleted, when they are gone"
        },
        "ip": {
          "type": "string",
          "stamped": true,
          "description": "the address it connected from — written by the server"
        }
      }
    },
    "cursor": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "client"
        ]
      ],
      "sync": "server",
      "description": "what one window has open — synced to the server, so a tool can move someone there by writing it",
      "properties": {
        "client": {
          "type": "string",
          "ref": "client",
          "death": "cascade",
          "description": "the window"
        },
        "target": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "the entity it is showing — kept when that entity is deleted, so the history still makes sense"
        },
        "view": {
          "type": "string",
          "description": "the view it is showing it in"
        }
      }
    },
    "fold": {
      "component": true,
      "type": "object",
      "kind": true,
      "unique": [
        [
          "client",
          "board"
        ]
      ],
      "sync": "server",
      "description": "the sections of a list one window has collapsed",
      "properties": {
        "client": {
          "type": "string",
          "ref": "client",
          "death": "cascade",
          "description": "the window"
        },
        "board": {
          "type": "string",
          "ref": "board",
          "death": "cascade",
          "description": "the list whose sections are collapsed — a `board` in your own vocabulary"
        },
        "statuses": {
          "type": "string",
          "description": "which sections are collapsed"
        }
      }
    },
    "layout": {
      "component": true,
      "type": "object",
      "kind": true,
      "prefix": "L",
      "by_name": true,
      "sync": "server",
      "description": "a named split of the screen into panes",
      "properties": {
        "root": {
          "type": "string",
          "ref": "pane",
          "death": "detach",
          "description": "the pane every other pane sits inside"
        }
      }
    },
    "pane": {
      "component": true,
      "type": "object",
      "kind": true,
      "sync": "server",
      "description": "one region of a layout: either a split, or a region showing an entity",
      "properties": {
        "layout": {
          "type": "string",
          "ref": "layout",
          "death": "cascade",
          "description": "the layout it belongs to"
        },
        "parent": {
          "type": "string",
          "ref": "pane",
          "death": "cascade",
          "bare": false,
          "description": "the pane it sits inside"
        },
        "size": {
          "type": "number",
          "description": "its share of the parent"
        },
        "order": {
          "type": "number",
          "description": "its place among its siblings"
        },
        "dir": {
          "type": "string",
          "enum": [
            "h",
            "v"
          ],
          "description": "how it splits: side by side, or stacked"
        },
        "content": {
          "type": "string",
          "ref": "entity",
          "death": "detach",
          "description": "the entity shown in it, if it shows one"
        },
        "view": {
          "type": "string",
          "description": "the view that entity is shown in"
        }
      }
    },
    "pin": {
      "component": true,
      "type": "object",
      "sync": "server",
      "description": "where a card sits on a canvas",
      "properties": {
        "canvas": {
          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "the canvas it is pinned to"
        },
        "x": {
          "type": "number",
          "description": "left edge, in canvas units"
        },
        "y": {
          "type": "number",
          "description": "top edge, in canvas units"
        },
        "w": {
          "type": "number",
          "description": "width, or 0 for automatic"
        },
        "h": {
          "type": "number",
          "description": "height, or 0 for automatic"
        },
        "z": {
          "type": "number",
          "description": "stacking order — higher is front"
        }
      }
    },
    "shelf": {
      "component": true,
      "type": "object",
      "unique": [
        [
          "client"
        ]
      ],
      "sync": "server",
      "description": "what one window is holding aside, off the canvas",
      "properties": {
        "client": {
          "type": "string",
          "ref": "client",
          "death": "release",
          "description": "the window holding it — when the window goes the shelf empties, and the entities on it remain"
        }
      }
    }
  }
}
