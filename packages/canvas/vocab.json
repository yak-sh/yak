          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "the canvas it is looking at"
        },
        "x": {
          "$id": "urn:uuid:a3819ce9-f5b3-418c-bb0a-6b00bbce0855",
          "type": "number",
          "description": "viewport centre, in canvas units"
        },
        "y": {
          "$id": "urn:uuid:59bc9e3b-ecba-4597-923c-4a3edee0890d",
