{
  "name": "slack",
  "title": "Slack",
  "tagline": "Talk to your Operator in Slack. Mention it in a channel or send it a direct message.",
  "site": "https://slack.com",
  "authorize": "https://slack.com/oauth/v2/authorize",
  "token": "https://slack.com/api/oauth.v2.access",
  "client": "slack",
  "pkce": false,
  "scope_separator": ",",
  "account": "team.id",
  "account_title": "team.name",
  "chat": "slack",
  "chat_grant": true,
  "hosts": [
    "slack.com"
  ],
  "scopes": [
    "app_mentions:read",
    "bookmarks:read",
    "bookmarks:write",
    "calls:read",
    "calls:write",
    "canvases:read",
    "canvases:write",
    "channels:history",
    "channels:join",
    "channels:manage",
    "channels:read",
    "channels:write.invites",
    "channels:write.topic",
    "chat:write",
    "chat:write.customize",
    "chat:write.public",
    "conversations.connect:manage",
    "conversations.connect:read",
    "conversations.connect:write",
    "dnd:read",
    "emoji:read",
    "files:read",
    "files:write",
    "groups:history",
    "groups:read",
    "groups:write",
    "groups:write.invites",
    "groups:write.topic",
    "im:history",
    "im:read",
    "im:write",
    "im:write.topic",
    "lists:read",
    "lists:write",
    "metadata.message:read",
    "mpim:history",
    "mpim:read",
    "mpim:write.topic",
    "pins:read",
    "pins:write",
    "reactions:read",
    "reactions:write",
    "reminders:read",
    "reminders:write",
    "remote_files:read",
    "remote_files:share",
    "remote_files:write",
    "team.preferences:read",
    "team:read",
    "usergroups:read",
    "usergroups:write",
    "users.profile:read",
    "users:read",
    "users:read.email",
    "users:write"
  ],
  "api": {
    "base": "https://slack.com/api",
    "docs": "https://docs.slack.dev/reference/methods/",
    "reads": [
      "POST /auth.test",
      "POST /bookmarks.list",
      "POST /calls.info",
      "POST /canvases.sections.lookup",
      "POST /slackLists.download.get",
      "POST /slackLists.items.info",
      "POST /slackLists.items.list"
    ]
  }
}
