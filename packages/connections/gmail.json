{
  "name": "gmail",
  "title": "Gmail",
  "tagline": "Your Gmail account: its mail read, sent, drafted and labelled.",
  "site": "https://mail.google.com",
  "image": "https://app.nango.dev/images/template-logos/google-mail.svg",
  "authorize": "https://accounts.google.com/o/oauth2/v2/auth",
  "token": "https://oauth2.googleapis.com/token",
  "client": "google",
  "broker": {
    "name": "nango",
    "integration": "google-mail"
  },
  "scopes": [
    "https://mail.google.com/"
  ],
  "params": {
    "access_type": "offline",
    "prompt": "consent"
  },
  "hosts": [
    "gmail.googleapis.com"
  ],
  "api": {
    "base": "https://gmail.googleapis.com/gmail/v1",
    "docs": "https://developers.google.com/workspace/gmail/api/reference/rest"
  },
  "userinfo": "https://openidconnect.googleapis.com/v1/userinfo"
}
