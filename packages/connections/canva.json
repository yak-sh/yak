{
  "name": "canva",
  "title": "Canva",
  "tagline": "Your Canva designs: found, made, filled in and exported.",
  "site": "https://www.canva.com",
  "image": "https://app.nango.dev/images/template-logos/canva.svg",
  "categories": ["design"],
  "authorize": "https://www.canva.com/api/oauth/authorize",
  "token": "https://api.canva.com/rest/v1/oauth/token",
  "client": "canva",
  "scopes": [
    "profile:read",
    "design:meta:read",
    "design:content:read",
    "design:content:write",
    "brandtemplate:meta:read",
    "brandtemplate:content:read",
    "asset:read"
  ],
  "hosts": ["api.canva.com"],
  "userinfo": "https://api.canva.com/rest/v1/users/me/profile",
  "account": "profile.display_name"
}
