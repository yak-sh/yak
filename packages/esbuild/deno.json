    "fflate": "npm:fflate@0.8.3",
    "resolve.exports": "npm:resolve.exports@2.0.3",
    "semver": "npm:semver@7.8.5",
    "sucrase": "npm:sucrase@3.35.1"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts"
    ]
  }
}
