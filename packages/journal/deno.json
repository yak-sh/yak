    "@std/assert": "jsr:@std/assert@^1.0.0",
    "lucide": "npm:lucide@1.31.0",
    "preact": "npm:preact@^10.29.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "esnext"
    ]
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "./testing.ts",
      "./browser.json"
    ]
  }
}
