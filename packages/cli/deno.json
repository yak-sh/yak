{
  "name": "@yaks/cli",
  "version": "0.2.10",
  "exports": {
    ".": "./mod.ts",
    "./yak": "./yak.ts",
    "./config": "./config.ts",
    "./host": "./host.ts",
    "./install": "./install.ts",
    "./page": "./page.ts",
    "./release": "./release.ts",
    "./grammar": "./grammar.ts"
  },
  "license": "Apache-2.0",
  "description": "The yak command line: it opens the graph a config file names, or connects to an MCP server, and turns every tool it finds there into a subcommand parsed through that tool's own input schema.",
  "imports": {
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "es-module-lexer": "npm:es-module-lexer@1.7.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "esbuild": "npm:esbuild@0.28.1",
    "preact": "npm:preact@^10.29.1",
    "typescript": "npm:typescript@6.0.3"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "esnext"
    ]
  },
  "publish": {
    "exclude": [
      "**/*_test.ts"
    ]
  }
