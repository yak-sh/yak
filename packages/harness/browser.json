    "@yaks/sql": "../sql/mod.ts",
    "@yaks/blob/vocab": "../blob/vocab.ts",
    "@yaks/doc/vocab": "../doc/vocab.ts",
    "@yaks/edge/vocab": "../edge/vocab.ts",
    "@yaks/git/vocab": "../git/vocab.ts",
    "@yaks/id/vocab": "../id/vocab.ts",
    "@yaks/kernel/vocab": "../kernel/vocab.ts",
    "@yaks/mcp-client/vocab": "../mcp-client/vocab.ts",
    "@yaks/model/vocab": "../model/vocab.ts",
    "@yaks/openai/vocab": "../openai/vocab.ts",
    "@yaks/openrouter/vocab": "../openrouter/vocab.ts",
    "@yaks/process/vocab": "../process/vocab.ts",
    "@yaks/project/vocab": "../project/vocab.ts",
