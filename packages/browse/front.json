{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "browse front",
  "description": "The browsing app's own state in the page graph, never synced.",
  "$defs": {
    "inboxView": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "the inbox's expanded threads and search switches; words remain synced drafts",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "the thread is expanded"
        },
        "direction": {
          "type": "string",
          "enum": [
            "both",
            "said",
            "received"
          ]
        },
        "all": {
          "type": "boolean",
          "description": "include archived threads"
        }
      }
    },
    "commentBox": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "a reply composer open on a comment; its words are a synced draft, not page state",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "the reply composer is open"
        }
      }
    },
    "Sidebar": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "the browse sidebar: sections and packages folded on this page; its query words live in the shared filter draft",
      "properties": {
        "closed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "section names or package eids the reader folded"
        },
        "hover": {
          "type": "boolean",
          "description": "a draggable entity is over the sidebar"
        },
        "open": {
          "type": "boolean",
          "description": "the sidebar is visible"
        }
      }
    }
  }
}
