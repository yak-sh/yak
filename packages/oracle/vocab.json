{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "oracle_tree": {
      "component": true,
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "The root oracle."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Frozen verbatim evidence: id, at and words."
        }
      },
      "description": "One evidence-grown oracle tree.",
      "kind": true
    },
    "oracle": {
      "component": true,
      "type": "object",
      "properties": {
        "tree": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "The tree this oracle belongs to."
        },
        "domain": {
          "type": "string"
        },
        "advert": {
          "type": "object"
        },
        "self": {
          "type": "string"
        },
        "shared": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "key": {
          "type": "string",
          "description": "Stable engine node identity within the tree."
        }
      },
      "description": "An oracle and its immutable context revisions.",
      "kind": true
    },
    "oracle_child": {
      "component": true,
      "type": "object",
      "properties": {},
      "description": "The child oracle points to its parent.",
      "edge": true
    },
    "oracle_dialogue": {
      "component": true,
      "type": "object",
      "properties": {
        "tree": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "The tree queried."
        },
        "from": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "The asking oracle session."
        },
        "to": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "The receiving oracle session."
        },
        "revision": {
          "type": "string"
        },
        "turns": {
          "type": "integer"
        },
        "declined": {
          "type": "boolean"
        },
        "finished": {
          "type": "boolean"
        }
      },
      "description": "A query conversation between oracle sessions."
    },
    "oracle_query": {
      "tool": true,
      "noun": "oracle",
      "verb": "query",
      "description": "Open a native conversation about a topic, admitting its self and direct family contexts as a frozen prompt with the configured model. Returns immediately; native callers can wait on the delegated session. Retained experiment oracles keep their receiving-fork behavior.",
      "input": {
        "oracle": {
          "type": "string",
          "ref": "entity"
        },
        "text": {
          "type": "string"
        },
        "model": {
          "type": "string",
          "ref": "model"
        }
      },
      "required": [
        "oracle",
        "text"
      ],
      "applied": true
    },
    "oracle_read": {
      "tool": true,
      "noun": "oracle",
      "verb": "read",
      "description": "Read a topic and its three directional retained contexts. $was.topic_context gives the preconditions for oracle_revise.",
      "input": {
        "oracle": {
          "type": "string",
          "ref": "entity"
        }
      },
      "required": [
        "oracle"
      ],
      "readOnly": true
    },
    "oracle_revise": {
      "tool": true,
      "noun": "oracle",
      "verb": "revise",
      "description": "Cultivate a topic’s self, parent-facing or children-facing context from recorded evidence. Replaces only supplied directions, each with immutable provenance. Pass the corresponding $was.topic_context tokens from oracle_read; stale writes are refused. Existing receiving conversations keep their admitted contexts.",
      "input": {
        "oracle": {
          "type": "string",
          "ref": "topic"
        },
        "parent": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "ref": "entity"
              }
            }
          },
          "required": [
            "body",
            "evidence"
          ]
        },
        "self": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "ref": "entity"
              }
            }
          },
          "required": [
            "body",
            "evidence"
          ]
        },
        "children": {
          "type": "object",
          "properties": {
            "body": {
              "type": "string"
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string",
                "ref": "entity"
              }
            }
          },
          "required": [
            "body",
            "evidence"
          ]
        },
        "was": {
          "type": "object",
          "properties": {
            "parent": {
              "type": [
                "string",
                "null"
              ]
            },
            "self": {
              "type": [
                "string",
                "null"
              ]
            },
            "children": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "required": [
        "oracle",
        "was"
      ],
      "applied": true
    }
  }
}
