  "title": "push",
  "$defs": {
    "push_subscription": {
      "$id": "urn:uuid:0fd5f00d-b2b1-4e5a-895f-d922b17d5604",
      "component": true,
      "type": "object",
      "description": "a browser that allowed notifications for its person: where to push, and the keys a message to it is encrypted with; removed when the push service says it is gone",
      "properties": {
        "person": {
          "$id": "urn:uuid:4c606dff-f040-4aaf-9108-dc9ce9152920",
          "type": "string",
          "ref": "entity",
          "death": "cascade",
          "description": "whose browser it is"
        },
        "endpoint": {
          "$id": "urn:uuid:dc7913a2-b51b-4536-b6e5-bb20c7dabf70",
          "type": "string",
          "identity": true,
          "description": "the push service's URL for this browser; the eid is derived from it, so a browser subscribing again is one row"
        },
        "p256dh": {
          "$id": "urn:uuid:94b104a6-66d0-4488-a595-6639561b59ff",
          "type": "string",
          "description": "the browser's P-256 public key, base64url"
        },
        "auth": {
          "$id": "urn:uuid:52149b40-d721-4977-bbff-831a2a5329a4",
          "type": "string",
          "description": "the browser's 16-byte auth secret, base64url"
        }
      }
    }
  }
}
