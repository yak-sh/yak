{
  "name": "@yaks/vocab",
  "version": "0.2.10",
  "description": "Loads and checks component vocabularies expressed as JSON Schema, and reads their property types, references, display ordering, tool declarations, rules and effects.",
  "exports": {
    ".": "./mod.ts",
    "./vocab": "./docs.ts",
    "./tools": "./tools.ts",
    "./constraints": "./constraints.ts",
    "./runtime": "./runtime.ts"
  },
  "license": "Apache-2.0",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@cfworker/json-schema": "npm:@cfworker/json-schema@4.1.1",
    "ajv": "npm:ajv@^8.17.1"
  },
  "publish": {
    "exclude": [
      "**/*_test.ts",
      "testing.ts",
      "fleet/"
    ]
  }
}
