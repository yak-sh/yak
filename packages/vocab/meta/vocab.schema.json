{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yak.sh/vocab/meta",
  "title": "yaks vocab file",
  "description": "The meta-schema a vocabulary document validates against: a JSON Schema 2020-12 document whose $defs entries each carry a marker saying what they are \u2014 an entry marked \"component\": true is a component (an object schema whose properties are each storable and declare a type: a scalar, a reference, a closed set, or a JSON value \u2014 type object, array, or a union \u2014 kept as one), an entry marked \"tool\": true is a tool declaration (a noun, a verb, or both, plus description and input), an entry marked \"rule\": true is a rule declaration (the query it matches, and the rules it runs before), and an entry with no marker is an ordinary reusable subschema this format does not constrain. Only the CORE keyword shapes are inlined, so this file validates standalone; a file using an extension vocabulary's keywords validates against extendMeta([thoseKeywords]) instead.",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://yak.sh/vocab/core": true
  },
  "type": "object",
  "required": [
    "$defs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$id": {
      "type": "string"
    },
    "$vocabulary": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "title": {
      "type": "string"
    },
    "package": {
      "type": "string",
      "description": "the package that declares these components, written by the host that loads the document"
    },
    "description": {
      "type": "string"
    },
    "$defs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "description": "One $defs entry, by its marker: a component, a tool, a rule, or an ordinary subschema nothing here constrains. An entry carries one marker, never two.",
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "component"
            ]
          },
          "then": {
            "$ref": "#/$defs/component"
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "tool"
            ]
          },
          "then": {
            "$ref": "#/$defs/tool"
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "rule"
            ]
          },
          "then": {
            "$ref": "#/$defs/rule"
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "component",
              "tool"
            ]
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "component",
              "rule"
            ]
          }
        },
        {
          "not": {
            "type": "object",
            "required": [
              "tool",
              "rule"
            ]
          }
        }
      ]
    },
    "composites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composite"
      }
    },
    "composite": {
      "description": "One composite index entry: the property names, or an object naming them plus the properties a row must hold for the index to see it (a partial index).",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object",
          "properties": {
            "props": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "props"
          ],
          "additionalProperties": false
        }
      ]
    },
    "component": {
      "type": "object",
      "properties": {
        "component": {
          "const": true
        },
        "extends": {
          "const": true
        },
        "type": {
          "const": "object"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "not": {
              "enum": [
                "entity",
                "eid"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/prop"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "type": "boolean"
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wire": {
          "type": "boolean"
        },
        "sync": {
          "enum": [
            "none",
            "server",
            "peers"
          ]
        },
        "durable": {
          "type": "string",
          "pattern": "^(forever|connection|[0-9]+(\\.[0-9]+)?(ms|s|m|h|d))$"
        },
        "bare": {
          "type": "boolean"
        },
        "unique": {
          "$ref": "#/$defs/composites"
        },
        "index": {
          "$ref": "#/$defs/composites"
        },
        "identity": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "by_name": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "component"
      ]
    },
    "tool": {
      "description": "A tool declaration: what the tool is CALLED and what arguments it accepts. A noun and a verb are two words a command line accepts in either order; either one alone is the whole command name. The entry's own name is the tool's name either way, and the implementation is a function the module exports.",
      "type": "object",
      "properties": {
        "tool": {
          "const": true
        },
        "noun": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "verb": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/arg"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positional": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "short": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-zA-Z]$"
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "rest": {
              "type": "string"
            }
          }
        },
        "readOnly": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "idempotent": {
          "type": "boolean"
        },
        "openWorld": {
          "type": "boolean"
        },
        "surfaces": {
          "description": "Where the tool is offered: cli, the yak command line; mcp, an MCP server's listing. Every surface when absent.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cli",
              "mcp"
            ]
          }
        }
      },
      "required": [
        "tool",
        "description"
      ],
      "additionalProperties": false
    },
    "prop": {
      "description": "One property. Every property declares its `type`. A property whose type is object or array, or a union of types, holds a JSON value and may declare its structure with `properties` or `items`; that structure is accepted as written and not validated yet.",
      "type": "object",
      "properties": {
        "type": {
          "anyOf": [
            {
              "enum": [
                "string",
                "number",
                "integer",
                "boolean",
                "object",
                "array"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "string",
                  "number",
                  "integer",
                  "boolean",
                  "object",
                  "array",
                  "null"
                ]
              }
            }
          ]
        },
        "format": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "const": true,
        "default": true,
        "description": {
          "type": "string"
        },
        "examples": {
          "type": "array"
        },
        "ref": {
          "type": "string"
        },
        "death": {
          "enum": [
            "cascade",
            "detach",
            "release",
            "keep"
          ]
        },
        "computed": {
          "type": "boolean"
        },
        "stamped": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "bare": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "index": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        },
        "items": true
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "dependentRequired": {
        "ref": [
          "death"
        ]
      }
    },
    "arg": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "array"
          ]
        },
        "anyOf": {
          "type": "array",
          "items": true
        },
        "format": {
          "type": "string"
        },
        "enum": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "const": true,
        "default": true,
        "description": {
          "type": "string"
        },
        "examples": {
          "type": "array"
        },
        "ref": {
          "type": "string"
        },
        "death": {
          "enum": [
            "cascade",
            "detach",
            "release",
            "keep"
          ]
        },
        "computed": {
          "type": "boolean"
        },
        "stamped": {
          "type": "boolean"
        },
        "search": {
          "type": "boolean"
        },
        "bare": {
          "type": "boolean"
        },
        "unique": {
          "type": "boolean"
        },
        "index": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "items": true
      },
      "additionalProperties": false,
      "description": "One tool argument: the same declaration a property takes, so a completion reads an argument the way it reads a property \u2014 an enum offers its members, a `ref` offers the entities of that kind, a text argument marked `search` offers what the index finds. An argument that takes either of two shapes \u2014 one name, or a list of them \u2014 says `anyOf`, which a stored property never needs."
    },
    "rule": {
      "description": "A rule declaration: the QUERY it matches, and nothing else. `match` is one or more ordinary query patterns separated by `;`, one per entity \u2014 the sigils say the rest (`+comp` ensures, `+!comp` gates so it fires once, `*comp` is its write set, `$name` names an entity, a `$name` value is that same variable). `before` names the rules this one runs before, so order among rules touching one entity is declared rather than registration-incidental.",
      "type": "object",
      "properties": {
        "rule": {
          "const": true
        },
        "match": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phase": {
          "type": "string",
          "description": "the phase it runs in: `rules` (the default) is the declared half of apply(), before persistence; `effect` is a pattern a post-commit handler is registered on (@yaks/effects) or a sweep asks once (@yaks/tools). Only the `rules` half is run by apply() itself."
        }
      },
      "required": [
        "rule",
        "match"
      ],
      "additionalProperties": false
    }
  }
}
