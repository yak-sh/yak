{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "web front",
  "description": "The web door's own state in the page graph, never synced.",
  "$defs": {
    "inboxView": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "the inbox's expanded threads and search switches; words remain synced drafts",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "the thread is expanded"
        },
        "direction": {
          "type": "string",
          "enum": [
            "both",
            "said",
            "received"
          ]
        },
        "all": {
          "type": "boolean",
          "description": "include archived threads"
        }
      }
    },
    "commentBox": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "a reply composer open on a comment; its words are a synced draft, not page state",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "the reply composer is open"
        }
      }
    },
    "inspectFull": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "The full inspection\u2019s chosen file format and component picker in the page graph.",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "Inspect.Full",
            "Markdown",
            "JSON"
          ]
        },
        "adding": {
          "type": "boolean"
        }
      }
    }
  }
}
