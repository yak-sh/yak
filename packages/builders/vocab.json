{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "builders",
  "$defs": {
    "builder": {
      "component": true,
      "type": "object",
      "kind": true,
      "properties": {
        "query": {
          "type": "string",
          "description": "query whose outer bindings each name a build"
        },
        "to": {
          "type": "string",
          "ref": "tool",
          "death": "keep",
          "description": "registered tool called for each changed binding"
        },
        "floor": {
          "type": "string",
          "format": "date-time",
          "description": "earliest a scheduled reconciliation may run"
        },
        "immediate": {
          "type": "boolean",
          "description": "reconcile when selected graph inputs change"
        }
      },
      "description": "a query-to-tool transformation; content.body is its optional $var template and using chooses a model"
    },
    "builder_dep": {
      "component": true,
      "type": "object",
      "wire": false,
      "identity": ["builder", "source"],
      "properties": {
        "builder": {
          "type": "string",
          "ref": "builder",
          "death": "cascade"
        },
        "source": {
          "type": "string",
          "index": true,
          "description": "component:name or entity:eid read by an immediate builder"
        },
        "version": {
          "type": "string",
          "stamped": true,
          "description": "compare-and-set token for one dependency replacement"
        }
      }
    },
    "build": {
      "component": true,
      "type": "object",
      "identity": [
        "builder",
        "match",
        "variant"
      ],
      "properties": {
        "builder": {
          "type": "string",
          "ref": "builder",
          "death": "keep"
        },
        "match": {
          "type": "string",
          "description": "JSON outer entity-ID tuple"
        },
        "variant": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "stamped": true,
          "description": "current desired input key"
        },
        "call": {
          "type": "string",
          "ref": "call",
          "death": "keep",
          "stamped": true,
          "description": "latest call for this key"
        },
        "stale": {
          "type": "boolean",
          "stamped": true,
          "description": "outer binding no longer matches"
        },
        "cost": {
          "type": "number",
          "computed": true,
          "reads": [
            "call.source",
            "session.source",
            "entry.session",
            "cost.dollars"
          ],
          "description": "the dollars its calls spent, summed: each call's own `cost` and the entries of each session a call opened; absent where none records any"
        }
      },
      "description": "one stable instance of a builder for an outer query binding"
    },
    "built": {
      "component": true,
      "type": "object",
      "kind": true,
      "before": [
        "doc"
      ],
      "identity": [
        "build",
        "slot"
      ],
      "properties": {
        "build": {
          "type": "string",
          "ref": "build",
          "death": "keep",
          "bare": false
        },
        "slot": {
          "type": "string",
          "bare": false
        },
        "key": {
          "type": "string",
          "stamped": true,
          "bare": false
        },
        "call": {
          "type": "string",
          "ref": "call",
          "death": "keep",
          "stamped": true
        },
        "artifact": {
          "type": "string",
          "ref": "artifact",
          "death": "keep",
          "stamped": true
        }
      },
      "description": "one named output; current when its key equals its non-stale build key"
    },
    "builder_model": {
      "tool": true,
      "noun": "builder",
      "verb": "model",
      "title": "Model builder adapter",
      "description": "Open a model session for one frozen builder binding",
      "surfaces": [],
      "input": {
        "binding": { "type": "object" },
        "key": { "type": "string" },
        "template": { "type": "string" },
        "using": { "type": "object" }
      },
      "required": ["binding", "key"]
    },
    "builder_build": {
      "tool": true,
      "noun": "builder",
      "verb": "build",
      "title": "Build now",
      "description": "Reconcile a builder now, independent of its floor. Optional alternate provider, model or template creates a shadow variant.",
      "input": {
        "builder": {
          "type": "string",
          "ref": "builder",
          "description": "id of the builder to build"
        },
        "provider": {
          "type": "string",
          "ref": "provider",
          "description": "the provider to ask instead of the configured one"
        },
        "model": {
          "type": "string",
          "ref": "model",
          "description": "the model to build with instead of the configured one"
        },
        "template": {
          "type": "string",
          "description": "alternate content.body template for a shadow variant"
        }
      },
      "required": [
        "builder"
      ],
      "options": {
        "positional": [
          "builder"
        ],
        "short": {
          "m": "model",
          "p": "provider"
        }
      },
      "idempotent": true
    },
    "builder_open": {
      "effect": true,
      "created": [
        "builder"
      ],
      "changed": [
        "builder.floor"
      ],
      "sweep": ".builder",
      "description": "build a builder whose floor has passed, unless its key is built"
    },
    "builder_edit": {
      "effect": true,
      "changed": [
        "builder.query",
        "builder.to",
        "builder.immediate",
        "content.body",
        "using"
      ],
      "description": "reconcile a builder after its definition changes"
    },
    "builder_ring": {
      "effect": true,
      "created": [
        "fired"
      ],
      "changed": [
        "fired.at"
      ],
      "description": "a wake fired on a builder: check whether it is due"
    },
    "builder_answer": {
      "effect": true,
      "created": [
        "output"
      ],
      "description": "validate a tool answer and write its named outputs"
    },
    "builder_model_answer": {
      "effect": true,
      "created": ["output", "attachment", "error"],
      "description": "adapt a model session's reply to a builder tool output"
    },
    "builder_change": {
      "effect": true,
      "active": ".builder.immediate=true&.limit=1",
      "created": [
        "created",
        "updated"
      ],
      "changed": [
        "updated"
      ],
      "removed": [
        "created"
      ],
      "description": "check immediate builders when an entity enters, changes or leaves their query"
    }
  }
}
