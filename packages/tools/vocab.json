{
  "title": "invocation",
  "$defs": {
    "call": {
      "component": true,
      "type": "object",
      "description": "A recorded tool invocation.",
      "properties": {
        "to": {
          "type": "string",
          "ref": "tool",
          "death": "keep",
          "description": "the tool entity called"
        },
        "id": {
          "type": "string",
          "description": "the provider's id for it, echoed in the result"
        },
        "args": {
          "type": "string",
          "description": "its arguments, as JSON"
        },
        "source": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "Optional originating request or other source entity."
        }
      }
    },
    "result": {
      "component": true,
      "type": "object",
      "description": "what a tool answered",
      "properties": {
        "ms": {
          "type": "number",
          "description": "measured tool wall-clock milliseconds"
        },
        "call": {
          "type": "string",
          "ref": "call",
          "death": "keep",
          "description": "the tool call it answers"
        }
      }
    },
    "content": {
      "component": true,
      "type": "object",
      "description": "Text content.",
      "properties": {
        "body": {
          "type": "string",
          "store": "blob"
        }
      }
    },
    "output": {
      "component": true,
      "type": "object",
      "description": "what produced the prose beside it: the ask, for a model’s own words, the call whose failure this reports, or the stream it came off (@yaks/process). Worn only by an output; prose a person or a system wrote has none",
      "properties": {
        "source": {
          "type": "string",
          "ref": "entity",
          "death": "keep",
          "description": "the entry or run that produced it"
        }
      }
    },
    "error": {
      "component": true,
      "type": "object",
      "description": "an outcome the code expected and recorded: normal",
      "properties": {
        "code": {
          "type": "string"
        }
      }
    },
    "exception": {
      "component": true,
      "type": "object",
      "description": "an outcome the code did not expect, whoever caused it: a defect report, not a stop",
      "properties": {}
    },
    "execution": {
      "component": true,
      "type": "object",
      "description": "Execution of a recorded call. A started call without a result is not automatically replayed.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "started",
            "completed"
          ]
        }
      }
    },
    "tool": {
      "component": true,
      "type": "object",
      "kind": true,
      "description": "A registered tool that callers can invoke.",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
