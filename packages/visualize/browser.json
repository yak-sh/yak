    "@yaks/draft": "../draft/mod.ts",
    "@yaks/fp": "../fp/mod.ts",
    "@yaks/graph": "../graph/mod.ts",
    "@yaks/match": "../match/mod.ts",
    "@yaks/query": "../query/mod.ts",
    "@yaks/ram": "../ram/mod.ts",
    "@yaks/sql": "../sql/mod.ts",
    "@yaks/sync": "../sync/mod.ts",
    "@yaks/trace": "../trace/mod.ts",
    "@yaks/vocab": "../vocab/mod.ts",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
