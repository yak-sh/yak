{
  "$vocabulary": {
    "https://yak.sh/vocab/core": true
  },
  "title": "inbox front",
  "description": "The inbox views' own state in their page graph, never synced.",
  "$defs": {
    "inboxAction": {
      "component": true,
      "durable": "connection",
      "sync": "server",
      "description": "an action taken on an inbox card",
      "properties": {
        "space": { "type": "string" },
        "kind": { "type": "string" },
        "target": { "type": "string" },
        "answer": { "type": "string" }
      }
    },
    "inboxReceipt": {
      "component": true,
      "durable": "connection",
      "sync": "server",
      "description": "the inbox host's answer to the card action",
      "properties": {
        "label": { "type": "string" }
      }
    },
    "inboxActionNote": {
      "component": true,
      "durable": "connection",
      "sync": "none",
      "description": "an action error shown beside the inbox card",
      "properties": {
        "message": { "type": "string" }
      }
    },
    "inboxView": {
      "component": true,
      "type": "object",
      "sync": "none",
      "durable": "connection",
      "description": "the inbox's expanded threads and search switches; words remain synced drafts",
      "properties": {
        "open": {
          "type": "boolean",
          "description": "the thread is expanded"
        },
        "direction": {
          "type": "string",
          "enum": [
            "both",
            "said",
            "received"
          ]
        },
        "all": {
          "type": "boolean",
          "description": "include archived threads"
        }
      }
    }
  }
}
