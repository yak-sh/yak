{
  "title": "model",
  "$defs": {
    "provider": {
      "type": "object",
      "kind": true,
      "description": "a service that runs models",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    "model": {
      "type": "object",
      "kind": true,
      "description": "a model a provider serves",
      "properties": {
        "name": {
          "type": "string",
          "description": "the name the provider knows it by"
        },
        "provider": {
          "type": "string",
          "ref": "provider",
          "death": "cascade"
        },
        "effort": {
          "type": "string",
          "description": "the reasoning effort asked for unless a session says otherwise"
        }
      }
    },
    "tool": {
      "type": "object",
      "kind": true,
      "description": "something a model may call",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
