{
  "$vocabulary": {
    "https://yaks.sh/vocab/core": true,
    "https://yaks.sh/vocab/id": true,
    "https://yaks.sh/vocab/names": true
  },
  "title": "model",
  "$defs": {
    "provider": {
      "component": true,
      "type": "object",
      "kind": true,
      "prefix": "Y",
      "by_name": true,
      "description": "a service that runs models",
      "properties": {
        "name": {
          "type": "string"
        },
        "transport": {
          "enum": [
            "process",
            "http"
          ]
        },
        "credential": {
          "type": "string"
        },
        "fallback": {
          "type": "boolean"
        },
        "serves": {
          "type": "string",
          "ref": "provider",
          "death": "cascade"
        },
        "offered": {
          "type": "boolean"
        }
      }
    },
    "model": {
      "component": true,
      "type": "object",
      "kind": true,
      "prefix": "O",
      "by_name": true,
      "description": "a model a provider serves",
      "properties": {
        "name": {
          "type": "string",
          "description": "the name the provider knows it by"
        },
        "vendor": {
          "type": "string"
        },
        "grade": {
          "enum": [
            "frontier",
            "mid",
            "small"
          ]
        },
        "provider": {
          "type": "string",
          "ref": "provider",
          "death": "keep",
          "bare": false,
          "description": "which provider serves it — kept when the provider entity is deleted, because every past request names this model, and a model with no provider still records which one served it"
        },
        "label": {
          "type": "string"
        },
        "efforts": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "bare": false,
          "description": "the reasoning effort requested, unless a session overrides it"
        },
        "offered": {
          "type": "boolean"
        }
      }
    },
    "usage": {
      "component": true,
      "type": "object",
      "description": "provider-reported token counts for one completed model request, stored on the entry for that request; not cumulative, and not an estimate of current context size",
      "properties": {
        "input": {
          "type": "number",
          "stamped": true
        },
        "cached": {
          "type": "number",
          "stamped": true
        },
        "output": {
          "type": "number",
          "stamped": true
        },
        "reasoning": {
          "type": "number",
          "stamped": true
        },
        "input_tokens": {
          "type": "integer",
          "description": "input context tokens, including cached tokens"
        },
        "output_tokens": {
          "type": "integer",
          "description": "generated tokens, including reasoning tokens"
        },
        "total_tokens": {
          "type": "integer",
          "description": "total input and output tokens reported by the provider"
        },
        "cached_tokens": {
          "type": "integer",
          "description": "input tokens read from the provider cache; not a guarantee of future cache availability"
        },
        "reasoning_tokens": {
          "type": "integer",
          "description": "reasoning tokens within output tokens"
        }
      }
    },
    "grades": {
      "enum": [
        "frontier",
        "mid",
        "small"
      ]
    },
    "transports": {
      "enum": [
        "process",
        "http"
      ]
    }
  }
}
