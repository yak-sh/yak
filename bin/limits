#!/bin/sh
# Keep the servers answering whatever work runs beside them, by giving them
# the CPU first and capping the memory and disk for everything but them
# (T-133694, T-142053, T-143585):
#
#   bin/limits
#
# Run it once per box, and again to change a number. It needs sudo, and root
# over ssh on the Proxmox host the box runs on (`pve` in ~/.ssh/config).
#
# Any process an agent or cron starts lands in a scope under app.slice or in
# cron.service by default, so a session, its tests, a copy, restore or download
# is weighed and capped without asking for it. The yak-* servers run in
# yak.slice.
#
# The CPU. At equal weights, fifteen sessions running tests (load 23-37 on 4
# cores) kept a server's main thread runnable and off every CPU for 11 s of
# 11.3 s, so heal's reads and the sockets to it timed out. yak.slice weighs ten
# times app.slice, so a server that wants a CPU gets one; the servers use under
# a core, so sessions keep the rest. Each server is its own CPU group, so one
# server's child (a wrangler deploy under yak-web) cannot hold another's main
# thread.
#
# The memory. Two caps, as for the disk below. app.slice's bounds every
# session together, so yak.slice keeps the rest of the box's 24 GB. Each
# session's is lower, so a few fit together and one cannot take the slice: one
# session's 48 type-checking `deno test` runs at once reached 15 GB with 7 GB
# in swap, and yak-mail stalled 42 s for memory with yak.db's write lock held.
# A session is a managed run's process-* scope or a tmux pane's tmux-spawn-*
# scope. A session at its cap gives back page cache, swaps up to 2 GB, and then
# the kernel kills its largest process; OOMPolicy=continue keeps the rest of
# the session, where a scope's default stops it whole. The caps are Max, never
# High: over High the kernel throttles every process in the group, the agent's
# own included, and a runaway sits there frozen instead of failing. They go on
# those two names, not scope.d, since a drop-in overrides a scope's own
# properties and bin/capped's 512M must stand.
#
# The disk. Two caps, because one is not enough. The slice's bounds the sum, and
# so the servers' reads. Each job's is lower, so one job cannot fill the slice:
# at a shared 40 MB/s, an fsync beside a bulk job took 2.5 s and a 10 s test run
# 6 minutes. With two bulk jobs at 30 under a slice at 80, that fsync takes
# 10 ms.
#
# Measured on this box, an LXC volume on LVM thin over a SATA SSD: a cold page read
# from the servers' slice averages 2 ms through a whole copy beside another bulk
# job, worst page 175 ms, against 0.25 ms idle. Uncapped writes took it to
# 5-22 ms, and one uncapped 4 GB write held the servers' main threads 13-16 s:
# the disk takes about 80 MB/s. IO pressure stops being a useful reading here,
# since a job waiting at its cap counts as pressure.
#
# Only a bandwidth limit does this. IOWeight needs BFQ or io.cost, and this box
# has mq-deadline and no access to the host's root cgroup. A limit on `/` catches
# buffered writes too, since ext4 charges writeback to the cgroup that dirtied the
# page. The user manager re-executes to see the io controller; its units and
# processes keep running. The servers move to yak.slice at their next `yak restart`.
#
# The dirty pages, set on the host. A cap holds a job's writeback, not its
# writes, so a job could dirty as much as its memory let it (a session's 6 GB
# let about a gigabyte) and leave it queued at its cap. ext4's journal is
# shared: a capped thread that runs the journal's checkpoint writes metadata as
# the job, behind that queue, and every writer on the disk waits for journal
# space. A bare `sqlite3 .backup` of yak.db held a server's read 11 s that way,
# in __jbd2_log_wait_for_space (T-133694). The host's dirty limit is 256 MB,
# and the kernel gives each cgroup the share of it its memory is of the host's,
# so a session's 6 GB may leave about 60 MB dirty: it waits in write() and its
# queue drains in two seconds at its cap. A server's own share passes its
# 64 MiB checkpoint unpaced. On a scratch ext4 on the host, an fsync's worst
# beside a capped bulk write went from 174 to 30 ms.
#
# Never strict_limit on the volume. It holds each writer to a share of the
# volume's limit sized by how much it wrote lately, so beside a bulk job a
# server, which writes in bursts, has a share near nothing and its main thread
# waits in balance_dirty_pages for the pages it writes: beside a session's bench
# the tracker's waited 32.8 s and yak-work's 10.6 s (T-133091).
#
# The limit is the host's, for every guest on it, since the container cannot
# write sysctls. This also clears the strict_limit an earlier version set on
# the volume. To undo it, delete /etc/sysctl.d/61-yak-dirty.conf on the host and
# set vm.dirty_ratio=20 and vm.dirty_background_ratio=10.
set -eu
all="IOWriteBandwidthMax=/ 80M
IOReadBandwidthMax=/ 150M"
job="IOWriteBandwidthMax=/ 30M
IOReadBandwidthMax=/ 100M"
sessions="MemoryMax=16G"
session="MemoryMax=6G
MemorySwapMax=2G
OOMPolicy=continue"
dirty=$((256 << 20))
host=pve
volume=$(basename "$(findmnt -no SOURCE /)")
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
user="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

sudo mkdir -p /etc/systemd/system/user@.service.d /etc/systemd/system/cron.service.d
printf '[Service]\nDelegate=pids memory cpu io\n' |
  sudo tee /etc/systemd/system/user@.service.d/io.conf >/dev/null
printf '[Service]\n%s\n' "$job" |
  sudo tee /etc/systemd/system/cron.service.d/io.conf >/dev/null
sudo systemctl daemon-reload
systemctl --user daemon-reexec

mkdir -p "$user/app.slice.d" "$user/scope.d" "$user/yak-.service.d"
printf '[Slice]\n%s\n' "$all" >"$user/app.slice.d/io.conf"
printf '[Slice]\n%s\n' "$sessions" >"$user/app.slice.d/memory.conf"
printf '[Scope]\n%s\n' "$job" >"$user/scope.d/io.conf"
for name in process- tmux-spawn-; do
  mkdir -p "$user/$name.scope.d"
  printf '[Scope]\n%s\n' "$session" >"$user/$name.scope.d/memory.conf"
done
printf '[Unit]\nDescription=the yak servers\n\n[Slice]\nCPUWeight=1000\n' >"$user/yak.slice"
printf '[Service]\nSlice=yak.slice\n' >"$user/yak-.service.d/slice.conf"
printf '[Service]\nCPUWeight=100\n' >"$user/yak-.service.d/cpu.conf"
systemctl --user daemon-reload

ssh "$host" sh -s "$volume" "$dirty" <<'EOF'
set -eu
rm -f /etc/udev/rules.d/61-yak-dirty.rules
udevadm control --reload
bdi=/sys/block/$(basename "$(readlink -f "/dev/mapper/$1")")/bdi
echo 0 >"$bdi/strict_limit"
echo 100 >"$bdi/max_ratio"
printf 'vm.dirty_bytes = %s\nvm.dirty_background_bytes = %s\n' "$2" $(($2 / 4)) \
  >/etc/sysctl.d/61-yak-dirty.conf
sysctl -q -p /etc/sysctl.d/61-yak-dirty.conf
EOF
