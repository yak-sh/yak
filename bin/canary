#!/usr/bin/env -S deno run --allow-all
// bin/canary — the delivery canary (T-15154, D-15219). Exercises the fleet's
// delivery loop END TO END against the LIVE server, the way its consumers do,
// and asserts at the consumption end: a letter is not delivered because a
// stamp landed, it is delivered when it appears in a live operator's
// transcript. On any failure it alarms through paths that do not ride the
// loop it watches — a direct Cloudflare email (never the tasks server) and a
// tmux line into the holdco operator — because a delivery system cannot be
// trusted to report its own death (2026-08-07: it broke at 10:41 and only
// the owner noticed, hours later).
//
// Legs, each a named check; all run even when one fails:
//   mail    send a fleet letter to the canary venture → arrival stamps AND
//           the token injected into the canary operator's transcript
//   cast    wake the canary venture → delivered.via names the operator
//           session AND the knock token reaches the transcript (T-15147:
//           a wrong-seat cast stamps a session whose transcript stays empty
//           — the stamp-vs-consumption diff is the detector)
//   reply   answer the run's own letter → the reply's in-graph arrival
//   settle  spawn a fake-provider run → it settles, the completion comment
//           lands, and the comms bus serves it to a claim-holder (the pull
//           loop, where mail/cast test the push loop)
//
// The consumer is a STANDING interactive claude (Haiku) in tmux session
// `canary`, launched `task claude --operator` from the canary venture's cwd
// — relaunched here when dead, so a cold launch (reify, channel bind) is
// itself re-tested. Entities minted by a run are deleted at the end; the
// journal keeps the history, the alarm keeps the evidence.
//
// Cron wires it with the fleet deadman, so the canary's own death alarms:
//   17 * * * * .../bin/canary >> ~/.tasks/canary.log 2>&1 \
//     && holdco-deadman stamp delivery-canary
import { send } from '../src/mailer.ts'

let HOME = Deno.env.get('HOME') ?? '/home/yaks'
let HOST = Deno.env.get('TASKS_HOST') ?? '127.0.0.1:5173'
let DB = Deno.env.get('CANARY_DB') ?? `${HOME}/.tasks/tasks.db`
let CWD = `${HOME}/canary`
let TMUX = Deno.env.get('CANARY_TMUX') ?? 'canary'
let ADDRESS = 'canary@bot.yak.sh'
let OWNER = Deno.env.get('CANARY_ALARM_TO') ?? 'jeff@yak.sh'
let token = `PELICAN-${Date.now().toString(36)}`
let minted: string[] = [] // eids this run created — deleted at the end

// --- plumbing ----------------------------------------------------------------

let log = (line: string) =>
  console.log(`${new Date().toISOString()} ${line}`)

// Read-only SQL against the live db: assertions must not depend on the
// (possibly broken) HTTP surface — the doors under test are the WRITE side.
import { DatabaseSync } from 'node:sqlite'
let db = new DatabaseSync(DB, { readOnly: true })
let one = (q: string, ...args: (string | number)[]) =>
  db.prepare(q).get(...args) as Record<string, string | number | null> | undefined

let sh = async (cmd: string[], opts: { cwd?: string; env?: Record<string, string> } = {}) => {
  let out = await new Deno.Command(cmd[0], {
    args: cmd.slice(1),
    cwd: opts.cwd ?? CWD,
    env: opts.env,
    stdout: 'piped',
    stderr: 'piped',
  }).output()
  let dec = new TextDecoder()
  return {
    ok: out.code == 0,
    out: dec.decode(out.stdout),
    err: dec.decode(out.stderr),
  }
}

let apply = async (changes: unknown[]) => {
  let res = await fetch(`http://${HOST}/apply`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify(changes),
  })
  if (!res.ok) throw new Error(`/apply ${res.status}: ${await res.text()}`)
  return await res.json()
}

let until = async (what: string, ms: number, fn: () => boolean | Promise<boolean>) => {
  let end = Date.now() + ms
  while (Date.now() < end) {
    if (await fn()) return true
    await new Promise((go) => setTimeout(go, 2000))
  }
  log(`timeout: ${what} (${ms}ms)`)
  return false
}

let pane = async () => {
  let r = await sh(['tmux', 'capture-pane', '-p', '-t', TMUX, '-S', '-300'])
  return r.out
}

// --- the canary venture + standing operator, ensured idempotently ------------

let venture = async (): Promise<string> => {
  // The venture dir must exist and BE a git repo before anything else —
  // managed spawns worktree off it, and the operator launches inside it.
  await Deno.mkdir(CWD, { recursive: true }).catch(() => {})
  try {
    await Deno.stat(`${CWD}/.git`)
  } catch {
    await sh(['git', 'init', '-b', 'main', CWD], { cwd: HOME })
    await sh(['git', '-C', CWD, 'commit', '--allow-empty', '-m', 'canary venture root'], { cwd: HOME })
  }
  let row = one(`select eid from email where address = ?`, ADDRESS)
  if (row) return String(row.eid)
  let eid = crypto.randomUUID()
  await apply([
    { eid, name: 'doc', comp: { title: 'Canary', body: 'The delivery canary venture (T-15154): bin/canary sends itself letters, wakes, and spawns here on a cadence and asserts they arrive. Entities under it are probe traffic, deleted after each run.' } },
    { eid, name: 'project', comp: {} },
    { eid, name: 'email', comp: { address: ADDRESS } },
    { eid, name: 'repo', comp: { path: CWD, base_branch: 'main' } },
  ])
  log(`minted canary venture ${eid}`)
  return eid
}

let operator = async (project: string): Promise<{ eid: string; num: number } | null> => {
  // The live operator: an operator-flagged session wearing the venture whose
  // pid is a live claude — the same facts the seat rule reads.
  let live = () => {
    let rows = db.prepare(
      `select s.eid, e.num, s.pid from session s join entity e on e.eid = s.eid
       where s.actor_eid = ? and s.operator = 1 and s.pid is not null
       order by e.num desc`,
    ).all(project) as { eid: string; num: number; pid: number }[]
    for (let r of rows) {
      try {
        if (Deno.readTextFileSync(`/proc/${r.pid}/comm`).trim() == 'claude') return r
      } catch { /* dead pid — keep looking */ }
    }
    return null
  }
  let got = live()
  if (got) return got
  log('no live canary operator — launching one')
  await sh(['tmux', 'kill-session', '-t', TMUX]).catch(() => {})
  await sh([
    'tmux', 'new-session', '-d', '-s', TMUX, '-x', '200', '-y', '50',
    `cd ${CWD} && TASKS_HOST=${HOST} task claude --operator --model haiku`,
  ], { cwd: HOME })
  await until('operator reified', 120_000, async () => {
    // A first launch in a fresh cwd parks at the folder-trust dialog; the
    // canary venture dir is ours, so answer it and move on.
    if (/trust this folder/i.test(await pane())) {
      await sh(['tmux', 'send-keys', '-t', TMUX, 'Enter'], { cwd: HOME })
    }
    return live() != null
  })
  return live()
}

// --- the legs ----------------------------------------------------------------

type Leg = { name: string; ok: boolean; note: string }
let legs: Leg[] = []
let leg = (name: string, ok: boolean, note = '') => {
  legs.push({ name, ok, note })
  log(`${ok ? 'GREEN' : 'RED'} ${name}${note ? ` — ${note}` : ''}`)
}

let mailLeg = async (op: { eid: string }): Promise<string | null> => {
  let r = await sh(['task', 'mail', 'send', ADDRESS, `CANARY ${token}`,
    `--body=Canary run ${token}. This is probe traffic; acknowledge in one short line, take no other action.`])
  if (!r.ok) {
    leg('mail', false, `send failed: ${(r.err || r.out).slice(0, 200)}`)
    return null
  }
  let eid = () => one(
    `select m.eid from mail m join doc d on d.eid = m.eid
     where d.title = ? and m.received_at is not null and m.verified = 1`,
    `CANARY ${token}`,
  )
  let arrived = await until('mail arrival stamps', 30_000, () => !!eid())
  let id = eid() ? String(eid()!.eid) : null
  if (id) minted.push(id)
  if (!arrived) {
    leg('mail', false, 'no verified arrival stamp in 30s')
    return id
  }
  // Consumption: the token in the operator's transcript as a channel event.
  // Generous window — instance churn (~15min cycles) makes short waits
  // false-alarm; a letter that cannot land inside this window IS the defect.
  let injected = false
  await until('mail consumption', 300_000, async () => {
    injected = (await pane()).includes(token)
    if (injected) return true
    let n = id ? one(`select via from notified where eid = ?`, id) : undefined
    return !!n && String(n?.via ?? '') == op.eid
  })
  // On a miss, the notified row is the triage bit: an anonymous stamp means
  // the channel EMITTED and the client never rendered; no stamp means the
  // instance was not connected (the churn class, T-15226). And a stamp whose
  // via IS the operator's own session means the comms bus served the letter
  // into the operator's context (its boot digest wins this race on a fresh
  // launch) — that is consumption too, just not pane-visible.
  let n = id
    ? one(`select "by", via from notified where eid = ?`, id)
    : undefined
  let busServed = !!n && String(n.via ?? '') == op.eid
  let stamp = n ? `notified by=${n.by ?? 'ANON'} via=${n.via ?? 'ANON'}` : 'never notified'
  leg(
    'mail',
    injected || busServed,
    injected
      ? 'arrival + transcript injection'
      : busServed
      ? 'arrival + bus-served into the operator context (no channel push)'
      : `arrived but never injected (${stamp})`,
  )
  return id
}

let castLeg = async (project: string, op: { num: number }) => {
  // The words ride as a comment on the TARGET in the wake's window, so the
  // knock injection carries the token.
  let castToken = `${token}-CAST`
  let c = crypto.randomUUID()
  await apply([
    { eid: c, name: 'doc', comp: { title: '', body: `canary cast ${castToken} — no action needed` } },
    { eid: c, name: 'comment', comp: { target_eid: project } },
  ])
  minted.push(c)
  let pid = 'P-' + String(one(`select num from entity where eid = ?`, project)?.num)
  let r = await sh(['task', 'wake', pid, 'in 2s', pid])
  if (!r.ok) return leg('cast', false, `wake failed: ${(r.err || r.out).slice(0, 200)}`)
  // The wake row fires, mints a knock, and the ladder stamps the outcome.
  let outcome = () => one(
    `select d.via, d.eid from delivered d join knock k on k.eid = d.eid
     join deliver dl on dl.eid = k.eid
     join created c on c.eid = k.eid
     where dl."to" = ? order by c.at desc limit 1`,
    project,
  )
  let stamped = await until('cast outcome', 60_000, () => !!outcome())
  // The run's wake row and its knock are probe traffic too.
  let wakeRow = one(
    `select w.eid from wake w join deliver dl on dl.eid = w.eid
     where dl."to" = ? order by w.rowid desc limit 1`,
    project,
  )
  if (wakeRow) minted.push(String(wakeRow.eid))
  if (!stamped) return leg('cast', false, 'wake fired no knock outcome in 60s')
  minted.push(String(outcome()!.eid))
  let via = String(outcome()!.via)
  if (via != `cast S-${op.num}`) {
    return leg('cast', false, `seat miss: via '${via}', operator is S-${op.num} (T-15147 class)`)
  }
  let heard = await until('cast injection', 300_000, async () =>
    (await pane()).includes(castToken) || (await pane()).includes('knock'))
  leg('cast', heard, heard ? `via ${via} + transcript` : `stamped '${via}' but transcript never heard it (T-7288 class)`)
}

let replyLeg = async (mailEid: string | null) => {
  if (!mailEid) return leg('reply', false, 'no letter to answer (mail leg failed first)')
  let num = one(`select num from entity where eid = ?`, mailEid)?.num
  let r = await sh(['task', 'mail', 'reply', `E-${num}`, `--body=CANARY-REPLY ${token} — probe traffic, no action needed.`])
  if (!r.ok) return leg('reply', false, `reply door failed: ${(r.err || r.out).slice(0, 200)} (the f09b2cc class)`)
  let arrived = await until('reply arrival', 30_000, () =>
    !!one(
      `select m.eid from mail m join doc d on d.eid = m.eid
       where d.body like ? and m.received_at is not null`,
      `%CANARY-REPLY ${token}%`,
    ))
  let row = one(
    `select m.eid from mail m join doc d on d.eid = m.eid where d.body like ?`,
    `%CANARY-REPLY ${token}%`,
  )
  if (row) minted.push(String(row.eid))
  leg('reply', arrived, arrived ? 'reply delivered in-graph' : 'reply sent but never arrived')
}

let settleLeg = async (project: string) => {
  // A throwaway task + a fake-provider spawn: the whole managed lifecycle
  // with no model and no key. The bus half: a claim-holder must be SERVED
  // the completion comment on its next verb (M-15150).
  let t = crypto.randomUUID(), s = crypto.randomUUID()
  await apply([
    { eid: t, name: 'doc', comp: { title: `canary settle ${token}` } },
    { eid: t, name: 'task', comp: { status: 'open', project_eid: project } },
  ])
  minted.push(t)
  await apply([
    { eid: s, name: 'doc', comp: { title: '' } },
    { eid: s, name: 'session', comp: {
      id: `canary-${token}`, provider: 'fake', model: 'fake-fast',
      requested_task_eid: t, cwd: CWD,
    } },
  ])
  minted.push(s)
  let settled = await until('fake spawn settles', 60_000, () =>
    ['completed', 'failed'].includes(String(one(`select status from session where eid = ?`, s)?.status)))
  if (!settled) return leg('settle', false, 'fake spawn never settled in 60s')
  let commented = await until('settle comment', 30_000, () =>
    !!one(`select eid from comment where target_eid = ? or target_eid = ?`, t, s))
  if (!commented) return leg('settle', false, 'settled with no completion comment')
  // The pull loop: claim the task under a canary bus identity, then any verb
  // must serve the unseen comment on stderr (the comms-bus contract).
  let busId = `canary-bus-${token}`
  let snum = one(`select num from entity where eid = ?`, s)?.num
  let tnum = `T-${one(`select num from entity where eid = ?`, t)?.num}`
  let comment = one(
    `select d.body from comment c join doc d on d.eid = c.eid
     where c.target_eid = ? or c.target_eid = ? limit 1`, t, s,
  )
  let marker = String(comment?.body ?? '').split('\n')[0].slice(0, 40)
  // The pull assertion rides the MCP door with an EXPLICIT session — the
  // same identity rule every agent uses; env-only identity is a launcher
  // fallback, not a CLI door.
  await sh(['task', 'claim', tnum, busId])
  let res = await fetch(`http://${HOST}/mcp`, {
    method: 'POST',
    headers: {
      'content-type': 'application/json',
      accept: 'application/json, text/event-stream',
    },
    body: JSON.stringify({
      jsonrpc: '2.0',
      id: 1,
      method: 'tools/call',
      params: { name: 'task_context', arguments: { session: busId } },
    }),
  })
  let served = await res.text()
  let heard = !!marker && served.includes(marker)
  // The spawn's worktree branch is probe traffic in the venture repo.
  if (snum) {
    await sh(['git', '-C', CWD, 'worktree', 'remove', '--force',
      `${HOME}/tasks-worktrees/canary/S-${snum}`], { cwd: HOME })
    await sh(['git', '-C', CWD, 'worktree', 'prune'], { cwd: HOME })
    await sh(['git', '-C', CWD, 'branch', '-D', `session/S-${snum}`], { cwd: HOME })
  }
  leg('settle', heard, heard ? 'settled + comment + bus served it' : `comment landed but the bus never served it (marker '${marker}')`)
}

// --- alarms: never through the loop under test -------------------------------

let alarm = async (subject: string, report: string) => {
  // Direct Cloudflare send — creds from holdco/.env when the caller's env
  // lacks them (cron). Local-only, never logged (M-4524).
  try {
    if (!Deno.env.get('CLOUDFLARE_EMAIL_TOKEN')) {
      let env = await Deno.readTextFile(`${HOME}/code/holdco/.env`)
      for (let line of env.split('\n')) {
        let m = /^(CLOUDFLARE_EMAIL_TOKEN|HOLDCO_CF_ACCOUNT_ID)=["']?([^"'\n]+)["']?$/.exec(line.trim())
        if (m) Deno.env.set(m[1], m[2])
      }
    }
    await send({ from: ADDRESS, to: OWNER, subject, body: report })
    log('alarm: external email sent')
  } catch (e) {
    log(`alarm email FAILED — ${e}`)
  }
  try {
    let line = `[delivery-canary] ${subject} — full report ${HOME}/.tasks/canary.log`
    await sh(['tmux', 'send-keys', '-t', 'holdco:1', line, 'Enter'], { cwd: HOME })
    log('alarm: tmux line sent to holdco')
  } catch (e) {
    log(`alarm tmux FAILED — ${e}`)
  }
}

// --- run ---------------------------------------------------------------------

log(`canary run ${token}`)
try {
  let project = await venture()
  let op = await operator(project)
  if (!op) {
    leg('operator', false, 'no live canary operator and launch failed')
  } else {
    let letter = await mailLeg(op)
    await castLeg(project, op)
    await replyLeg(letter)
    await settleLeg(project)
  }
} catch (e) {
  leg('canary', false, `run crashed: ${String(e).slice(0, 300)}`)
}

// Cleanup: this run's entities go, pass or fail — the journal remembers.
try {
  if (minted.length) {
    await apply(minted.map((eid) => ({ eid, name: 'entity', comp: null })))
    log(`cleaned ${minted.length} entities`)
  }
} catch (e) {
  log(`cleanup failed — ${e}`)
}

// --- state + transition-only alarms ------------------------------------------
// The alarm fires on TRANSITIONS (GREEN→RED, and a recovery note on
// RED→GREEN), never on every red run — a standing failure pages once, not
// hourly. The latch is a LOCAL file on purpose: at the exact moment the
// server is dead the graph can take no write, and a latch that fails open
// re-pages every run. A graph state doc mirrors it best-effort so the fleet
// can query current status; the file remains the transition truth.
let red = legs.filter((l) => !l.ok)
let report = legs.map((l) => `${l.ok ? 'GREEN' : 'RED'} ${l.name}${l.note ? ` — ${l.note}` : ''}`).join('\n')
log(`run ${token} — ${red.length ? 'RED' : 'GREEN'}\n${report}`)

let statePath = `${HOME}/.tasks/canary-state-${HOST.replace(/[:.]/g, '-')}.json`
let prior: Record<string, string> = {}
try {
  prior = JSON.parse(Deno.readTextFileSync(statePath))
} catch { /* first run — absent reads GREEN */ }
let now = Object.fromEntries(legs.map((l) => [l.name, l.ok ? 'GREEN' : 'RED']))
let flipped = legs.filter((l) => (prior[l.name] ?? 'GREEN') != now[l.name])
try {
  Deno.writeTextFileSync(statePath, JSON.stringify(now))
} catch (e) {
  log(`state latch write failed — ${e}`)
}

let mirror = async () => {
  let row = one(`select eid from doc where title = 'Delivery canary state'`)
  let eid = row ? String(row.eid) : crypto.randomUUID()
  let body = [
    `As of ${new Date().toISOString()} (run ${token}, bin/canary):`,
    '',
    ...legs.map((l) => `- **${l.name}**: ${l.ok ? 'GREEN' : 'RED'}${l.note ? ` — ${l.note}` : ''}`),
  ].join('\n')
  await apply([{ eid, name: 'doc', comp: { title: 'Delivery canary state', body } }])
}

if (flipped.length) {
  await mirror().catch((e) => log(`state mirror failed — ${e}`))
  if (red.length) {
    await alarm(
      `DELIVERY CANARY RED — ${red.map((l) => l.name).join(', ')}`,
      `Run ${token}: ${flipped.filter((l) => !l.ok).map((l) => l.name).join(', ')} went RED.\n\n${report}\n\nHost: ${HOST}. Log: ${HOME}/.tasks/canary.log\nThis alarm fires on the transition only; it stays silent while the failure stands.`,
    )
  } else {
    await alarm('delivery canary recovered — all legs GREEN', report)
  }
} else if (red.length) {
  log(`standing RED (${red.map((l) => l.name).join(', ')}) — already alarmed, staying silent`)
}
if (red.length) Deno.exit(1)
