#!/usr/bin/env bash
# Deno keys type-check results by absolute module URL. Every worktree has a
# different URL for identical sources, so share one stable URL for this check.
# Hold the lock through Deno's run: another worktree must not repoint the link
# while this one is reading modules through it. The kernel imports the
# workspace source catalog, and the public client imports the browser draft
# asset: materialize both before Deno discovers modules.
set -euo pipefail
root=$(pwd -P)
cache="${XDG_CACHE_HOME:-$HOME/.cache}/yak"
mkdir -p "$cache"
exec 9>"$cache/check-types.lock"
flock 9
deno run --no-lock -A "$root/bin/compiler-packages.ts"
deno run --no-lock -A "$root/workers/yak/draft-assets.ts"
# The public client imports generated browser modules, including in doc checks.
deno run --no-lock -A "$root/workers/yak/outbox-assets.ts"
ln -s "$root" "$cache/typecheck.next.$$"
mv -Tf "$cache/typecheck.next.$$" "$cache/typecheck"
exec deno check --doc --config "$cache/typecheck/deno.json" "$cache/typecheck"
