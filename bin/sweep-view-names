#!/usr/bin/env -S deno run --allow-net --allow-env
// One-time sweep for T-6631: patch stored card.view values to the role
// vocabulary — the same view renames the registry's alias map heals at
// resolve time, read from the ONE declared table (types.ts renames, `view:`
// namespace) so the sweep can never drift from what resolve() heals.
// Idempotent — a second run finds nothing. Targets TASKS_HOST (default
// 127.0.0.1:5173); delete after the live run.
import { rows, send, snapshot } from '../src/client.ts'
import { viewRenames as renames } from '../src/types.ts'

let all = rows(await snapshot())
let stale = all.filter((r) => renames[String(r.comps.card?.view)])
if (!stale.length) {
  console.log('nothing to sweep')
  Deno.exit(0)
}
await send(stale.map((r) => ({
  eid: r.eid,
  name: 'card',
  comp: { view: renames[String(r.comps.card.view)] },
})))
for (let r of stale) {
  console.log(`${r.eid} ${r.comps.card.view} → ${renames[String(r.comps.card.view)]}`)
}
console.log(`patched ${stale.length} card(s)`)
