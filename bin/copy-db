#!/bin/sh
# Copy a live SQLite database to a scratch file for a rehearsal:
#
#   bin/copy-db .scratch/copy.db [database, default ~/.yak/yak.db]
#
# A copy of the box's graph is over 10 GB. In the checkout's `.scratch/`
# (ignored), it goes with the checkout: the worktree collector
# (packages/git/service.ts) takes the checkout back once its session has ended.
# In /tmp it stays ten days, and two copies there took / below its floor
# (T-147847).
#
# The pages as one read transaction saw them. Without the BEGIN, `.backup`
# starts over each time another process commits, which on the box is several
# times a second.
#
# In a scope with its memory capped (bin/capped). Its pace is the box's disk cap
# (bin/limits), so 10 GB takes about 5 minutes alone, and longer beside other
# bulk work. Run it in the background.
set -eu
[ $# -ge 1 ] || { echo "usage: bin/copy-db .scratch/copy.db [database]" >&2; exit 2; }
mkdir -p -- "$(dirname -- "$1")"
exec "$(dirname -- "$0")/capped" \
  sqlite3 -batch -init /dev/null -readonly "${2:-$HOME/.yak/yak.db}" \
  BEGIN ".output /dev/null" "select count(*) from sqlite_schema" ".backup $1" COMMIT
