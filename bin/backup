#!/bin/sh
# Back up the yak data dir (~/.yak or $YAK_DATA) to R2, keeping the newest
# seven nights there and nothing on the box.
#
# A **night** is one run's prefix in the bucket, snapshots/<UTC time>/:
#   yak.db.zst, tracker.db.zst  each database page for page, as one read
#                               transaction saw it, compressed with zstd
#   files.tar.zst               frozen/, migration/ and roles/
#   counts                      rows per table in each database, uploaded
#                               last: a night without it never completed
# Beside the nights, images/ mirrors the @yaks/blob byte store
# (packages/blob/backend.ts), which a database alone cannot restore. Its file
# names are the hashes of their bytes, so each is uploaded once and never
# changes, and the one mirror serves every night.
#
# Restore into a NEW directory, then point a config's `db` at it:
#   bin/backup restore <dir> [night]
# It takes the newest complete night unless named, decompresses it, copies the
# images, and compares each database's row counts with `counts`. Away from the
# box, export YAK_BACKUP_R2_ACCESS_KEY_ID and YAK_BACKUP_R2_SECRET_ACCESS_KEY
# from 1Password's "yak-graph-backups R2 S3 creds" first; on the box the
# supervisor reads them out of the vault.
#
# Nightly snapshots, not continuous WAL replication (T-95322). Every process
# on the box writes yak.db and checkpoints it: measured 2026-10-07, 4 commits
# and 100 WAL pages a second, 35 GB of WAL a day. Litestream 0.5.17 adds
# its own tables to the database, holds a read transaction on it for good, and
# has an open bug (#1540) in which another process's checkpoint drops
# committed rows from the replica while a restore still passes
# integrity_check. A backup that can be quietly incomplete is worse than one a
# night old.
#
# A page copy inside one read transaction, not VACUUM INTO. VACUUM INTO
# rebuilds every table and index: on the 10 GB graph it had written 3 GB in 11
# minutes, keeping the WAL from resetting the whole time. The same transaction
# runs quick_check, counts the rows and streams every page (sqlite_dbpage)
# into zstd, so the night is exactly the database that passed, and no
# uncompressed copy ever lands on disk: the disk holds one compressed database
# at a time (4.1 GB for the 14.3 GB graph, in 8 minutes from its first read to
# its last page). A page copy also keeps damage where quick_check finds it:
# VACUUM INTO rebuilt a torn freelist into a clean snapshot (T-34578) and hid
# it for two days.
#
# Cron-safe: explicit PATH, no interactivity, and every failure exits nonzero,
# which the supervisor reports to the tracker.
set -eu
set -o pipefail
export PATH="$HOME/.deno/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"

# Bounded, or it is not a backup but an outage: a run that outlives the night
# stacks the next on top of it. So the whole run re-execs under a supervisor
# (bin/backup-run.ts) that kills it at YAK_BACKUP_TIMEOUT, an hour unless set
# (a night took 25 minutes, the first 37 with every image to upload), and
# reports a failure. A restore is a person's, and runs unbounded and
# unreported.
if [ -z "${YAK_BACKUP_BOUND:-}" ]; then
  here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  exec deno run -A --config "$here/../deno.json" "$here/backup-run.ts" "$@"
fi

data="${YAK_DATA:-$HOME/.yak}"
remote="${YAK_BACKUP_REMOTE:-r2:yak-graph-backups}"
keep=7
# KiB the live graph keeps free to grow into, whatever a night writes.
reserve=${YAK_BACKUP_RESERVE:-5242880}
databases="yak.db tracker.db"
files="frozen migration roles"
tab=$(printf '\t')

say() { echo "backup: $*"; }
die() {
  echo "backup: $*" >&2
  exit 1
}
# Plain output regardless of any ~/.sqliterc. A lock is waited out, not
# failed on: the server holds one while it starts.
sq() { sqlite3 -batch -init /dev/null -cmd '.timeout 60000' -noheader -list "$@"; }

# R2 through rclone's S3 backend, defined here and nowhere else: no rclone.conf
# is read. The key pair arrives in the environment (bin/backup-run.ts). A
# remote that is a local path, as tests give, needs no keys. 64 MiB parts send
# a night in about fifty requests rather than the default's six hundred, and
# the tens of thousands of small images go 32 at a time, not the default 4.
export RCLONE_CONFIG=/dev/null RCLONE_TRANSFERS=32 RCLONE_CONFIG_R2_TYPE=s3 \
  RCLONE_CONFIG_R2_PROVIDER=Cloudflare \
  RCLONE_CONFIG_R2_ENDPOINT=https://0f9613dfd3f0451df0bd0f12a1372ea3.r2.cloudflarestorage.com \
  RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true RCLONE_CONFIG_R2_CHUNK_SIZE=64M \
  RCLONE_CONFIG_R2_ACCESS_KEY_ID="${YAK_BACKUP_R2_ACCESS_KEY_ID:-}" \
  RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="${YAK_BACKUP_R2_SECRET_ACCESS_KEY:-}"
case "$remote" in
  r2:*)
    [ -n "$RCLONE_CONFIG_R2_ACCESS_KEY_ID" ] &&
      [ -n "$RCLONE_CONFIG_R2_SECRET_ACCESS_KEY" ] ||
      die "no R2 key pair: neither the vault nor the environment has" \
        "YAK_BACKUP_R2_ACCESS_KEY_ID and YAK_BACKUP_R2_SECRET_ACCESS_KEY"
    ;;
esac

# The nights that completed, oldest first. The names are UTC times, so they
# sort as they happened. Called as `x=$(completed)`, a failed listing fails the
# run: an empty answer must never read as "no nights".
completed() {
  found=$(rclone lsf -R --files-only --include '/*/counts' "$remote/snapshots")
  printf '%s\n' "$found" | sed -n 's#/counts$##p' | sort
}

# The query that writes the query counting database $1's rows per ordinary
# table, as `<database> <table> <rows>` lines. Virtual tables and their
# shadows are left out: the page copy carries them, and the tables they index
# are counted.
counter() {
  echo "select group_concat(
      printf('select %Q, %Q, count(*) from \"%w\"', '$1', name, name),
      ' union all ' order by name)
    from pragma_table_list
    where schema = 'main' and type = 'table' and name not glob 'sqlite_*'"
}
counts() {
  sql=$(sq "$2" "$(counter "$1")")
  sq -separator "$tab" "$2" "$sql"
}

# Database $1 as one read transaction sees it, its pages compressed on
# stdout. The transaction's first read fixes the moment; the same moment is
# checked into $work/$1.check, counted into $work/$1.counts, and measured in
# bytes into $work/$1.bytes. quick_check walks every page's structure: with
# the counts, 5 minutes on the 14.3 GB graph. integrity_check also matches
# every index against its table, and took 26 minutes on 10 GB for nothing a
# backup needs.
pages() {
  w="$work/$1"
  sq -readonly -separator "$tab" "$data/$1" ".output /dev/null" "BEGIN" \
    ".once '$w.sql'" "$(counter "$1")" \
    ".output '$w.check'" "PRAGMA quick_check" \
    ".output '$w.counts'" ".read '$w.sql'" \
    ".output '$w.bytes'" \
    "select page_count * page_size from pragma_page_count, pragma_page_size" \
    ".output /dev/null" \
    "select writefile('/dev/stdout', data) from sqlite_dbpage" \
    "COMMIT" | zstd -q -T0 -c
}

# KiB free in the snapshot directory above the reserve. With none, the run
# is refused.
room() {
  free=$(df -Pk "$dir" | awk 'NR == 2 { print $4 }')
  case "$free" in
    '' | *[!0-9]*) die "cannot measure snapshot space" ;;
  esac
  [ "$free" -gt "$reserve" ] ||
    die "snapshot directory has $free KiB, within the $reserve KiB kept free"
  echo $(( free - reserve ))
}

# What "$@" writes, kept at file $1 in no more than the room there is as it
# starts: a copy that reaches that bound stops there and fails the night,
# rather than take the space the live graph grows into. False when the
# command failed.
kept() {
  file=$1
  shift
  left=$(room) || exit 1
  "$@" | head -c $(( left * 1024 )) > "$file" && return
  [ "$(stat -c %s "$file")" -lt $(( left * 1024 )) ] ||
    die "$file outgrew the $left KiB free above the reserve"
  return 1
}

# A database's night: refused when the copy failed or the database is
# damaged, and proved whole (every page decompresses back) before it counts.
snapshot() {
  z="$work/night/$1.zst"
  copied=yes
  kept "$z" pages "$1" || copied=no
  [ "$(cat "$work/$1.check" 2>/dev/null)" = ok ] ||
    die "$1 failed quick_check: the database is damaged"
  [ "$copied" = yes ] || die "$1: the page copy failed"
  [ "$(zstd -dcq "$z" | wc -c)" -eq "$(cat "$work/$1.bytes")" ] ||
    die "$1: the compressed copy is missing pages"
  cat "$work/$1.counts" >> "$work/counts"
}

restore() {
  [ $# -ge 1 ] || die "usage: bin/backup restore <new dir> [night]"
  into=$1
  nights=$(completed)
  night=${2:-$(printf '%s\n' "$nights" | tail -n 1)}
  printf '%s\n' "$nights" | grep -qxF "$night" ||
    die "no complete night ${2:-at all} in $remote"
  if [ -e "$into" ] && [ -n "$(ls -A "$into")" ]; then
    die "$into is not empty: restore into a new directory"
  fi
  started=$(date +%s)
  say "restoring $night into $into"
  mkdir -p "$into"
  rclone copy "$remote/snapshots/$night" "$into"
  for db in $databases; do zstd -dq --rm "$into/$db.zst"; done
  if [ -f "$into/files.tar.zst" ]; then
    tar -C "$into" --zstd -xf "$into/files.tar.zst"
    rm "$into/files.tar.zst"
  fi
  rclone copy "$remote/images" "$into/images"
  # No quick_check here: zstd held each file to the checksum it took from the
  # snapshot that passed one. The counts are a last look that each database
  # opens and reads as the night did.
  for db in $databases; do counts "$db" "$into/$db"; done > "$into/restored"
  diff "$into/counts" "$into/restored" >&2 ||
    die "row counts differ from the night's"
  rm "$into/counts" "$into/restored"
  say "restored $night in $(( $(date +%s) - started ))s"
}

# Prove the bucket holds each file's bytes, and that zstd can decode them,
# before releasing local space. A later failure leaves no counts marker, so
# none of this night's partial uploads can be mistaken for a recovery point.
uploaded() {
  rclone copy "$work/night" "$remote/snapshots/$night"
  rclone check -q --one-way --download "$work/night" "$remote/snapshots/$night"
  zstd -tq "$work/night"/*.zst
  rm "$work/night"/*.zst
}

backup() {
  started=$(date +%s)
  night=$(date -u +%Y-%m-%dT%H%M%SZ)
  say "start $night"
  [ -f "$data/yak.db" ] || die "no graph in $data"
  # Wait a minute at most: a lock still held past that is a stuck run, and
  # queueing behind it is how runs stacked up before.
  exec 9>"$data/backup.lock"
  flock -w 60 -x 9 || die "another backup holds the lock"

  # The compressed copies go where YAK_BACKUP_SNAPSHOT_DIR says, by default
  # the system's temporary directory, one at a time: each is uploaded and
  # released before the next is taken. None may reach into the reserve.
  dir=${YAK_BACKUP_SNAPSHOT_DIR:-${TMPDIR:-/tmp}}
  case "$dir" in
    /*) ;;
    *) die "snapshot directory must be absolute" ;;
  esac
  [ -d "$dir" ] || die "snapshot directory does not exist: $dir"
  # A run killed past its bound cannot clean up. Reclaim its private
  # directory before measuring space, not after refusing the next run.
  find "$dir" -maxdepth 1 -type d -name 'yak-backup.*' -mmin +120 \
    -exec rm -rf {} + 2>/dev/null || true
  room > /dev/null

  # Every copy belongs to this run's private directory and goes with it.
  work=$(mktemp -d "$dir/yak-backup.XXXXXXXX")
  trap 'rm -rf "$work"' EXIT
  trap 'exit 1' HUP INT QUIT TERM
  mkdir "$work/night"
  say "snapshots in $dir"

  # Keep the query planner's stats fresh (T-16325): PRAGMA optimize updates
  # sqlite_stat1 for tables that drifted as the graph grew. The server runs it
  # at a graceful shutdown; this covers the exits that never reach the drain.
  sq "$data/yak.db" "PRAGMA optimize;"

  for db in $databases; do
    [ -f "$data/$db" ] || die "no $data/$db"
    snapshot "$db"
    uploaded
  done
  set --
  for f in $files; do [ ! -e "$data/$f" ] || set -- "$@" "$f"; done
  if [ $# != 0 ]; then
    kept "$work/night/files.tar.zst" tar -C "$data" --zstd -cf - "$@" ||
      die "files.tar.zst: tar failed"
    uploaded
  fi
  [ ! -d "$data/images" ] ||
    rclone copy --ignore-existing "$data/images" "$remote/images"
  rclone copyto "$work/counts" "$remote/snapshots/$night/counts"

  # Only now, with tonight complete, does an old night go: a run that fails
  # leaves every night before it. Anything not among the newest complete
  # nights goes, including what a failed run left half uploaded.
  nights=$(completed)
  kept=$(printf '%s\n' "$nights" | tail -n "$keep")
  printf '%s\n' "$kept" | grep -qxF "$night" ||
    die "$night is not listed complete; every night is kept"
  all=$(rclone lsf --dirs-only "$remote/snapshots")
  for old in $(printf '%s\n' "$all" | sed 's#/$##'); do
    printf '%s\n' "$kept" | grep -qxF "$old" && continue
    rclone delete "$remote/snapshots/$old"
    rclone rmdirs "$remote/snapshots/$old"
    say "dropped $old"
  done

  n=$(awk -F "$tab" '$1 == "yak.db" && $2 == "entity" { print $3 }' \
    "$work/counts")
  say "$night: ${n:-0} entities, done in $(( $(date +%s) - started ))s"
}

main() {
  case "${1:-}" in
    restore)
      shift
      restore "$@"
      ;;
    '') backup ;;
    *) die "usage: bin/backup [restore <new dir> [night]]" ;;
  esac
}

# One line, read whole before main starts. sh reads a script as it runs, so a
# file edited in place mid-run hands it the rest of a different file; git
# replaces the file and is safe, an editor writing over it is not.
main "$@"; exit
