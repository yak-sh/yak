#!/bin/sh
# Back up the yak data dir (~/.yak or $YAK_DATA) as a git commit.
#
# The data dir IS a git repo: files (frozen/, images, md) commit as
# themselves; the LIVE SQLite db never commits — a commit could catch it
# mid-transaction — so each run snapshots it atomically (VACUUM INTO) and
# then writes that snapshot out as TEXT for history to hold.
#
# Restore into a NEW directory with no database or SQLite sidecars, then
#   cat snap/schema.sql snap/graph.sql.part.* snap/journal.sql.part.* | sqlite3 yak.db
# and start the server. The FTS indexes refill as the rows load — the virtual
# tables and their sync triggers ride along in schema.sql — and @yaks/fts
# adopt()/heal() at boot cuts and rebuilds any index the dump predates;
# embeddings backfill on the embed sweep. That is why neither is dumped.
# The .part.NNN suffixes are zero-padded, so the glob reassembles them in order.
#
# TEXT, not the binary, because git cannot delta a SQLite file: every hourly
# commit stored a near-complete new copy (~167 MB/day, and .git reached 2.5 GB
# in 15 days), while the whole db as text costs ~29 KB per commit — measured,
# two real consecutive snapshots. The same change makes the working files
# smaller than the binary was, since the biggest tables are derived data nobody
# needs to carry: embeddings and the FTS indexes are over half the db, and all
# of them rebuild themselves.
#
# SPLIT across files, and SHARDED into parts, because GitHub's hard 100 MB limit
# is per FILE. The journal is the largest, fastest-growing data and append-only,
# so it gets its own file; and each big dump is split into <50 MB parts
# (schema stays whole). Sharding keeps every byte — the alternative, pruning old
# journal rows, would buy the same headroom by discarding the write history, and
# the journal is mostly MIXED batches that also touch live entities, so pruning it
# by "legacy" removes almost nothing without losing real undo history.
#
# Cron-safe: explicit PATH, no interactivity, exits 0 on "nothing new".
# A missing origin is not an error — that is a deliberate local-history-only
# backup. A push that is REJECTED is, because the off-box copy has stopped
# advancing while the local one keeps moving.
set -eu
export PATH="$HOME/.deno/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"

# BOUNDED, or it is not a backup but an outage. At 3.3 GB one run took over an
# hour, the cron stacked the next on top, the dump and its verify copy filled
# the disk, and the server died under the I/O. So the whole run re-execs itself
# under a hard timeout (15 min; TERM, then KILL 30s later), and every temp file
# it makes belongs to that run. Interrupted SQLite files stay together in
# their private directory; a later run never replaces their main file while
# an old subprocess or recovery journal may still need it.
if [ -z "${YAK_BACKUP_BOUND:-}" ]; then
  YAK_BACKUP_BOUND=1 exec timeout -k 30 "${YAK_BACKUP_TIMEOUT:-900}" "$0" "$@"
fi

data="${YAK_DATA:-$HOME/.yak}"
cd "$data"

[ -d .git ] || { echo "backup: $data is not a git repo (git init it first)" >&2; exit 1; }

started=$(date +%s)
echo "backup: start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
# Redaction holds the same lock through its database scrub and published-
# history report. Otherwise this job could snapshot the old bytes first, wait
# while redaction reports, then commit and push one new leak afterward.
# Wait a minute at most: a lock still held past that is a stuck run, and
# queueing behind it is how runs stacked up before.
exec 9>.git/yak-backup.lock
flock -w 60 -x 9 || { echo "backup: another backup or redaction holds the lock" >&2; exit 1; }

# Never recycle a database pathname: a previous crash may have left a hot
# journal, or a reader may still hold the old inode open. Private paths also
# mean a run that fails to acquire the lock cannot delete another run's DB.
work=$(mktemp -d .git/yak-backup.XXXXXXXX)
snapshot="$work/snapshot.db"
probe="$work/verify.db"
cleanup() {
  rm -rf "$work"
}
trap cleanup EXIT
# The foreground SQLite child may still be unwinding when a signal reaches
# this shell. Preserve its entire directory instead of unlinking open files.
trap 'trap - EXIT; echo "backup: aborted; retained $work" >&2; exit 124' HUP INT QUIT TERM
mkdir -p snap

# Plain output regardless of any ~/.sqliterc (box modes break the checks).
sq() { sqlite3 -batch -init /dev/null -noheader -list "$@"; }

# Catch structural corruption on the LIVE db, which the snapshot check below
# cannot. VACUUM INTO rebuilds the database from its logical rows, so a torn
# write in the freelist or page map (a power-loss "2nd reference to page" /
# "Freelist size" fault, T-34578) is LAUNDERED into a clean snapshot that passes
# integrity_check — which is why the 2026-09-05 corruption stayed hidden through
# the daily backup until a page-allocating write hit it two days later. Once the
# fault turns fatal VACUUM errors and set -e catches it, but the latent window is
# invisible. quick_check walks the page structure directly (it skips only
# index-vs-table content) and is fast enough for the bound. A non-zero exit here
# withholds the deadman stamp, so the fleet is paged the next morning, not days
# later. Run it before PRAGMA optimize, which is the first write to the live db.
sq yak.db "PRAGMA quick_check;" | grep -qx ok || {
  echo "backup: LIVE db failed quick_check — structural corruption on yak.db" >&2
  exit 1
}

# The snapshot is still taken atomically and still checked — it is just no
# longer what history stores. It lives outside the repo (.gitignore) as the
# consistent point-in-time source the text dump is written from, so the dump
# can never catch the live db mid-transaction either.
# Keep the query planner's stats fresh (T-16325): PRAGMA optimize updates
# sqlite_stat1 for tables that drifted as the graph grew, so plans don't rot
# with size. Safe on live data — it only rewrites the stat table. The
# long-lived server connection runs this at graceful shutdown too; this hourly
# run covers ungraceful exits (crash/kill) that never reach the drain.
sq yak.db "PRAGMA optimize;"

sq yak.db "VACUUM INTO '$snapshot'"
sq "$snapshot" "pragma integrity_check;" | grep -qx ok || {
  echo "backup: snapshot failed integrity_check" >&2
  exit 1
}

# Derived tables carry no information the graph cannot rebuild, so their rows
# never enter the dump — and WHICH tables those are is read out of the
# snapshot's own SCHEMA, never from a list of names. A name list only knows the
# indexes that existed the last time someone edited it: @yaks/fts took over
# search and cut a new mail_fts (5db8be2b), this script went on dumping it, and
# the restore proof failed every night from 2026-09-11.
#
# An FTS5 index announces itself — `using fts5` in its own CREATE — and owns
# five shadow tables named after it. Its words refill from its three sync
# triggers as the rows of the table it mirrors load, so index and shadows are
# both skipped here while the virtual table and the triggers stay in the schema
# below. The vectors are the other half: `embedding` and `embedding_index` are
# @yaks/embedding's two tables (TABLE and MARK, packages/embedding/ddl.ts) and
# refill on the embed sweep; `vector0_*` and `_sqliteai_vector` are the ANN
# backend's own namespace, recut by vector_init at boot.
#
# Every index here is EXTERNAL-CONTENT (`content=` in its CREATE): it is an
# inverted index over words some other table keeps, which is what makes its
# rows derived. One without that clause would hold the only copy of its text,
# and skipping it would drop that text out of the backup — refuse loudly rather
# than lose it quietly.
own=$(sq "$snapshot" "select group_concat(name, ' ') from sqlite_master
  where type = 'table' and lower(sql) like '%using fts5%'
    and sql not like '%content=%'")
[ -z "$own" ] || {
  echo "backup: fts5 index holds its own text, not derived: $own" >&2
  exit 1
}
# A never-matching first element keeps both lists valid when there is no index.
indexes="''"
shadows="''"
for t in $(sq "$snapshot" "select name from sqlite_master
    where type = 'table' and lower(sql) like '%using fts5%' order by name"); do
  indexes="$indexes, '$t'"
  for s in _data _idx _docsize _config _content; do
    shadows="$shadows, '$t$s'"
  done
done
derived="name in ($indexes) or name in ($shadows)
  or name in ('embedding', 'embedding_index')
  or name glob 'vector0_*' or name = '_sqliteai_vector'"

# Data as INSERT statements, no DDL — `.mode insert` names each table, so the
# files concatenate onto the schema in any order.
#
# WRAPPED IN ONE TRANSACTION, which is not a nicety. Bare INSERTs are each
# their own transaction, so replaying them fsyncs once PER ROW: ~28k fsyncs to
# load this graph. On a real disk that is over an hour; the hourly job hung in
# uninterruptible I/O and cron would have stacked a new one on top every hour.
# It is invisible on tmpfs — where fsync is free — which is exactly how a probe
# written to /tmp measured 8s for work that takes an hour where it actually
# runs. Two transactions instead of 28k applies to the RESTORE too, which is
# the path that matters most and the one nobody times until they need it.
# Each file wraps itself, so any subset still concatenates and replays.
dump_data() {
  echo 'BEGIN TRANSACTION;'
  for t in $(sq "$snapshot" "select name from sqlite_master
      where type = 'table' and name not like 'sqlite_%' and not ($derived)
        and ($1) order by name"); do
    sqlite3 -batch -init /dev/null "$snapshot" \
      ".mode insert \"$t\"" "select * from \"$t\";"
  done
  echo 'COMMIT;'
}

# The schema, minus the FTS SHADOW TABLES only. `.schema` writes those out as
# ordinary CREATE TABLEs, but creating the virtual table makes them itself, and
# only one of the two definitions can stand. VACUUM decides which: it re-emits
# the shadows BEFORE the virtual table they belong to, so the plain CREATEs win
# the race and `create virtual table mail_fts` then fails with 'table
# mail_fts_data already exists' — leaving every INSERT behind it with no such
# table. Drop the shadows and the virtual table makes its own.
# The filter is on TYPE as well as name so the sync triggers survive: they are
# named after the index (mail_fts_insert/_delete/_update) and they are the very
# things that refill it as the rows load — as is the `<comp>_text` view an
# index whose columns are addresses reads its words back through.
# glob, not like, for the two namespaces below: `_` is a wildcard in LIKE.
# sqlite_stat1/sqlite_stat4 are the ANALYZE tables PRAGMA optimize (above)
# materializes — same kind as the FTS/vector shadows: derived, and rebuilt by
# ANALYZE, so they carry no information to keep. They MUST be dropped from the
# dump because they are reserved names sqlite refuses on load ('object name
# reserved for internal use'), which fails the round-trip gate below. Targeted
# glob 'sqlite_stat*', not a blanket 'sqlite_%': sqlite_autoindex_* already
# fall out on `sql is not null`, and were AUTOINCREMENT ever added its
# sqlite_sequence counters would matter for restore — leave that door shut.
sqlite3 -batch -init /dev/null "$snapshot" \
  "select sql || ';' from sqlite_master
   where sql is not null and not (type = 'table'
     and (name in ($shadows)
       or name glob 'vector0_*' or name = '_sqliteai_vector'
       or name glob 'sqlite_stat*'))
   order by rowid" > "$work/schema.sql"
journal="name in ('journal_tx', 'journal_change', 'journal_field')"
dump_data "$journal" > "$work/journal.sql"
dump_data "not ($journal)" > "$work/graph.sql"

# SHARD the big dumps into parts under GitHub's 100 MB hard limit (target <50 MB
# to clear the soft warning too); zero-padded numeric suffixes glob in order and
# the restore cats them back before sqlite parses them. schema stays whole.
#
# Cut on LINE boundaries (-C: as many whole lines as fit), not bytes. One
# inserted row shifts every byte after it, so a byte split changed EVERY later
# part on every run and git stored each as a new blob — that, hourly, is how
# the data repo grew by a gigabyte a day and filled the disk. With whole rows
# per part, a run that touches a few rows changes a few parts and the rest
# dedupe to the blobs history already holds.
split -C 45M -d -a 3 "$work/graph.sql"   "$work/graph.sql.part."
split -C 45M -d -a 3 "$work/journal.sql" "$work/journal.sql.part."

# The gate: the dump must restore to the same graph it came from — and it must do
# so FROM THE SHARDS, so a bad split is caught here, not at restore. Comparing row
# counts per table catches a truncated write, a quoting bug, a table silently
# dropped from the dump, and a shard that failed to reassemble — the failures that
# would otherwise be found at restore time, the one moment there is no second chance.
cat "$work/schema.sql" "$work"/graph.sql.part.* "$work"/journal.sql.part.* |
  sqlite3 -batch -init /dev/null "$probe" || {
  echo "backup: dump did not load back" >&2
  exit 1
}
for t in $(sq "$snapshot" "select name from sqlite_master
    where type = 'table' and name not like 'sqlite_%' and not ($derived)
    order by name"); do
  a=$(sq "$snapshot" "select count(*) from \"$t\"")
  b=$(sq "$probe" "select count(*) from \"$t\"")
  [ "$a" = "$b" ] || {
    echo "backup: round-trip lost rows in $t ($a → $b)" >&2
    exit 1
  }
done
# schema whole; graph/journal live only as parts now — drop any monolithic files a
# previous (pre-shard) run left tracked, so `git add -A` records the switch.
rm -f snap/graph.sql.part.* snap/journal.sql.part.*
mv "$work/schema.sql" snap/schema.sql
mv "$work"/graph.sql.part.* "$work"/journal.sql.part.* snap/
rm -f snap/graph.sql snap/journal.sql

git add -A

# Size guard, by BYTES not by name (T-20007). GitHub hard-rejects any file over
# 100 MiB, and the T-19375 push failed a second time on ~800MB stray db copies
# whose names .gitignore never anticipated — a name-based ignore can only stop
# the large files we already named. So refuse here, before the commit, if any
# staged blob exceeds the limit: catch it as a loud failed backup the deadman
# sees, not as a push rejected off-box after a broken commit already landed.
# cat-file -s reads the staged blob's own size, so deletions and working-tree
# churn can't confuse the measure.
limit=104857600 # 100 MiB — GitHub's hard per-file limit
over=$(git diff --cached --raw --diff-filter=ACM | while read -r _ _ _ sha _ path; do
  size=$(git cat-file -s "$sha") || continue
  if [ "$size" -gt "$limit" ]; then printf '  %s (%s bytes)\n' "$path" "$size"; fi
done)
if [ -n "$over" ]; then
  echo "backup: staged file(s) exceed GitHub's 100 MiB limit — refusing to commit:" >&2
  echo "$over" >&2
  exit 1
fi

# Nothing to commit is only healthy if everything already committed got out.
# Otherwise a quiet run launders the failure of a noisy one: an earlier push
# was rejected, this run finds no change, exits 0, and the deadman stamps the
# backup healthy while the off-box copy sits frozen.
unpushed() {
  b=$(git rev-parse --abbrev-ref HEAD)
  git rev-parse --verify -q "origin/$b" >/dev/null || return 1  # never fetched — cannot tell
  [ "$(git rev-list --count "origin/$b..HEAD")" != 0 ]
}
if git diff --cached --quiet; then
  echo "backup: nothing new"
  if git remote get-url origin >/dev/null 2>&1 && unpushed; then
    echo "backup: nothing new, but local commits are unpushed — off-box copy is stale" >&2
    exit 1
  fi
  exit 0
fi

n=$(sq "$snapshot" 'select count(*) from entity')
git -c user.name=backup -c user.email=backup@yak.sh \
  commit -qm "backup: $(date -u +%Y-%m-%dT%H:%M:%SZ) — $n entities"

pushed=1
if git remote get-url origin >/dev/null 2>&1; then
  git push -q origin HEAD || pushed=0
fi
echo "backup: committed $n entities"

# No `git gc` here. A backup is snapshot, dump, restore-proof, commit, push —
# packing is repo maintenance, and on this history (5+ GB) a full gc runs past
# any sane backup timeout: measured, the commit and push finished in under 3
# minutes and gc then ran 12 more before the 15-minute bound killed it. Pack
# from the separate weekly cron line (`git -C ~/.yak gc`), never in-line.
# A gc killed mid-pack leaves a tmp_pack_* the size of the repo that git never
# reclaims on its own; drop any older than two hours (a live gc is younger).
find .git/objects/pack -name 'tmp_pack_*' -mmin +120 -delete 2>/dev/null || true

# The commit landed, so say so above — but a rejected push means the only
# off-box copy has stopped advancing, which is the failure this backup exists
# to prevent. The fleet deadman gates its stamp on this exit code, so
# returning 0 here would certify the backup healthy for as long as the push
# keeps failing. That is the shape that hid an 18h outage; do not repeat it.
if [ "$pushed" = 0 ]; then
  echo "backup: push REJECTED — off-box copy is now stale" >&2
  exit 1
fi
echo "backup: done in $(( $(date +%s) - started ))s"
