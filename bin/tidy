#!/bin/sh
# Tidy the box: collect worktrees that can lose nothing. Cron runs it every
# 15 minutes (T-40652, T-40654); each thing removed is one line on stdout,
# anything that went wrong is on stderr.
#
# A linked worktree of the repository, wherever it was made (.claude/worktrees,
# @yaks/spawn's ~/.yak/worktrees, a scratch directory), is collected only when
# all hold:
# - it is not locked (Claude Code locks an agent's worktree while it runs);
# - Git has not written its HEAD, index or HEAD reflog for 3 hours;
# - no process of ours has its directory, a file inside it, or its path on
#   the command line;
# - it has no changes and no untracked files;
# - nothing in it is unlanded: HEAD is on main, or every commit main lacks
#   has its patch on main already (`git cherry`, which sees a rebase or a
#   cherry-pick).
# Then `git worktree remove` (which re-checks for changes itself) and
# `git branch -D` on its branch, whose commits were just found on main. A
# worktree whose agent comes back can be recreated (@yaks/git restores the
# ones it manages); a lost commit cannot, so every doubt keeps it.
#
# YAK_TIDY_REPO points it elsewhere; tests keep off the live box.
#
# No `set -e`: one thing that fails to go must not stop the rest. Each step
# checks what it needs, and any doubt keeps the thing.
set -u
export PATH="/usr/local/bin:/usr/bin:/bin"

# Bounded and in the background: a run that hangs must not stack under the
# next one, and a run must never be why the box is slow.
if [ -z "${YAK_TIDY_BOUND:-}" ]; then
  YAK_TIDY_BOUND=1 exec timeout -k 30 "${YAK_TIDY_TIMEOUT:-600}" \
    nice -n 19 ionice -c3 "$0" "$@"
fi

common=$(git -C "$(dirname "$0")" rev-parse --path-format=absolute \
  --git-common-dir) || exit 1
repo=${YAK_TIDY_REPO:-$(dirname "$common")}
idle=10800
now=$(date +%s)

exec 9>"$repo/.git/yak-tidy.lock"
flock -n 9 || exit 0

say() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) tidy: $*"; }

# Whether path $1 is unmodified for $2 seconds; a path that is gone is not.
old() { m=$(stat -c %Y -- "$1" 2>/dev/null) && [ $((now - m)) -ge "$2" ]; }

# An extended regex matching a command line that names $1 as a whole path.
names() {
  re=$(printf '%s' "$1" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
  printf '(^|[ ="'\''])%s(/|[ "'\'']|$)' "$re"
}

# The linked worktrees that are neither locked nor missing, as
# "path<TAB>branch" (an empty branch is a detached HEAD). The first one Git
# lists is the primary checkout, which is never a candidate.
worktrees() {
  git -C "$repo" worktree list --porcelain | awk '
    function out() {
      if (n++ && path != "" && !held) print path "\t" branch
      path = ""
    }
    /^worktree / { out(); path = substr($0, 10); branch = ""; held = 0 }
    /^branch refs\/heads\// { branch = substr($0, 19) }
    /^(locked|prunable)/ { held = 1 }
    END { out() }'
}

# Whether Git has left worktree $1 alone for $idle seconds: its HEAD, index
# and HEAD reflog, which a commit, checkout, rebase or add rewrites. They are
# read before any git command that could refresh them, and status never
# writes the index (--no-optional-locks), so looking does not make it busy.
untouched() {
  dir=$(git -C "$1" rev-parse --path-format=absolute --git-dir) || return 1
  for f in HEAD index logs/HEAD; do
    [ ! -e "$dir/$f" ] || old "$dir/$f" "$idle" || return 1
  done
}

# Every working directory and open file of our processes, one per line, and
# every process's command line: each read once for the whole pass, in one
# process, where a readlink per process and a pgrep per worktree took a
# fifth of a second on a busy box. A command list that could not be read
# keeps every worktree.
opened=$(find /proc/[0-9]*/cwd /proc/[0-9]*/fd -maxdepth 1 -type l \
  -user "$(id -u)" -printf '%l\n' 2>/dev/null)
commands=$(ps -e -ww -o args=) && listed=1 || listed=

# Whether a process of ours works in $1, holds a file inside it open, or
# any process names it on its command line.
used() {
  printf '%s\n' "$opened" | awk -v p="$1" '
    $0 == p || index($0, p "/") == 1 { found = 1; exit }
    END { exit !found }' && return
  [ -z "$listed" ] || printf '%s\n' "$commands" | grep -Eq -- "$(names "$1")"
}

# Whether everything committed in worktree $1 is on main: HEAD is, or each
# commit main lacks has an equal patch there.
landed() {
  git -C "$1" merge-base --is-ancestor HEAD main 2>/dev/null && return
  ahead=$(git -C "$1" cherry main HEAD) || return 1
  ! printf '%s\n' "$ahead" | grep -q '^+'
}

collect() {
  untouched "$1" && ! used "$1" || return 0
  changed=$(git -C "$1" --no-optional-locks status --porcelain \
    --untracked-files=normal) && [ -z "$changed" ] || return 0
  landed "$1" || return 0
  head=$(git -C "$1" rev-parse --short HEAD)
  git -C "$repo" worktree remove "$1" || return 0
  say "removed worktree $1 (${2:-detached HEAD} at $head)"
  [ -z "$2" ] || git -C "$repo" branch -q -D "$2"
}

tab=$(printf '\t')
worktrees | while IFS=$tab read -r path branch; do
  collect "$path" "$branch"
done
