#!/bin/sh
# bin/build-yak — Cloudflare Workers Builds prepares dependencies and deploys
# the kernel Worker (T-34165), and its sibling Workers ahead of it
# (workers/yak/wrangler.ts `siblings`). The dashboard's deploy command calls
# `../../bin/build-yak deploy`; its build command is
# `../../bin/build-yak install`. Install mode prepares Deno, pnpm and the
# workspace's node_modules before Builds saves its cache, ahead of deploy. With no
# argument, this runs the check and the workers tests by hand.
#
# Workers Builds is the whole deploy: the Cloudflare GitHub App watches
# yak-sh/yak, and on a push to main it clones, runs install mode, then runs
# this file's deploy mode with a token it mints for itself — nothing is minted by
# hand and no secret lives in the repo or on the Actions runner. A non-zero
# exit in install mode would deploy nothing. Deploy mode preserves a successful
# production deploy if staging fails, and exits nonzero so Builds reports it.
# The dashboard settings are written down in
# workers/yak/README.md.
#
# What a push's Workers Build does: clone, install stale pnpm deps, save cache,
# pre-flight (wrangler.ts `superseded`), yak-out, esbuild, then upload.
# No check, no tests. The build runs with the ROOT DIRECTORY set to
# workers/yak, so nothing here may assume a working directory — every path is
# derived from this file's own location. bin/build-tools readies Deno, pnpm and
# node_modules.
#
# The no-argument checks omit the workerd tests (they boot the kernel and
# reach the Stripe sandbox, and are the Actions runner's job,
# .github/workflows/gate.yml) and bin/verify-deploy (Builds runs the build before
# the deploy, so there is nothing yet to verify — see the README).
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"

. bin/build-tools

case "${1:-}" in
  install|deploy)
    mode=$1
    shift
    [ "$mode" = install ] && exit 0
    deno task deploy:yak "$@"
    # Builds pins these to its connected production Worker. Leaving them set
    # can override staging's name or reject its distinct script tag.
    unset WRANGLER_CI_OVERRIDE_NAME WRANGLER_CI_MATCH_TAG
    exec deno task deploy:yak-staging "$@"
    ;;
  '') ;;
  *) echo "usage: bin/build-yak [install|deploy]" >&2; exit 2 ;;
esac

# Verbose: a build's log is read whole.
echo "--- deno task check"
deno task check --verbose

echo "--- deno task test --all --tag=deno workers"
deno task test --all --tag=deno --verbose workers

echo "--- build ok; Workers Builds deploys from here"
