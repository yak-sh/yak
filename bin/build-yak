#!/bin/sh
# bin/build-yak — the gate, run by Cloudflare Workers Builds before it deploys
# the kernel Worker (T-34165). The dashboard's build and deploy commands call
# this file (`../../bin/build-yak` and `../../bin/build-yak deploy`);
# what that line MEANS lives here, in the repo, where it is reviewed and
# versioned like everything else.
#
# Workers Builds is the whole deploy: the Cloudflare GitHub App watches
# yak-sh/yak, and on a push to main it clones, runs this, then runs
# this file's deploy mode with a token it mints for itself — nothing is minted by
# hand and no secret lives in the repo or on the Actions runner. A non-zero
# exit in build mode deploys nothing. Deploy mode preserves a successful
# production deploy if staging fails, and exits nonzero so Builds reports it.
# The dashboard settings are written down in
# workers/yak/README.md.
#
# The image is Ubuntu 24.04 with node and npm; Deno is NOT on it, so the first
# thing this does is fetch one. The build runs with the ROOT DIRECTORY set to
# workers/yak, so nothing here may assume a working directory — every path is
# derived from this file's own location.
#
# What it does not do: `deno task test` (the fast tier boots probe servers and
# is the Actions runner's job, .github/workflows/gate.yml) and bin/verify-deploy
# (Builds runs the build BEFORE the deploy, so there is nothing yet to verify —
# see the README).
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

# Workers Builds restores npm's cache, but not Deno's default directories.
# Keep Deno's executable and module cache beside the cached npm packages so
# both build and deploy reuse them. Enable Build cache in the dashboard.
cache=$(npm config get cache)
DENO_INSTALL=${DENO_INSTALL:-"$cache/deno-install"}
DENO_DIR=${DENO_DIR:-"$cache/deno"}
export DENO_INSTALL DENO_DIR

if ! command -v deno >/dev/null 2>&1; then
  # -y answers the prompts; --no-modify-path keeps it out of the image's shell
  # rc files, which nothing in a build container ever sources anyway. The PATH
  # this build needs is the line below, not a login shell's.
  if [ ! -x "$DENO_INSTALL/bin/deno" ]; then
    echo "--- installing deno (not on the Workers Builds image)"
    curl -fsSL https://deno.land/install.sh | sh -s -- -y --no-modify-path
  fi
  PATH="$DENO_INSTALL/bin:$PATH"
  export PATH
fi
deno --version

cd "$root"

case "${1:-}" in
  deploy)
    shift
    deno task deploy:yak "$@"
    # Builds pins these to its connected production Worker. Leaving them set
    # can override staging's name or reject its distinct script tag.
    unset WRANGLER_CI_OVERRIDE_NAME WRANGLER_CI_MATCH_TAG
    exec deno task deploy:yak-staging "$@"
    ;;
  '') ;;
  *) echo "usage: bin/build-yak [deploy]" >&2; exit 2 ;;
esac

echo "--- deno task check"
deno task check

echo "--- deno task test:workers"
deno task test:workers

echo "--- build ok; Workers Builds deploys from here"
