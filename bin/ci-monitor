#!/bin/sh
# Report a red CI run on main to the tracker (bench/ci.ts). Cron runs it from
# the main checkout:
#
#   */10 * * * *  bin/ci-monitor >> ~/.tasks-ci.log 2>&1
set -u
export PATH="$HOME/.deno/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
cd "$(dirname "$0")/.." || exit 1
exec timeout -k 10 300 deno run -A bench/ci.ts "$@"
