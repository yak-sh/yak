#!/bin/sh
# Run the box's bench suites on their own and report a slower one to the
# tracker (bench/monitor.ts). Cron runs it from the main checkout:
#
#   23 2 * * *    bin/bench-monitor              every suite, once a day
#   */30 * * * *  bin/bench-monitor --hourly     user-facing waits
#   */15 * * * *  bin/bench-monitor --restarted  pages, once after a restart
#
# each appending to ~/.tasks-bench.log, beside backup's and tidy's logs.
#
# Bounded: a run that hangs must not stack under the next one. A night when
# several suites need confirming takes hours: the throughput suite alone is
# about 17 minutes a run, once to screen and three times to confirm. Not niced:
# a measurement taken at low priority measures the box's other work.
set -u
export PATH="$HOME/.deno/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
# Each lane owns its lock and child. A long throughput check cannot postpone
# the fast lane: a busy box-wide lock defers its check without queueing.
# Cron never stacks another copy of a lane.
if [ "${1:-}" = "--hourly" ]; then
  self="$(realpath "$0")"
  cd "$(dirname "$self")/.." || exit 1
  # The wait suites share the box: measuring them together makes their own
  # fixture work look like a regression. All suites share the box-wide lock.
  mkdir -p "$HOME/.cache/yak/bench"
  exec 9>"$HOME/.cache/yak/bench/monitor-hourly.lock"
  flock -n 9 || exit 0
  for suite in $(deno eval 'import { HOURLY } from "./bench/monitor.ts"; console.log(HOURLY.join(" "))'); do
    "$self" "$suite"
  done
  exit
fi
if [ "$#" -eq 0 ]; then
  self="$(realpath "$0")"
  cd "$(dirname "$self")/.." || exit 1
  # Each suite shares its scheduled lock with the fast lane, not a queue behind
  # throughput. Ignore a held lock: that suite is already being measured.
  for suite in $(deno eval 'import { SUITES } from "./bench/monitor.ts"; console.log(SUITES.join(" "))'); do
    "$self" "$suite"
  done
  exit
fi
export PATH="$HOME/.deno/bin:/home/linuxbrew/.linuxbrew/bin:/usr/local/bin:/usr/bin:/bin"
# systemctl --user, which `--restarted` asks for the live web unit, needs the
# user manager's address, which cron does not give.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
cd "$(dirname "$0")/.." || exit 1
mkdir -p "$HOME/.cache/yak/bench"
lane="${1:-daily}"
exec flock -n "$HOME/.cache/yak/bench/monitor-$lane.lock" timeout -k 30 "${YAK_BENCH_TIMEOUT:-14400}" \
  deno run -A bench/monitor.ts "$@"
