#!/bin/sh
# One-off (T-136648, T-133424): a process is an instrument, never an actor, so
# a stamp that names a process row in `by` loses its `by`, keeping the process
# (or the session it came through) in `via`. Every component whose `by` the
# store's vocabulary declares stamped, beside a `via`, is repaired, in
# batches so the live writers wait no longer than one batch. A second run changes nothing.
#
#   bin/repair-process-actors [database, default ~/.yak/yak.db]
#
# Deleted in the commit after its live run.
set -eu
db=${1:-$HOME/.yak/yak.db}
q() { sqlite3 -batch -list -init /dev/null -cmd '.timeout 30000' "$db" "$@"; }
total=0
for t in $(q "select distinct c.name from _prop p join _comp c on c.entity = p.comp
  where p.name = 'by' and p.stamped = 1
  and exists (select 1 from pragma_table_info(c.name) where name = 'via')
  order by 1"); do
  n=0
  while :; do
    k=$(q "update \"$t\" set via = coalesce(via, by), by = null where rowid in (
      select x.rowid from \"$t\" x where x.by in (select entity from process)
      limit 20000); select changes();")
    [ "$k" = 0 ] && break
    n=$((n + k))
  done
  [ "$n" = 0 ] || echo "$t $n"
  total=$((total + n))
done
echo "total $total"
