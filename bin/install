#!/bin/sh
# Put `yak` on PATH, with `task` as its other name, and turn on the repository's
# git hooks.
#
# `yak` is a shim that runs the main checkout's CLI against that
# checkout's own deno.json and deno.lock, read each time it starts, quietly:
# Deno's own lines as it fetches a first command's modules are hundreds, and
# say nothing to whoever ran it; its errors print all the same. Nothing is
# copied: `deno install -g` froze the import map at install time, so a landing
# that moved or deleted a package's export broke every `yak` command until
# someone reinstalled.
#
# Every yak process opens the SQLite the repository's tests open (bin/sqlite.ts,
# built here when absent), not the one the machine's package manager last
# installed, which moves with every `brew upgrade`. Moving the pin means running
# this again.
set -eu
root=$(git worktree list --porcelain | head -1 | cut -c 10-)
bin="${DENO_INSTALL_ROOT:-$HOME/.deno}/bin"
git -C "$root" config core.hooksPath .githooks
"$root/bin/workspace-dependencies"
sqlite=$(deno run -A "$root/bin/sqlite.ts")
mkdir -p "$bin"
# The copied config a `deno install -g` of this CLI left behind.
rm -rf "$bin/.yak"
# A command checks node_modules against the lockfile only when the lockfile is
# newer than pnpm's record of its last install, which the check moves forward
# when they agree: otherwise every command would start a second Deno first.
cat >"$bin/yak" <<EOF
#!/bin/sh
export DENO_SQLITE_PATH="\${DENO_SQLITE_PATH:-$sqlite}"
[ '$root/node_modules/.pnpm/lock.yaml' -nt '$root/pnpm-lock.yaml' ] ||
  deno run -q -A --config '$root/deno.json' '$root/bin/workspace-dependencies.ts' || exit \$?
exec deno run -q -A --unstable-no-legacy-abort --config '$root/deno.json' '$root/packages/cli/yak.ts' "\$@"
EOF
chmod +x "$bin/yak"
# TODO: drop --unstable-no-legacy-abort once Deno honors deno.json's (2.9.1 does not)
ln -sf yak "$bin/task"
echo "yak is at $bin/yak, running $root"
case ":$PATH:" in
*":$bin:"*) ;;
*) echo "put it on your PATH: echo 'export PATH=\"$bin:\$PATH\"' >> ~/.zshrc, then open a new terminal" ;;
esac
[ -e "${YAK_CONFIG:-$HOME/.yak/yak.json}" ] || echo 'next: yak init'
