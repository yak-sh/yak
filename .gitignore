# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# npm droppings — the kernel Worker's are the only ones, and they are installed
# on demand (workers/yak/wrangler.ts); the .lock is that install's mutex.
node_modules
node_modules.lock/

# wrangler dev's bundle scratch beside a Worker's config (workers/*)
.wrangler/

# agent worktrees parked inside the repo
.claude/worktrees/
.worktrees/

# Operator scratch — wake-brief note-to-self (re-injected post-clear), not a tracked artifact
.operate/

# Agents' scratch notes and mockups. A long-lived `yak` command pins the
# checkout's untracked files beside its source (packages/cli/runtime.ts), so
# what sits here unignored is read, hashed and copied on every start.
.scratch/

# Materialized persona projection — written by @yaks/persona (`yak persona
# sync`), the adopted voice AGENTS.md/CLAUDE.md symlink into. This repo un-tracked it in
# 5fc7573; it regenerates every sync, so ignore it lest a stray `git add -A`
# commit the derived output.
.tasks/
/target/

# wrangler dev secrets beside a Worker (workers/*)
.dev.vars

# An example @yaks/testing writes beside its page while it loads; one is left
# only by a run that was killed, and the next run removes it.
.*.example.ts
.*.example.tsx
.*.example.js
.*.example.jsx

# Fresh throughput measurements are local; only the accepted baseline is versioned.
/bench/results.json
# What the last whole test run measured (bin/test-budget.ts); the gate keeps it.
/bench/test-times/
/bench/*.results.json
/bench/*.json.tmp

# The sandbox CLI workspace and launcher, and the compiler catalog, generated
# for the Worker asset upload.
/workers/yak/public/_cli/
/workers/yak/public/_compiler/

# The browser client as one module, generated from public/client.js.
/workers/yak/public/_client.js

# Browser draft helper, generated from @yaks/draft.
/workers/yak/public/_draft.js

# Browser write outbox, generated from @yaks/sync.
/workers/yak/public/_outbox.js

# Browser binary wire codec, generated from @yaks/vocab.
/workers/yak/public/_wire.js
