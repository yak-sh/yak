{
  // Editor shim only — Deno reads deno.json; this file exists so a plain
  // tsserver (an editor without the Deno LSP on this workspace) still finds
  // preact's JSX types instead of erroring TS7026 on every element.
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "noEmit": true
  }
}
