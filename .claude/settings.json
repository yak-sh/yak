{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" task context --hook || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$HOME/.deno/bin:$PATH\" task lapse --hook || true"
          }
        ]
      }
    ]
  }
}
