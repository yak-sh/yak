#!/bin/sh
# Format what a commit carries, so an unformatted file never reaches main:
# deno fmt rewrites each staged file in place and it is staged again. It
# refuses nothing. A file with unstaged changes beside its staged ones is left
# alone, since staging it again would commit those too. The workspace config
# is named, since a yaks app's package.json beside a file would replace it.

git diff --cached --name-only --diff-filter=ACMR -z |
  tr '\0' '\n' |
  grep -E '\.(ts|tsx|js|jsx|mjs|cjs|json|jsonc|md)$' |
  while IFS= read -r file
  do
    git diff --quiet -- "$file" || continue
    deno fmt --config deno.json --quiet -- "$file" 2>/dev/null &&
      git add -- "$file"
  done

# Then draw what yaks.app's readers take from git (workers/yak/gen.ts): the
# home app's pages, the plugin package and the reserved words on the
# components page, from the tree as the commit leaves it. Each file it
# rewrote is staged, so a commit carries them with the change they follow
# from. Like the formatting above, a file with unstaged changes is left
# alone, and a generator that fails refuses nothing.

dirty=$(git diff --name-only)
deno run -q --allow-read --allow-write --allow-env --allow-run=deno \
  workers/yak/gen.ts 2>/dev/null |
  while IFS= read -r path
  do
    printf '%s\n' "$dirty" | grep -qxF -- "$path" && continue
    git add -A -- "$path"
  done
exit 0
